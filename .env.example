# Runtime
PORT=8000

# URL publique du site (sans slash final). Sert à transformer les chemins d'assets
# relatifs (logos header/footer "assets/…") en URLs absolues avant publication SFMC,
# pour qu'ils s'affichent correctement dans les CloudPages.
SITE_URL=https://your-site-url.com

# Supabase REST API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
# Server-side only. Required for migrations and backend writes when RLS/grants block anon writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI
GEMINI_API_KEY=
GEMINI_API_KEY_TRANSLATION=

# Salesforce Marketing Cloud — composant Server-to-Server
# (grant client_credentials : publication d'assets, Data Extensions, images)
SFMC_SUBDOMAIN=
SFMC_CLIENT_ID=
SFMC_CLIENT_SECRET=
SFMC_ACCOUNT_ID=
SFMC_CATEGORY_ID=
SFMC_CATEGORY_NAME=
SFMC_ASSET_TYPE_ID=205
SFMC_ASSET_TYPE_NAME=webpage
SFMC_DE_CATEGORY_ID=

# ─────────────────────────────────────────────────────────────────────────────
# DEUX implementations d'authentification SFMC coexistent dans le depot.
# UNE SEULE est branchee a la fois (voir server.js / api/router.js).
#
#  A) ACTIVE  — OAuth2 Authorization Code, lib/sfmc-auth.js, variables SFMC_AUTH_*
#               Composant SFMC requis : « API Integration / Web App »
#               (client_id + client_secret + Redirect URIs). C'est celui qui a
#               ete cree cote SFMC, d'ou ce choix.
#
#  B) EN VEILLE — SSO par JWT, lib/auth.js, variables SFMC_JWT_SECRET & co.
#               Composant SFMC requis : « Marketing Cloud App » (App Signature).
#               Conserve mais non branche : ce composant n'existe pas.
#
# SESSION_SECRET est commun aux deux : ne le declarer qu'UNE fois.
# ─────────────────────────────────────────────────────────────────────────────

# ══ A) ACTIVE — OAuth2 Authorization Code ════════════════════════════════════
# ─────────────────────────────────────────────────────────────────────────────
# Authentification SFMC — composant Web App (OAuth2 Authorization Code)
# ─────────────────────────────────────────────────────────────────────────────
# L'app ne stocke aucun mot de passe : 100 % de l'authentification est déléguée
# à SFMC. Le verrouillage d'instance vient du SOUS-DOMAINE du tenant : les URLs
# authorize/token/userinfo pointent vers lui, donc seul un utilisateur capable
# de s'authentifier sur ce tenant obtient un token.
#
# ⚠️ Ces identifiants sont DIFFÉRENTS de SFMC_CLIENT_ID / SFMC_CLIENT_SECRET
# ci-dessus. Il faut un SECOND composant dans l'Installed Package, de type
# « Web App » : un composant Server-to-Server n'a pas de redirect_uri et ne
# peut pas porter un Authorization Code.
#
# Tant que ce bloc est vide, l'authentification reste EN VEILLE et l'app
# fonctionne sans contrôle d'accès (comportement actuel). Un avertissement est
# affiché au démarrage.

# Sous-domaine (TSSD) du tenant. Vide → repli sur SFMC_SUBDOMAIN (même tenant).
SFMC_AUTH_SUBDOMAIN=
# client_id / client_secret du composant Web App.
SFMC_AUTH_CLIENT_ID=
SFMC_AUTH_CLIENT_SECRET=
# URL publique de l'app, sans slash final. Le redirect_uri enregistré dans le
# package SFMC doit valoir EXACTEMENT <WEB_APP_HOST>/handlelogin, au caractère
# près — sinon SFMC renvoie redirect_uri_mismatch.
WEB_APP_HOST=https://your-app.vercel.app
# Secret de signature du cookie de session (32+ octets aléatoires) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Allow-list d'instances : EID et/ou MID séparés par des virgules. Vide =
# mono-instance, le verrouillage par sous-domaine suffit.
ALLOWED_TENANT_ID=
# `dev` court-circuite le contrôle d'accès en local. Ignoré sur Vercel.
AUTH_ENV=prod
# true = refuser l'accès (503) si la configuration est incomplète, au lieu de
# mettre l'auth en veille. À activer en production une fois le package livré.
SFMC_AUTH_REQUIRED=false

# Surcharges facultatives : normalement dérivées du sous-domaine.
# SFMC_AUTHORIZE_URL=
# SFMC_TOKEN_URL=
# SFMC_USERINFO_URL=

# ══ B) EN VEILLE — SSO par JWT (lib/auth.js, non branche) ════════════════════
# ── Authentification SSO Marketing Cloud (JWT du package installé) ────
# App Signature / « JWT Signing Secret » du composant Marketing Cloud App du
# package installé SFMC. Sert à VÉRIFIER le JWT que SFMC POSTe sur l'URL de login
# → garantit que l'utilisateur est connecté à SFMC. C'est la clé principale.
SFMC_JWT_SECRET=
# (Fallback accès direct) URL de login SFMC vers laquelle rediriger si l'app est
# ouverte hors Marketing Cloud. Redirection vers cette URL BRUTE telle quelle
# (sans MID ni paramètre ajouté). Prioritaire sur SFMC_URL.
SFMC_BASE_URL=
# URL du LP enregistré dans le package AppExchange : là où on renvoie l'utilisateur
# APRÈS connexion SFMC (repli sur '/' si vide).
SFMC_APP_URL=
# (Legacy) Ancienne variable, laissée en repli si SFMC_BASE_URL est vide.
SFMC_URL=
# (Optionnel) Nom d'un paramètre de retour vers l'app accepté par la page SFMC.
SFMC_RETURN_PARAM=
# (Optionnel) URL de retour de l'app (par défaut dérivée : /auth/sfmc/callback).
SFMC_REDIRECT_URI=
# Secret de signature du cookie de session (HMAC). Générer : openssl rand -hex 32
# SESSION_SECRET : deja declare dans le bloc A ci-dessus (commun aux deux).
# (Optionnel) Durée de vie de la session en ms (défaut 8h).
SFMC_SESSION_TTL_MS=
# (Optionnel) Forcer SameSite du cookie ('Lax' | 'None'). Auto-détecté sinon.
SFMC_COOKIE_SAMESITE=

# ── Interrupteur global de la synchro SFMC ────────────────────────────
# OBLIGATOIRE pour que l'intégration SFMC fonctionne : tant que ce n'est pas
# exactement "true", isSfmcConfigured() renvoie false et TOUTE la synchro est
# ignorée en silence (publication de pages, upload d'images, dépublication).
# Les pages passent alors en « publié » côté app sans être poussées vers SFMC.
SFMC_SYNC_ENABLED=true
# (Optionnel) "false" pour publier les %%=ContentBlockByKey()=%% tels quels au
# lieu d'inliner le socle SSJS dans la page envoyée à SFMC. Défaut : inlining.
SOCLE_INLINE=
