%%[
/* ============================================================================
   LISTES DEROULANTES — LECTURE SALESFORCE EN AMPSCRIPT
   ============================================================================
   Remplace la partie SERVEUR de `picklist-handler.ssjs`.

   Pourquoi AMPscript et non SSJS : sur cette org, une CloudPage publiee ne peut
   PAS lire Salesforce en SSJS — `Platform.Function.RetrieveSalesforceObjects`
   leve « Unable to retrieve security descriptor for this frame », quelle que
   soit la signature. AMPscript, sur la MEME page, lit sans probleme.
   Constat etabli le 2026-08-16, cf. ../diagnostic/README.md. Ne pas re-tenter
   en SSJS.

   Ce bloc emet exactement le meme `window.SOCLE_DATA.picklists` que la version
   SSJS : le JS de cascade cote navigateur est donc INCHANGE.

   --- Contraintes AMPscript, qui expliquent la forme du code ----------------
   1. Pas de fonctions utilisateur -> le bloc de lecture est repete 4 fois.
      Une boucle sur les 4 champs demanderait un IF/ELSEIF par champ : plus
      long ET moins lisible que la repetition.
   2. Pas de try/catch, et une erreur REMPLACE toute la page. On n'utilise donc
      QUE des noms d'API releves sur l'org (cf. REFERENCE-API-ORG.md).
   3. Pas de serialisation JSON native -> on assemble a la main, en chaines JS
      a guillemets SIMPLES : les libelles Salesforce contiennent des apostrophes
      (« Cote d'Ivoire ») et des accents, jamais de guillemets doubles.
      L'echappement se fait dans l'ordre : backslash, PUIS apostrophe.
      L'inverse doublerait les backslashes deja poses.
   ============================================================================ */

VAR @school, @prefix, @actif, @prefixUp
VAR @dur, @rows, @n, @i, @row, @v, @l, @esc
VAR @jsCountry, @jsIndicatif, @jsLevel, @jsQui, @sep
VAR @jsProgs, @jsCampus, @jsPtats, @jsTerms
VAR @sepP, @sepC, @sepT, @sepR
VAR @idIndex, @campusSeen, @termSeen, @cName, @cLabel, @pid, @tid, @nbProgs
VAR @ptatRows, @ptatProgIndex, @nPtat, @j, @prow, @candidature
VAR @jsInstances, @jsAppts, @nbInst, @typeEvt, @instSel, @evtParent
VAR @d0, @iid, @restrict, @sepI, @sepA, @delta, @minDelta, @maxDelta
VAR @cfgRows, @cfg, @cfgProgressif, @cfgOrdre, @cfgLangueDef, @cfgRentree
VAR @cfgSpecV, @cfgSpecN, @cfgRythV, @cfgRythN, @cfgLangV, @cfgLangN
VAR @formTypePage, @ord
VAR @jsDico, @dicoRows, @nDico, @dicoEn, @sepD
VAR @campusRows, @nCampus, @k, @campusIdIndex, @instCampusId, @instCampusNom
VAR @evtIndex, @evtRows, @nEvt, @e

/* ---- QUELLE ECOLE ? -----------------------------------------------------
   Trois sources, dans cet ordre.

   1. `?SchoolId=` puis `?Marque=` dans l'URL. Pratique pour les pages de test,
      mais ABSENTS d'une page publiee : un <input type="hidden"> n'est pas un
      parametre de requete tant que le formulaire n'est pas soumis. Au premier
      affichage — un GET sans query string — les deux sont vides.

   2. `@LPB_ECOLE`, posee par la page ELLE-MEME juste avant d'inclure ce bloc.
      C'est la source reelle en production : le builder connait l'ecole au
      moment ou il construit le formulaire, et la fige dans le HTML publie.
      Un Content Block ne prend pas de parametre, mais il partage la portee
      AMPscript de la page qui l'inclut : une variable posee avant l'include
      est donc lisible ici.

   ⚠ Ne JAMAIS declarer @LPB_ECOLE par un VAR ici : VAR reinitialise, et on
   effacerait la valeur que la page vient de poser.

   Sans aucune des trois, @school reste vide : le prefixe est introuvable, la
   DE des ecoles ne repond pas, et les listes campus/programmes sortent vides.
   Les options statiques du builder servent alors de repli — degrade, mais
   jamais casse. */
SET @school = RequestParameter("SchoolId")
IF Empty(@school) THEN SET @school = RequestParameter("Marque") ENDIF
IF Empty(@school) THEN SET @school = @LPB_ECOLE ENDIF

/* La regle de la specialite differe entre brochure et candidature. */
SET @formTypePage = Lowercase(RequestParameter("TypeFormulaire"))

/* Ecole -> prefixe campus, via la DE de correspondance.
   `Actif` est un garde-fou volontaire : un prefixe faux ne provoque aucune
   erreur, il rend un formulaire VIDE — panne silencieuse que personne ne
   remarque. Tant qu'une ecole n'a pas ete verifiee, on ne tente rien. */
SET @prefix = Lookup("LPB_Mapping_Ecoles", "CampusPrefix", "Ecole", @school)
SET @actif  = Lookup("LPB_Mapping_Ecoles", "Actif",        "Ecole", @school)
SET @prefixUp = Uppercase(@prefix)

/* ---- Matrice des champs conditionnels de cette ecole -------------------
   LookupRows plutot que 13 Lookup successifs : une seule lecture de DE.
   Si l'ecole n'a pas de ligne de config, on tombe sur le comportement par
   defaut (tout progressif, tous les champs proposes) — c'est-a-dire l'ancien
   comportement, donc aucune regression pour une ecole non encore parametree. */
SET @cfgRows = LookupRows("LPB_Config_Formulaires", "Ecole", @school)
SET @cfgProgressif = "true"
SET @cfgOrdre      = "campus,niveau,speciality,rhythm,language,rentree"
SET @cfgLangueDef  = ""
SET @cfgSpecV = "toujours"
SET @cfgSpecN = 0
SET @cfgRythV = "toujours"
SET @cfgRythN = 0
SET @cfgLangV = "toujours"
SET @cfgLangN = 0
SET @cfgRentree = "false"

IF RowCount(@cfgRows) > 0 THEN
    SET @cfg = Row(@cfgRows, 1)
    SET @cfgProgressif = Field(@cfg, "Progressif")
    IF NOT Empty(Field(@cfg,"OrdreChamps")) THEN SET @cfgOrdre = Field(@cfg, "OrdreChamps") ENDIF
    SET @cfgLangueDef  = Field(@cfg, "LangueDefaut")
    SET @cfgRentree    = Field(@cfg, "RentreeDecalee")

    /* Le formulaire brochure a sa propre regle pour la specialite. */
    IF @formTypePage == "brochure" THEN
        SET @cfgSpecV = Field(@cfg, "BrochureSpecialite")
        SET @cfgSpecN = Field(@cfg, "BrochureSpecialiteNiveauMin")
    ELSE
        SET @cfgSpecV = Field(@cfg, "SpecialiteVisible")
        SET @cfgSpecN = Field(@cfg, "SpecialiteNiveauMin")
    ENDIF
    SET @cfgRythV = Field(@cfg, "RythmeVisible")
    SET @cfgRythN = Field(@cfg, "RythmeNiveauMin")
    SET @cfgLangV = Field(@cfg, "LangueVisible")
    SET @cfgLangN = Field(@cfg, "LangueNiveauMin")
ENDIF

SET @jsCountry   = ""
SET @jsIndicatif = ""
SET @jsLevel     = ""
SET @jsQui       = ""

/* ==========================================================================
   DICTIONNAIRE D'AFFICHAGE FR -> EN
   ==========================================================================
   UNE lecture de DE, publiee telle quelle dans SOCLE_DATA. C'est le JS qui
   choisit la langue, pas le socle : un Content Block ne prend pas de parametre,
   et le socle ne peut donc PAS savoir si la page qui l'inclut est francaise ou
   anglaise. Le formulaire, lui, le sait — il porte data-lang.

   Consequence voulue : un seul bloc socle sert les deux langues, et la VALEUR
   postee n'est jamais touchee. Le JS ne remplace que le texte affiche de
   l'option ; `value` reste la valeur Salesforce d'origine, celle que le socle
   d'ecriture attend.

   Seules les lignes REELLEMENT traduites sont publiees : une entree dont
   l'anglais est vide n'apporte rien et le JS retomberait de toute facon sur le
   francais. Environ 280 paires aujourd'hui.

   Alimentation : bloc LPB_TST_Dico_Sync (insere les valeurs du CRM absentes),
   puis scripts/traduire-dico.js (remplit l'anglais via Gemini). La DE reste
   corrigeable a la main, et une correction n'est jamais ecrasee.
   ========================================================================== */
SET @jsDico = ""
SET @sepD = ""
SET @dicoRows = LookupRows("LPB_Dico_Traductions", "Actif", "true")
SET @nDico = RowCount(@dicoRows)
FOR @i = 1 TO @nDico DO
    SET @row = Row(@dicoRows, @i)
    SET @dicoEn = Field(@row, "En")
    IF NOT Empty(@dicoEn) THEN
        SET @jsDico = Concat(@jsDico, @sepD, "'",
            Replace(Replace(Field(@row, "Fr"), "\", "\\"), "'", "\'"), "':'",
            Replace(Replace(@dicoEn, "\", "\\"), "'", "\'"), "'")
        SET @sepD = ","
    ENDIF
NEXT @i

/* ---- 1. Pays -> Account.LivingCountry__c ------------------------------- */
SET @dur = ""
SET @rows = RetrieveSalesforceObjects("EntityParticle", "DurableId",
    "EntityDefinitionId", "=", "Account",
    "QualifiedApiName",   "=", "LivingCountry__c")
IF RowCount(@rows) > 0 THEN SET @dur = Field(Row(@rows, 1), "DurableId") ENDIF

IF Length(@dur) > 0 THEN
    SET @rows = RetrieveSalesforceObjects("PicklistValueInfo", "Value,Label,IsActive",
        "EntityParticleId", "=", @dur)
    SET @n = RowCount(@rows)
    SET @sep = ""
    FOR @i = 1 TO @n DO
        SET @row = Row(@rows, @i)
        /* Une valeur desactivee cote CRM ne doit plus etre proposee. */
        IF Lowercase(Field(@row, "IsActive")) != "false" THEN
            SET @v = Field(@row, "Value")
            SET @l = Field(@row, "Label")
            IF Empty(@l) THEN SET @l = @v ENDIF
            SET @esc = Replace(Replace(@v, "\", "\\"), "'", "\'")
            SET @jsCountry = Concat(@jsCountry, @sep, "{value:'", @esc, "',label:'",
                                    Replace(Replace(@l, "\", "\\"), "'", "\'"), "'}")
            SET @sep = ","
        ENDIF
    NEXT @i
ENDIF

/* ---- 2. Indicatif -> Account.IndicatifPick__c -------------------------- */
SET @dur = ""
SET @rows = RetrieveSalesforceObjects("EntityParticle", "DurableId",
    "EntityDefinitionId", "=", "Account",
    "QualifiedApiName",   "=", "IndicatifPick__c")
IF RowCount(@rows) > 0 THEN SET @dur = Field(Row(@rows, 1), "DurableId") ENDIF

IF Length(@dur) > 0 THEN
    SET @rows = RetrieveSalesforceObjects("PicklistValueInfo", "Value,Label,IsActive",
        "EntityParticleId", "=", @dur)
    SET @n = RowCount(@rows)
    SET @sep = ""
    FOR @i = 1 TO @n DO
        SET @row = Row(@rows, @i)
        IF Lowercase(Field(@row, "IsActive")) != "false" THEN
            SET @v = Field(@row, "Value")
            SET @l = Field(@row, "Label")
            IF Empty(@l) THEN SET @l = @v ENDIF
            SET @jsIndicatif = Concat(@jsIndicatif, @sep, "{value:'",
                Replace(Replace(@v, "\", "\\"), "'", "\'"), "',label:'",
                Replace(Replace(@l, "\", "\\"), "'", "\'"), "'}")
            SET @sep = ","
        ENDIF
    NEXT @i
ENDIF

/* ---- 3. Niveau d'etudes -> Account.Academic_Level_List__c -------------- */
SET @dur = ""
SET @rows = RetrieveSalesforceObjects("EntityParticle", "DurableId",
    "EntityDefinitionId", "=", "Account",
    "QualifiedApiName",   "=", "Academic_Level_List__c")
IF RowCount(@rows) > 0 THEN SET @dur = Field(Row(@rows, 1), "DurableId") ENDIF

IF Length(@dur) > 0 THEN
    SET @rows = RetrieveSalesforceObjects("PicklistValueInfo", "Value,Label,IsActive",
        "EntityParticleId", "=", @dur)
    SET @n = RowCount(@rows)
    SET @sep = ""
    FOR @i = 1 TO @n DO
        SET @row = Row(@rows, @i)
        IF Lowercase(Field(@row, "IsActive")) != "false" THEN
            SET @v = Field(@row, "Value")
            SET @l = Field(@row, "Label")
            IF Empty(@l) THEN SET @l = @v ENDIF
            /* Chaque niveau emporte son ORDINAL, sans quoi le navigateur ne
               peut pas evaluer une regle du type « a partir de bac+3 » : il
               n'aurait que des libelles, non comparables entre eux.
               Ordinal absent = 0 = la regle « niveau » ne se declenchera pas,
               ce qui masque le champ plutot que de l'afficher a tort. */
            SET @ord = Lookup("LPB_Mapping_Niveaux", "Ordre", "Niveau", @v)
            IF Empty(@ord) THEN SET @ord = 0 ENDIF

            SET @jsLevel = Concat(@jsLevel, @sep, "{value:'",
                Replace(Replace(@v, "\", "\\"), "'", "\'"), "',label:'",
                Replace(Replace(@l, "\", "\\"), "'", "\'"), "',ordre:", @ord, "}")
            SET @sep = ","
        ENDIF
    NEXT @i
ENDIF

/* ---- 4. « Vous etes » -> Account.PersonAccountType__c ------------------ */
SET @dur = ""
SET @rows = RetrieveSalesforceObjects("EntityParticle", "DurableId",
    "EntityDefinitionId", "=", "Account",
    "QualifiedApiName",   "=", "PersonAccountType__c")
IF RowCount(@rows) > 0 THEN SET @dur = Field(Row(@rows, 1), "DurableId") ENDIF

IF Length(@dur) > 0 THEN
    SET @rows = RetrieveSalesforceObjects("PicklistValueInfo", "Value,Label,IsActive",
        "EntityParticleId", "=", @dur)
    SET @n = RowCount(@rows)
    SET @sep = ""
    FOR @i = 1 TO @n DO
        SET @row = Row(@rows, @i)
        IF Lowercase(Field(@row, "IsActive")) != "false" THEN
            SET @v = Field(@row, "Value")
            SET @l = Field(@row, "Label")
            IF Empty(@l) THEN SET @l = @v ENDIF
            SET @jsQui = Concat(@jsQui, @sep, "{value:'",
                Replace(Replace(@v, "\", "\\"), "'", "\'"), "',label:'",
                Replace(Replace(@l, "\", "\\"), "'", "\'"), "'}")
            SET @sep = ","
        ENDIF
    NEXT @i
ENDIF

/* ==========================================================================
   CASCADE PROGRAMME
   ==========================================================================
   Pourquoi on lit TOUT puis on filtre, au lieu de filtrer cote Salesforce :
   `campusNameFor__c` vaut "EFAP PARIS" — ecole et ville accolees — et
   RetrieveSalesforceObjects NE SUPPORTE PAS l'operateur `like` (verifie le
   2026-08-16 : "EFAP%" rend 0 ligne au lieu d'une erreur, alors que 533
   programmes ont un campus). Il n'existe donc aucun moyen de demander a
   Salesforce « les programmes de l'EFAP ». On lit les 533, on garde ceux dont
   le campus commence par le prefixe, en comparant en MAJUSCULES : l'org
   melange "EFAP PARIS" et "Campus Brassart Lyon".

   Cout : ~533 + ~509 iterations AMPscript. Acceptable au rendu d'une page,
   mais c'est la partie a surveiller si le catalogue grossit.
   ========================================================================== */
SET @jsProgs   = ""
SET @jsCampus  = ""
SET @jsPtats   = ""
SET @jsTerms   = ""
SET @idIndex   = ";"
SET @campusSeen = ";"
SET @termSeen  = ";"
SET @nbProgs   = 0

IF Length(@prefixUp) > 0 AND Lowercase(@actif) == "true" THEN

    /* --- 0. PTAT : LUS EN PREMIER --------------------------------------
       Ordre voulu par le cadrage de la candidature : on part des sessions de
       candidature (PTAT), puis on en deduit les programmes — pas l'inverse.

       Pourquoi ca change quelque chose. Le filtrage progressif de la cascade
       (Specialite restreint Rythme, qui restreint Langue) elimine les
       COMBINAISONS impossibles entre champs. Il ne peut PAS ecarter un
       programme qui n'a AUCUNE session ouverte : ce n'est pas une condition
       entre champs, c'est une propriete du programme. Mesure sur EFAP le
       2026-08-23 : 172 programmes remontes, dont 49 SANS PTAT. Un candidat
       pouvait donc choisir une combinaison, puis trouver Rentree vide et
       Programme vide — une impasse, sans explication.

       Restriction appliquee A LA CANDIDATURE SEULEMENT. La brochure doit
       continuer a montrer tout le catalogue : on y demande une documentation,
       pas une session ouverte.

       Les PTAT sont aussi lus UNE SEULE FOIS ici, au lieu d'une seconde
       lecture apres les programmes. */
    SET @candidature = "false"
    IF @formTypePage == "candidature" THEN SET @candidature = "true" ENDIF

    SET @ptatProgIndex = ";"
    SET @ptatRows = RetrieveSalesforceObjects("ProgramTermApplnTimeline",
        "Id,LearningProgramId,AcademicTermId", "Id", "!=", "")
    SET @nPtat = RowCount(@ptatRows)

    FOR @j = 1 TO @nPtat DO
        SET @pid = Field(Row(@ptatRows, @j), "LearningProgramId")
        IF NOT Empty(@pid) AND IndexOf(@ptatProgIndex, Concat(";", @pid, ";")) == 0 THEN
            SET @ptatProgIndex = Concat(@ptatProgIndex, @pid, ";")
        ENDIF
    NEXT @j

    /* --- 1. Programmes de l'ecole ------------------------------------- */
    SET @rows = RetrieveSalesforceObjects("LearningProgram",
        "Id,Name,campusNameFor__c,Academic_Level_List__c,Speciality__c,Rhythm__c,InstructionLanguage__c",
        "campusNameFor__c", "!=", "")
    SET @n = RowCount(@rows)
    SET @sepP = ""
    SET @sepC = ""

    FOR @i = 1 TO @n DO
        SET @row = Row(@rows, @i)
        SET @cName = Field(@row, "campusNameFor__c")

        /* IndexOf rend une position 1-based : 1 = commence par le prefixe. */
        SET @pid = Field(@row, "Id")

        /* En candidature, un programme sans session ouverte n'a rien a faire
           dans les listes : il menerait a une impasse. */
        IF @candidature == "true" AND IndexOf(@ptatProgIndex, Concat(";", @pid, ";")) == 0 THEN
            SET @cName = ""
        ENDIF

        IF Length(@cName) > 0 AND IndexOf(Uppercase(@cName), @prefixUp) == 1 THEN
            SET @idIndex = Concat(@idIndex, @pid, ";")
            SET @nbProgs = Add(@nbProgs, 1)

            SET @jsProgs = Concat(@jsProgs, @sepP, "{id:'", @pid,
                "',name:'",       Replace(Replace(Field(@row,"Name"), "\", "\\"), "'", "\'"),
                "',campus:'",     Replace(Replace(@cName, "\", "\\"), "'", "\'"),
                "',level:'",      Replace(Replace(Field(@row,"Academic_Level_List__c"), "\", "\\"), "'", "\'"),
                "',speciality:'", Replace(Replace(Field(@row,"Speciality__c"), "\", "\\"), "'", "\'"),
                "',rhythm:'",     Replace(Replace(Field(@row,"Rhythm__c"), "\", "\\"), "'", "\'"),
                "',language:'",   Replace(Replace(Field(@row,"InstructionLanguage__c"), "\", "\\"), "'", "\'"),
                "'}")
            SET @sepP = ","

            /* Campus distincts, dedoublonnes via un index de chaine. */
            IF IndexOf(@campusSeen, Concat(";", @cName, ";")) == 0 THEN
                SET @campusSeen = Concat(@campusSeen, @cName, ";")

                /* VALEUR = le libelle complet ("EFAP PARIS") : c'est lui qui sert
                   au filtrage des programmes, il doit rester intact.
                   LIBELLE = la ville seule ("PARIS") : afficher l'ecole dans son
                   propre menu campus n'apprend rien au candidat. On ne rogne que
                   si le prefixe est bien suivi d'autre chose. */
                SET @cLabel = @cName
                IF Length(@cName) > Add(Length(@prefix), 1) THEN
                    SET @cLabel = Trim(Substring(@cName, Add(Length(@prefix), 1)))
                ENDIF

                SET @jsCampus = Concat(@jsCampus, @sepC, "{value:'",
                    Replace(Replace(@cName,  "\", "\\"), "'", "\'"), "',label:'",
                    Replace(Replace(@cLabel, "\", "\\"), "'", "\'"), "'}")
                SET @sepC = ","
            ENDIF
        ENDIF
    NEXT @i

    /* --- 2. PTAT des programmes retenus --------------------------------
       On NE filtre PAS sur SchoolId__c : il porte l'Id d'un Account CAMPUS
       ("BRASSART AIX-EN-PROVENCE"), pas de l'ecole, et on ne dispose pas de
       ces Ids. On repart donc des programmes deja filtres.

       Les lignes ont deja ete lues en etape 0 : on les reutilise. */
    IF @nbProgs > 0 THEN
        SET @sepR = ""

        FOR @i = 1 TO @nPtat DO
            SET @row = Row(@ptatRows, @i)
            SET @pid = Field(@row, "LearningProgramId")

            IF IndexOf(@idIndex, Concat(";", @pid, ";")) > 0 THEN
                SET @tid = Field(@row, "AcademicTermId")
                SET @jsPtats = Concat(@jsPtats, @sepR, "{ptatId:'", Field(@row,"Id"),
                    "',programId:'", @pid, "',termId:'", @tid, "'}")
                SET @sepR = ","

                IF NOT Empty(@tid) AND IndexOf(@termSeen, Concat(";", @tid, ";")) == 0 THEN
                    SET @termSeen = Concat(@termSeen, @tid, ";")
                ENDIF
            ENDIF
        NEXT @i
    ENDIF

    /* --- 3. Libelles des rentrees --------------------------------------
       Une seule lecture globale puis filtrage : une lecture par terme
       ferait autant d'allers-retours Salesforce que de rentrees. */
    IF Length(@termSeen) > 1 THEN
        SET @rows = RetrieveSalesforceObjects("AcademicTerm", "Id,Name", "Id", "!=", "")
        SET @n = RowCount(@rows)
        SET @sepT = ""
        FOR @i = 1 TO @n DO
            SET @row = Row(@rows, @i)
            SET @tid = Field(@row, "Id")
            IF IndexOf(@termSeen, Concat(";", @tid, ";")) > 0 THEN
                SET @jsTerms = Concat(@jsTerms, @sepT, "{value:'", @tid, "',label:'",
                    Replace(Replace(Field(@row,"Name"), "\", "\\"), "'", "\'"), "'}")
                SET @sepT = ","
            ENDIF
        NEXT @i
    ENDIF
ENDIF

/* ==========================================================================
   FAMILLE EVENEMENT — dates (JPO / Atelier / Stage) puis ateliers proposes
   ==========================================================================
   Ne s'active que si la page annonce un type d'evenement (?TypeEvenement=).
   Les formulaires brochure et candidature ne paient donc rien pour ce bloc.

   FENETRE : [date du PROCHAIN evenement, cette date + 15 jours].
   ⚠ Et NON [aujourd'hui, aujourd'hui + 15 jours] : les deux ne coincident que
   si un evenement tombe dans la quinzaine. Si la prochaine JPO est dans 40
   jours, la seconde formule n'affiche RIEN — un formulaire vide alors que des
   dates existent. Le contrat dit « prochaine date + evenements des 15 jours »,
   c'est-a-dire 15 jours a partir de cette prochaine date.

   D'ou deux passes sur le meme jeu de lignes : la premiere cherche l'echeance
   la plus proche, la seconde retient tout ce qui tombe dans les 15 jours qui
   la suivent. Les ecarts sont calcules en JOURS via DateDiff, jamais par
   comparaison de chaines : le format de date renvoye n'est pas garanti.
   ========================================================================== */
SET @jsInstances = ""
SET @jsAppts     = ""
SET @nbInst      = 0
SET @typeEvt     = RequestParameter("TypeEvenement")
SET @instSel     = RequestParameter("InstanceId")
SET @evtParent   = ""

IF NOT Empty(@typeEvt) THEN

    SET @d0 = FormatDate(Now(), "yyyy-MM-dd")

    /* ---- LES CAMPUS DE L'ECOLE, PAR LEUR Id DE COMPTE -------------------
       `Campus__c` sur l'instance est un LOOKUP vers un Account de type ecole
       EDH, et il est RENSEIGNE partout — contrairement a `campusNameFor__c`,
       vide sur 30 des 34 instances JPO. Filtrer sur le nom ne laissait donc
       AUCUNE date des qu'une ecole etait posee : le mecanisme etait bon, la
       donnee absente.

       Les Ids, on les a : c'est exactement la colonne `SchoolAccountId` de
       `LPB_Mapping_Campus`, celle qui sert deja a ecrire `Ecole__c`. Une seule
       lecture de DE, et on tient les campus de l'ecole.

       `campusNameFor__c` reste un repli pour les instances sans `Campus__c`. */
    SET @campusIdIndex = ";"
    SET @campusRows = LookupRows("LPB_Mapping_Campus", "Ecole", @school)
    SET @nCampus = RowCount(@campusRows)
    FOR @k = 1 TO @nCampus DO
        SET @campusIdIndex = Concat(@campusIdIndex,
            Field(Row(@campusRows, @k), "SchoolAccountId"), ";")
    NEXT @k

    /* Pas de borne haute cote Salesforce : elle depend de la prochaine date,
       qu'on ne connait pas encore. On ramene tout le futur du type demande
       (169 instances au total sur l'org, le volume n'est pas un sujet). */
    SET @rows = RetrieveSalesforceObjects("summit__Summit_Events_Instance__c",
        "Id,Name,campusNameFor__c,Campus__c,summit__Event__c,eventType__c,summit__Instance_Start_Date__c,summit__Instance_Start_Time__c,summit__Instance_End_Time__c,summit__Location_Address_Override__c,summit__Open_Registration__c",
        "summit__Instance_Start_Date__c", ">=", @d0,
        "eventType__c",          "=",  @typeEvt)
    SET @n = RowCount(@rows)
    SET @sepI = ""
    SET @evtIndex = ";"

    /* --- UNE SEULE PASSE : on publie TOUT le futur de l'ecole -------------
       La regle metier veut la prochaine date PAR CAMPUS, puis les evenements
       des 15 jours qui la suivent :

         « les prochaines JPO BRASSART Lyon sont le 10 et le 17 octobre : je
           peux choisir l'une ou l'autre. A Bordeaux, le 10 octobre et le 10
           novembre : je ne peux choisir que le 10 octobre. »

       La fenetre depend donc du CAMPUS choisi, et le socle ne le connait pas :
       c'est une selection faite dans le navigateur, apres le rendu. La calculer
       ici donnerait une fenetre unique pour toute l'ecole — celle du campus le
       plus proche — et masquerait des dates legitimes ailleurs.

       On publie donc toutes les dates a venir de l'ecole avec leur ecart en
       jours, et le JS calcule la fenetre sur le seul campus retenu. */
    FOR @i = 1 TO @n DO
        SET @row   = Row(@rows, @i)
        SET @cName = Field(@row, "campusNameFor__c")
        SET @instCampusId = Field(@row, "Campus__c")

        IF Length(@prefixUp) == 0
           OR (NOT Empty(@instCampusId) AND IndexOf(@campusIdIndex, Concat(";", @instCampusId, ";")) > 0)
           OR (Empty(@instCampusId) AND IndexOf(Uppercase(@cName), @prefixUp) == 1) THEN
            IF Lowercase(Field(@row, "summit__Open_Registration__c")) != "false" THEN
                SET @delta = DateDiff(Now(), Field(@row, "summit__Instance_Start_Date__c"), "D")

                IF @delta >= 0 THEN
                    /* Le nom du campus vient de la DE quand `campusNameFor__c`
                       est vide, ce qui est le cas general. Sans lui, le libelle
                       ne dirait pas OU la date a lieu — et le JS ne pourrait
                       pas filtrer par campus. */
                    SET @instCampusNom = @cName
                    IF Empty(@instCampusNom) AND NOT Empty(@instCampusId) THEN
                        FOR @k = 1 TO @nCampus DO
                            IF Field(Row(@campusRows, @k), "SchoolAccountId") == @instCampusId THEN
                                SET @instCampusNom = Field(Row(@campusRows, @k), "Campus")
                            ENDIF
                        NEXT @k
                    ENDIF

                    SET @iid = Field(@row, "Id")
                    SET @nbInst = Add(@nbInst, 1)

                    /* `evenement` sert au JS a retrouver les ateliers de la date
                       choisie : les types sont rattaches a l'EVENEMENT. */
                    SET @jsInstances = Concat(@jsInstances, @sepI, "{value:'", @iid,
                        "',label:'",     Replace(Replace(Field(@row,"Name"), "\", "\\"), "'", "\'"),
                        "',date:'",      Field(@row, "summit__Instance_Start_Date__c"),
                        "',heure:'",     Field(@row, "summit__Instance_Start_Time__c"),
                        "',heureFin:'",  Field(@row, "summit__Instance_End_Time__c"),
                        "',campus:'",    Replace(Replace(@instCampusNom, "\", "\\"), "'", "\'"),
                        "',address:'",   Replace(Replace(Field(@row,"summit__Location_Address_Override__c"), "\", "\\"), "'", "\'"),
                        "',evenement:'", Field(@row, "summit__Event__c"),
                        "',jours:",      @delta,
                        "}")
                    SET @sepI = ","

                    /* Index des evenements distincts : leurs ateliers sont lus
                       juste apres, une requete par evenement. */
                    SET @evtParent = Field(@row, "summit__Event__c")
                    IF NOT Empty(@evtParent) AND IndexOf(@evtIndex, Concat(";", @evtParent, ";")) == 0 THEN
                        SET @evtIndex = Concat(@evtIndex, @evtParent, ";")
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    NEXT @i

    /* --- Ateliers proposes pour la date retenue -------------------------
       ⚠ Le catalogue est porte par l'EVENEMENT, pas par l'instance : deux
       journees JPO du meme evenement proposent les memes ateliers. On passe
       donc par summit__Event__c releve ci-dessus.
       A ne pas confondre avec summit__Summit_Events_Appointments__c, qui est
       l'atelier CHOISI par un inscrit (donnee d'ecriture, rattachee a une
       Registration) et ne porte aucun drapeau "obligatoire". */
    /* ⚠ UNE REQUETE PAR EVENEMENT DISTINCT parmi les dates publiees.

       Avant, on ne lisait que l'evenement de la date preselectionnee. Des que
       le visiteur changeait de campus — donc potentiellement d'evenement — les
       ateliers proposes n'etaient plus ceux de sa date. Il y a un a trois
       evenements pour une ecole et un type donnes : le cout est negligeable. */
    SET @evtRows = BuildRowsetFromString(@evtIndex, ";")
    SET @nEvt = RowCount(@evtRows)
    SET @sepA = ""

    FOR @e = 1 TO @nEvt DO
    SET @evtParent = Trim(Field(Row(@evtRows, @e), 1))
    IF NOT Empty(@evtParent) THEN
        SET @rows = RetrieveSalesforceObjects("summit__Summit_Events_Appointment_Type__c",
            "Id,Name,summit__Title__c,summit__Appointment_Type__c,summit__Date_Available_Start__c,summit__Date_Available_End__c,summit__Required_Appointment__c,summit__Restrict_To_Instance_Title__c,summit__Sort_Order__c",
            "summit__Summit_Events__c", "=", @evtParent)
        SET @n = RowCount(@rows)
        /* ⚠ NE PAS reinitialiser @sepA ici : la boucle tourne une fois par
           EVENEMENT, et le separateur doit courir sur toute la liste. Le
           remettre a vide privait de virgule le premier atelier de chaque
           evenement suivant — window.SOCLE_DATA devenait indefini. */

        /* ⚠ On publie les ateliers de TOUTES les instances de l'evenement, en
           emportant leur restriction — c'est le JS qui filtre.

           Avant, le filtrage se faisait ICI, contre l'instance preselectionnee.
           Des que le visiteur changeait de date, la liste des conferences
           restait celle de la date d'origine : fausse, et silencieusement.
           Le socle ne peut pas savoir quelle date sera choisie, seul le
           navigateur le sait.

           `summit__Restrict_To_Instance_Title__c` porte l'ID de l'instance
           malgre son nom. Vide = propose sur toutes les dates. */
        FOR @i = 1 TO @n DO
            SET @row = Row(@rows, @i)
            SET @restrict = Field(@row, "summit__Restrict_To_Instance_Title__c")
            SET @l = Field(@row, "summit__Title__c")
            IF Empty(@l) THEN SET @l = Field(@row, "Name") ENDIF

            /* ⚠ NE JAMAIS emettre ici un champ Salesforce MULTILIGNE.

               `summit__Description__c` a ete tente puis retire : ses valeurs
               contiennent des retours a la ligne, interdits dans une chaine JS
               entre apostrophes. Resultat : `window.SOCLE_DATA` devenait
               indefini — tout le socle muet, sans le moindre message. Et
               AMPscript ne permet pas d'ecrire "\n" dans un litteral, donc on
               ne peut meme pas les remplacer proprement.

               Au passage, ce champ ne porte PAS les horaires de conference : il
               contient les notes de l'import de recette
               (« Source external ID: UAT-ANOUAR-APPT-... »). Les horaires
               n'existent nulle part sur cet objet aujourd'hui — ni champ
               structure, ni titre les mentionnant. A demander au CRM.

               `type` reste emis : il est court et sur une ligne. */
            SET @jsAppts = Concat(@jsAppts, @sepA, "{value:'", Field(@row,"Id"),
                "',label:'",       Replace(Replace(@l, "\", "\\"), "'", "\'"),
                "',evenement:'",   @evtParent,
                "',instance:'",    Replace(Replace(@restrict, "\", "\\"), "'", "\'"),
                "',type:'",        Replace(Replace(Field(@row,"summit__Appointment_Type__c"), "\", "\\"), "'", "\'"),
                "',debut:'",       Field(@row, "summit__Date_Available_Start__c"),
                "',fin:'",         Field(@row, "summit__Date_Available_End__c"),
                "',ordre:'",       Field(@row, "summit__Sort_Order__c"),
                "',required:",     IIF(Lowercase(Field(@row,"summit__Required_Appointment__c")) == "true", "true", "false"),
                "}")
            SET @sepA = ","
        NEXT @i
    ENDIF
    NEXT @e
ENDIF

/* ---- EMISSION DE SOCLE_DATA ------------------------------------------------
   La balise est ASSEMBLEE A L'EXECUTION. L'API SFMC supprime toute balise de script
   litteral a l'upload : sans cette precaution, les balises disparaissaient et
   le JSON s'affichait EN TEXTE VISIBLE sur la page au lieu d'etre execute.
   Constate le 2026-08-23. Ne pas remettre de balise en clair ici. */
VAR @dataOuvre, @dataFerme
SET @dataOuvre = Concat("<scr", "ipt>")
SET @dataFerme = Concat("</scr", "ipt>")
]%%

%%=v(@dataOuvre)=%%
/* Meme contrat que la version SSJS : le JS de cascade ne voit aucune difference.
   `instances` et `appointments` (famille evenement) restent VIDES mais PRESENTS
   — non encore portes. `remplir()` laisse alors le <select> statique en place au
   lieu de le vider : un champ obligatoire ne se retrouve jamais sans option. */
window.SOCLE_DATA = {
    "school": '%%=Replace(Replace(v(@school),"\","\\"),"'","\'")=%%',
    "picklists": {
        "Country":    [%%=v(@jsCountry)=%%],
        "Indicatif":  [%%=v(@jsIndicatif)=%%],
        "StudyLevel": [%%=v(@jsLevel)=%%],
        "VousEtes":   [%%=v(@jsQui)=%%]
    },
    "traductions": {%%=v(@jsDico)=%%},
    "campus":   [%%=v(@jsCampus)=%%],
    "programs": [%%=v(@jsProgs)=%%],
    "ptats":    [%%=v(@jsPtats)=%%],
    "terms":    [%%=v(@jsTerms)=%%],
    "instances":    [%%=v(@jsInstances)=%%],
    "appointments": [%%=v(@jsAppts)=%%],

    /* Matrice de l'ecole. Le navigateur decide de l'affichage, mais la VALEUR
       d'un champ masque continue d'etre transmise : le contrat impose qu'une
       valeur unique soit envoyee au CRM meme sans etre proposee au candidat. */
    "config": {
        "progressif":   %%[ IF Lowercase(@cfgProgressif) == "true" THEN ]%%true%%[ ELSE ]%%false%%[ ENDIF ]%%,
        "ordre":        '%%=v(@cfgOrdre)=%%',
        "langueDefaut": '%%=v(@cfgLangueDef)=%%',
        "rentreeDecalee": %%[ IF Lowercase(@cfgRentree) == "true" THEN ]%%true%%[ ELSE ]%%false%%[ ENDIF ]%%,
        "champs": {
            "Speciality": { "visible": '%%=v(@cfgSpecV)=%%', "niveauMin": %%=v(@cfgSpecN)=%% },
            "Rhythm":     { "visible": '%%=v(@cfgRythV)=%%', "niveauMin": %%=v(@cfgRythN)=%% },
            "Language":   { "visible": '%%=v(@cfgLangV)=%%', "niveauMin": %%=v(@cfgLangN)=%% }
        }
    }
};
%%=v(@dataFerme)=%%

<!-- socle ampscript: ecole=%%=v(@school)=%% prefixe=%%=v(@prefix)=%% actif=%%=v(@actif)=%% programmes=%%=v(@nbProgs)=%% -->
%%[ IF Length(@prefix) == 0 THEN ]%%
<!-- ⚠ ecole absente de LPB_Mapping_Ecoles : aucun programme ne sera propose. -->
%%[ ELSEIF Lowercase(@actif) != "true" THEN ]%%
<!-- ⚠ ecole presente mais Actif=false : prefixe campus non verifie, cascade desactivee. -->
%%[ ELSEIF @nbProgs == 0 THEN ]%%
<!-- ⚠ prefixe "%%=v(@prefix)=%%" ne correspond a aucun campusNameFor__c : prefixe a corriger. -->
%%[ ENDIF ]%%

%%[ IF RequestParameter("socleDebug") == "1" THEN ]%%
<div style="position:fixed;bottom:0;left:0;right:0;z-index:99999;max-height:50vh;overflow:auto;
            background:#12123a;color:#fff;font:12px/1.6 Consolas,monospace;padding:14px 18px;
            box-shadow:0 -4px 20px rgba(0,0,0,.4)">
  <div style="font:700 14px Segoe UI,Arial;margin-bottom:8px">
    Socle AMPscript &mdash; &eacute;cole : %%=v(@school)=%%
    &nbsp;|&nbsp; pr&eacute;fixe : <b>%%=v(@prefix)=%%</b>
    &nbsp;|&nbsp; actif : <b>%%=v(@actif)=%%</b>
  </div>

  %%[ IF Length(@prefix) == 0 THEN ]%%
    <div style="background:#7f1d1d;padding:10px 14px;border-radius:6px;margin-bottom:10px">
      <b>&Eacute;cole absente de LPB_Mapping_Ecoles.</b>
      Ajouter la ligne <code>%%=v(@school)=%%</code> dans la Data Extension.
    </div>
  %%[ ELSEIF Lowercase(@actif) != "true" THEN ]%%
    <div style="background:#78350f;padding:10px 14px;border-radius:6px;margin-bottom:10px">
      <b>Actif = false.</b> La cascade est volontairement d&eacute;sactiv&eacute;e tant que le
      pr&eacute;fixe <code>%%=v(@prefix)=%%</code> n'a pas &eacute;t&eacute; v&eacute;rifi&eacute;.
      Basculer <code>Actif</code> &agrave; true dans la DE une fois confirm&eacute;.
    </div>
  %%[ ELSEIF @nbProgs == 0 THEN ]%%
    <div style="background:#7f1d1d;padding:10px 14px;border-radius:6px;margin-bottom:10px">
      <b>Pr&eacute;fixe sans correspondance.</b> Aucun <code>campusNameFor__c</code> ne commence par
      <code>%%=v(@prefix)=%%</code>. C'est la DE qu'il faut corriger, pas le code.
    </div>
  %%[ ENDIF ]%%

  <table style="background:#fff;color:#12123a;border-collapse:collapse;border-radius:6px;min-width:420px">
    %%[ /* Compter les elements d'une liste JS = compter ses separateurs, +1 si non vide.
           AMPscript n'a pas de fonction de comptage sur chaine : BuildRowsetFromString
           sur la virgule ferait un decoupage FAUX (les libelles en contiennent).
           On decoupe donc sur "}", qui ne peut pas apparaitre dans une valeur. */ ]%%
    <tr><td style="padding:5px 12px">Pays</td>
        <td style="padding:5px 12px;text-align:right"><b>%%=Subtract(RowCount(BuildRowsetFromString(@jsCountry,"}")),1)=%%</b></td></tr>
    <tr><td style="padding:5px 12px">Indicatif</td>
        <td style="padding:5px 12px;text-align:right"><b>%%=Subtract(RowCount(BuildRowsetFromString(@jsIndicatif,"}")),1)=%%</b></td></tr>
    <tr><td style="padding:5px 12px">Niveau d'&eacute;tudes</td>
        <td style="padding:5px 12px;text-align:right"><b>%%=Subtract(RowCount(BuildRowsetFromString(@jsLevel,"}")),1)=%%</b></td></tr>
    <tr><td style="padding:5px 12px">Vous &ecirc;tes</td>
        <td style="padding:5px 12px;text-align:right"><b>%%=Subtract(RowCount(BuildRowsetFromString(@jsQui,"}")),1)=%%</b></td></tr>
    <tr><td style="padding:5px 12px">Campus</td>
        <td style="padding:5px 12px;text-align:right"><b>%%=Subtract(RowCount(BuildRowsetFromString(@jsCampus,"}")),1)=%%</b></td></tr>
    <tr style="background:#eef"><td style="padding:5px 12px"><b>Programmes</b></td>
        <td style="padding:5px 12px;text-align:right"><b>%%=v(@nbProgs)=%%</b></td></tr>
    <tr><td style="padding:5px 12px">PTAT</td>
        <td style="padding:5px 12px;text-align:right"><b>%%=Subtract(RowCount(BuildRowsetFromString(@jsPtats,"}")),1)=%%</b></td></tr>
    <tr><td style="padding:5px 12px">Rentr&eacute;es</td>
        <td style="padding:5px 12px;text-align:right"><b>%%=Subtract(RowCount(BuildRowsetFromString(@jsTerms,"}")),1)=%%</b></td></tr>
    <tr><td style="padding:5px 12px">Dates d'&eacute;v&eacute;nement %%[IF Empty(@typeEvt) THEN]%%<i>(pas de ?TypeEvenement)</i>%%[ELSE]%%<i>(prochaine dans %%=v(@minDelta)=%% j, fen&ecirc;tre J+%%=v(@minDelta)=%% &agrave; J+%%=v(@maxDelta)=%%)</i>%%[ENDIF]%%</td>
        <td style="padding:5px 12px;text-align:right"><b>%%=v(@nbInst)=%%</b></td></tr>
    <tr><td style="padding:5px 12px">Ateliers propos&eacute;s</td>
        <td style="padding:5px 12px;text-align:right"><b>%%=Subtract(RowCount(BuildRowsetFromString(@jsAppts,"}")),1)=%%</b></td></tr>
  </table>

  <div style="margin-top:8px;color:#9aa">Campus trouv&eacute;s : %%=v(@campusSeen)=%%</div>
</div>
%%[ ENDIF ]%%

<!-- ===== JS DE CASCADE — genere par scripts/sync-cascade-js.js ===== -->
%%[
VAR @cascadeOuvre, @cascadeFerme
SET @cascadeOuvre = Concat("<scr", "ipt>")
SET @cascadeFerme = Concat("</scr", "ipt>")
]%%
%%=v(@cascadeOuvre)=%%
/* ============================================================================
 *  CASCADE COTE NAVIGATEUR
 *  Aucune lecture supplementaire : tout est deja dans window.SOCLE_DATA.
 * ========================================================================== */
(function () {
    var D = window.SOCLE_DATA;
    if (!D) return;                       // lecture SF indisponible -> on laisse le HTML statique

    /* ---- ATTENDRE LE DOM ---------------------------------------------------
       Le socle est inclus EN HAUT de la page : quand ce script s'execute, le
       formulaire n'existe pas encore. Sans cette attente, tous les
       querySelector rendent null, la cascade sort en silence et les listes
       restent vides — panne invisible, constatee le 2026-08-23 sur un
       formulaire de test reel. Elle n'avait jamais pu fonctionner.

       On differe donc TOUT le corps jusqu'a DOMContentLoaded. Si le DOM est
       deja pret (socle inclus en bas de page, ou script charge tardivement),
       on execute immediatement. */
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', demarrer);
    } else {
        demarrer();
    }
    function demarrer() {

    function champ(name) { return document.querySelector('[name="' + name + '"]'); }

    /**
     * La langue d'AFFICHAGE de la page.
     *
     * Le socle ne la connait pas : un Content Block ne prend pas de parametre.
     * Le formulaire, lui, la porte dans data-lang — c'est le builder qui l'y
     * pose selon la variante du bloc (francaise ou anglaise). On lit donc le
     * DOM, pas une variable AMPscript.
     */
    function langueAffichage() {
        try {
            var f = document.querySelector('[data-lang]');
            return (f && String(f.getAttribute('data-lang') || '').toLowerCase()) || 'fr';
        } catch (e) { return 'fr'; }
    }

    /**
     * Le libelle a AFFICHER pour une option.
     *
     * ⚠ Ne concerne QUE le texte visible. La `value` de l'option n'est jamais
     * touchee : c'est la valeur Salesforce d'origine, celle que le socle
     * d'ecriture attend, et la traduire casserait toutes les ecritures.
     *
     * Les valeurs du CRM sont en francais. En page anglaise, on cherche leur
     * equivalent dans SOCLE_DATA.traductions, alimente depuis la DE
     * LPB_Dico_Traductions. Pas d'entree, ou anglais vide : on garde le
     * francais, ce qui est degrade mais jamais casse.
     */
    function libelleAffiche(option, langue) {
        var brut = option.label || option.value;
        if (langue !== 'en') return brut;
        var dico = D && D.traductions;
        if (!dico) return brut;
        return dico[brut] || brut;
    }

    /**
     * Ordre d'affichage d'une liste.
     *
     * Salesforce rend les valeurs de picklist dans l'ordre du value set, qui
     * n'est ni alphabetique ni numerique : les 201 indicatifs arrivent par
     * exemple en 992, 379, 387, 243... Illisible dans un <select>.
     *
     * Deux tris, parce que deux natures de donnees :
     *   - Indicatif : NUMERIQUE. Un tri alphabetique mettrait 1 avant 212,
     *     mais aussi 33 apres 212 ; on compare donc les nombres.
     *   - le reste  : ALPHABETIQUE, avec localeCompare pour que Egypte passe
     *     avant Emirats et Etats-Unis, ce qu'un tri par code ne fait pas.
     *
     * Les niveaux d'etudes ne sont volontairement PAS tries : leur ordre
     * naturel est pedagogique (College, Seconde, Premiere, Terminale...) et
     * l'alphabet le detruirait. Le socle a deja son propre classement pour
     * eux, via `ordre`.
     */
    function trier(name, options) {
        if (!options || options.length < 2) return options;
        var copie = options.slice();

        if (name === 'Indicatif') {
            copie.sort(function (a, b) {
                var na = parseInt(a.value, 10);
                var nb = parseInt(b.value, 10);
                if (isNaN(na) && isNaN(nb)) return 0;
                if (isNaN(na)) return 1;
                if (isNaN(nb)) return -1;
                return na - nb;
            });
            return copie;
        }

        if (name === 'Country' || name === 'Campus') {
            // Tri sur le libelle AFFICHE, et dans la locale de la page : une
            // liste anglaise triee selon l'alphabet francais serait desordonnee
            // pour le lecteur.
            var lg = langueAffichage();
            var loc = lg === 'en' ? 'en' : 'fr';
            copie.sort(function (a, b) {
                var la = libelleAffiche(a, lg);
                var lb = libelleAffiche(b, lg);
                return String(la).localeCompare(String(lb), loc, { sensitivity: 'base' });
            });
            return copie;
        }

        return options;
    }

    /** Remplit un <select> en conservant sa 1re option (le placeholder). */
    function remplir(name, options, valeurCourante) {
        var el = champ(name);
        if (!el || el.tagName !== 'SELECT') return null;

        // Salesforce n'a rien renvoye pour cette liste : on NE TOUCHE PAS au
        // <select>. Les options statiques deja presentes (baked par le builder)
        // servent de repli, et un champ obligatoire ne se retrouve jamais vide
        // ni desactive a cause d'un value set introuvable cote org.
        if (!options || !options.length) return el;

        options = trier(name, options);
        var langue = langueAffichage();

        var placeholder = el.querySelector('option[value=""]');
        el.innerHTML = '';
        if (placeholder) el.appendChild(placeholder);

        for (var i = 0; i < options.length; i++) {
            var o = document.createElement('option');
            // La valeur reste celle du CRM ; seul le texte est traduit.
            o.value = options[i].value;
            o.textContent = libelleAffiche(options[i], langue);
            if (valeurCourante && options[i].value === valeurCourante) o.selected = true;
            el.appendChild(o);
        }
        el.disabled = options.length === 0;
        return el;
    }

    /**
     * Valeurs distinctes d'une propriete, sur des programmes deja filtres.
     * Les MULTIPICKLISTS Salesforce arrivent serialises "a;b;c" : on les eclate,
     * sinon "Terminale;Bac obtenu" deviendrait une option unique que personne
     * ne peut choisir, et les deux niveaux reels disparaitraient du menu.
     */
    function distinct(rows, prop) {
        var vus = {}, out = [];
        for (var i = 0; i < rows.length; i++) {
            var brut = rows[i][prop];
            if (!brut) continue;
            var parts = String(brut).split(';');
            for (var j = 0; j < parts.length; j++) {
                var v = parts[j].replace(/^\s+|\s+$/g, '');
                if (!v || vus[v]) continue;
                vus[v] = true;
                out.push({ value: v, label: v });
            }
        }
        return out;
    }

    /** Une cellule multipicklist "a;b;c" contient-elle la valeur attendue ? */
    function contient(cellule, attendu) {
        if (cellule === attendu) return true;
        if (!cellule) return false;
        var parts = String(cellule).split(';');
        for (var i = 0; i < parts.length; i++) {
            if (parts[i].replace(/^\s+|\s+$/g, '') === attendu) return true;
        }
        return false;
    }

    /** Filtre les programmes sur les criteres renseignes (un vide = ignore). */
    function filtrer(criteres) {
        return D.programs.filter(function (p) {
            for (var k in criteres) {
                if (!criteres[k]) continue;          // critere non renseigne -> ignore
                // egalite tolerante : un programme "Bac+2;Bac+3" doit remonter
                // pour Bac+2 ET pour Bac+3.
                if (!contient(p[k], criteres[k])) return false;
            }
            return true;
        });
    }

    function valeur(name) { var e = champ(name); return e ? e.value : ''; }

    /* -- Matrice des champs conditionnels par ecole -------------------- */
    var CFG = D.config || null;

    /** Ordinal du niveau choisi. 0 si inconnu : aucune regle ne se declenche. */
    function ordreNiveauChoisi() {
        var v = valeur('Niveau') || valeur('Level') || valeur('StudyLevel');
        if (!v || !D.picklists || !D.picklists.StudyLevel) return 0;
        for (var i = 0; i < D.picklists.StudyLevel.length; i++) {
            if (D.picklists.StudyLevel[i].value === v) {
                return Number(D.picklists.StudyLevel[i].ordre) || 0;
            }
        }
        return 0;
    }

    /**
     * Affiche ou masque le porteur visuel d'un champ.
     *
     * On remonte au conteneur plutot que de masquer le <select> seul : masquer
     * l'input laisserait son libelle orphelin a l'ecran. La liste de selecteurs
     * couvre les enveloppes des blocs du builder ; a defaut on retombe sur le
     * parent direct.
     *
     * ⚠ Le champ est masque, PAS vide : le contrat impose qu'une valeur unique
     * soit transmise au CRM meme lorsqu'elle n'est pas proposee au candidat.
     */
    function afficher(name, visible) {
        var el = champ(name);
        if (!el) return;
        var porteur = el.closest
            ? (el.closest('[data-socle-champ]') || el.closest('.form-group') ||
               el.closest('.field') || el.closest('label') || el.parentNode)
            : el.parentNode;
        (porteur || el).style.display = visible ? '' : 'none';
    }

    /**
     * Un champ conditionnel doit-il etre propose ?
     *   jamais   -> non, quelle que soit la saisie
     *   toujours -> oui
     *   niveau   -> seulement si le niveau choisi atteint le seuil
     * Un ordinal a 0 (niveau non choisi, ou libelle absent du mapping) ne
     * declenche donc PAS l'affichage : on prefere masquer que proposer a tort.
     */
    function autorise(name) {
        if (!CFG || !CFG.champs || !CFG.champs[name]) return true;   // pas de config = ancien comportement
        var regle = CFG.champs[name];
        if (regle.visible === 'jamais') return false;
        if (regle.visible === 'niveau') return ordreNiveauChoisi() >= Number(regle.niveauMin || 0);
        return true;
    }

    /* -- Ordre d'affichage propre a l'ecole ----------------------------------
       `CFG.ordre` vaut par exemple, pour IFA Paris :
           campus,niveau,language,speciality,rhythm,rentree
       soit la LANGUE avant la specialite, alors que l'ordre standard est
       l'inverse. La matrice ne dit donc pas seulement QUELS champs afficher,
       mais dans quel ORDRE — et l'ordre est une regle metier : on ne demande
       pas la specialite avant d'avoir fixe la langue d'enseignement, sinon on
       propose des specialites qui n'existent pas dans la langue choisie.

       On reordonne le DOM une seule fois, pas a chaque rafraichissement de la
       cascade : deplacer des noeuds a chaque `change` ferait perdre le focus du
       champ que l'utilisateur vient de quitter.

       Les noms de la config sont ceux du contrat (`speciality`, `rhythm`...) ;
       les attributs name[] du formulaire sont capitalises. D'ou la table. */
    var NOM_DOM = {
        campus: 'Campus', niveau: 'Niveau', level: 'Niveau',
        speciality: 'Speciality', rhythm: 'Rhythm', language: 'Language',
        rentree: 'Rentree', programme: 'Programme'
    };

    function appliquerOrdre() {
        if (!CFG || !CFG.ordre) return;

        var demande = String(CFG.ordre).split(',');
        var porteurs = [], parent = null;

        for (var i = 0; i < demande.length; i++) {
            var cle = demande[i].replace(/^\s+|\s+$/g, '');
            var el = champ(NOM_DOM[cle] || cle);
            if (!el) continue;

            /* On deplace le PORTEUR visuel, pas le <select> seul : sinon le
               libelle resterait a son ancienne place, dissocie de son champ. */
            var porteur = el.closest
                ? (el.closest('[data-socle-champ]') || el.closest('.form-group') ||
                   el.closest('.field') || el.parentNode)
                : el.parentNode;
            if (!porteur || !porteur.parentNode) continue;

            /* Tous les champs de la cascade doivent partager le meme parent,
               sinon reordonner reviendrait a les deplacer d'une section a une
               autre. On s'aligne sur le parent du premier trouve et on ignore
               les autres — mieux vaut un ordre partiel qu'un formulaire
               demonte. */
            if (!parent) parent = porteur.parentNode;
            if (porteur.parentNode !== parent) continue;

            porteurs.push(porteur);
        }

        if (!parent || porteurs.length < 2) return;

        /* Les champs de la cascade ABSENTS de `ordre` — typiquement Programme,
           qui n'y figure jamais — doivent garder leur place. Les oublier les
           renverrait en tete : tous les champs listes seraient deplaces apres
           eux. C'est ce que faisait la premiere version, et le formulaire
           s'ouvrait sur le champ Programme. */
        var deja = {};
        for (var k = 0; k < porteurs.length; k++) deja[k] = true;
        var restants = [];
        for (var n2 in NOM_DOM) {
            if (!NOM_DOM.hasOwnProperty(n2)) continue;
            var e2 = champ(NOM_DOM[n2]);
            if (!e2) continue;
            var p2 = e2.closest ? (e2.closest('[data-socle-champ]') ||
                     e2.closest('.form-group') || e2.closest('.field') ||
                     e2.parentNode) : e2.parentNode;
            if (!p2 || p2.parentNode !== parent) continue;
            if (porteurs.indexOf(p2) === -1 && restants.indexOf(p2) === -1) restants.push(p2);
        }
        var sequence = porteurs.concat(restants);

        /* On reinsere DANS le bloc d'origine, pas a la fin du parent : celui-ci
           contient aussi le nom, l'email, les consentements. Un appendChild
           renverrait toute la cascade apres eux. On prend donc comme repere
           l'element qui suivait le dernier champ de la cascade. */
        var dernier = sequence[0], idx = -1;
        for (var m = 0; m < parent.childNodes.length; m++) {
            if (sequence.indexOf(parent.childNodes[m]) !== -1) { idx = m; dernier = parent.childNodes[m]; }
        }
        var repere = dernier ? dernier.nextSibling : null;

        for (var j = 0; j < sequence.length; j++) {
            if (repere) parent.insertBefore(sequence[j], repere);
            else parent.appendChild(sequence[j]);
        }
    }

    /* -- 1. Listes independantes ------------------------------------- */
    for (var nom in D.picklists) {
        if (D.picklists.hasOwnProperty(nom)) remplir(nom, D.picklists[nom], valeur(nom));
    }
    remplir('Campus', D.campus, valeur('Campus'));

    /* -- 2. Cascade programme ---------------------------------------- */
    function rafraichirCascade() {
        // Cascade complete (niveau -> specialite -> ... -> rentree -> programme
        // -> PTAT) : reservee aux formulaires qui portent la RENTREE, comme
        // form-salesforce-core. Les formulaires EDH (brochure, JPO, immersion,
        // candidature...) n'ont pas de <select name="Rentree"> : leur champ
        // Programme suit une logique propre, on n'y touche donc pas.
        if (!champ('Rentree')) return;

        var sel = {
            campus:     valeur('Campus'),
            level:      valeur('Niveau') || valeur('Level'),
            speciality: valeur('Speciality'),
            rhythm:     valeur('Rhythm'),
            language:   valeur('Language')
        };

        // chaque liste ne propose que ce qui reste possible en amont
        remplir('Niveau',     distinct(filtrer({ campus: sel.campus }), 'level'), sel.level);
        remplir('Speciality', distinct(filtrer({ campus: sel.campus, level: sel.level }), 'speciality'), sel.speciality);
        remplir('Rhythm',     distinct(filtrer({ campus: sel.campus, level: sel.level, speciality: sel.speciality }), 'rhythm'), sel.rhythm);
        remplir('Language',   distinct(filtrer({ campus: sel.campus, level: sel.level, speciality: sel.speciality, rhythm: sel.rhythm }), 'language'), sel.language);

        /* -- Application de la matrice ------------------------------------
           Trois raisons de masquer, dans cet ordre de priorite :
             1. la matrice de l'ecole l'interdit (jamais, ou seuil de niveau) ;
             2. le mode PROGRESSIF et le champ precedent n'est pas renseigne ;
             3. une seule valeur possible — le contrat demande de masquer le
                champ tout en transmettant la valeur au CRM, ce que fait deja
                `remplir` en pre-selectionnant.
           Le champ EFAP est le contre-exemple du point 2 : sa configuration
           porte progressif=false, tous les champs sont donc proposes d'emblee. */
        var progressif = !CFG || CFG.progressif !== false;
        var conditionnels = ['Speciality', 'Rhythm', 'Language'];

        for (var c = 0; c < conditionnels.length; c++) {
            var nom = conditionnels[c];
            var el  = champ(nom);
            if (!el) continue;

            var nbOptions = el.options ? el.options.length : 0;
            var visible = autorise(nom);

            if (visible && progressif) {
                // en mode progressif, le champ n'apparait qu'une fois le niveau pose
                if (!sel.level) visible = false;
            }
            // une seule option reelle (hors placeholder) : valeur transmise, champ masque
            if (visible && nbOptions <= 1) visible = false;

            afficher(nom, visible);
        }

        // Langue par defaut (IFA Paris : francais) si rien n'est encore choisi
        if (CFG && CFG.langueDefaut) {
            var elLang = champ('Language');
            if (elLang && !elLang.value) elLang.value = CFG.langueDefaut;
        }

        // programmes encore valides -> rentrees possibles
        var valides = filtrer(sel);
        var idsValides = {};
        valides.forEach(function (p) { idsValides[p.id] = true; });

        var termesVus = {}, termes = [];
        D.ptats.forEach(function (t) {
            if (!idsValides[t.programId] || termesVus[t.termId]) return;
            termesVus[t.termId] = true;
            var libelle = D.terms.filter(function (x) { return x.value === t.termId; })[0];
            termes.push({ value: t.termId, label: libelle ? libelle.label : t.termId });
        });
        var rentree = valeur('Rentree');
        remplir('Rentree', termes, rentree);
        rentree = valeur('Rentree');

        // programmes ouverts a la rentree choisie
        var progs = [];
        if (rentree) {
            var vus = {};
            D.ptats.forEach(function (t) {
                if (t.termId !== rentree || !idsValides[t.programId] || vus[t.programId]) return;
                vus[t.programId] = true;
                var p = valides.filter(function (x) { return x.id === t.programId; })[0];
                progs.push({ value: t.programId, label: p ? p.name : t.programId });
            });
        }
        var programme = valeur('Programme');
        remplir('Programme', progs, programme);
        programme = valeur('Programme');

        // resolution du PTAT final -> champ cache transmis a l'ecriture
        var cible = champ('PTAT_Id');
        if (cible) {
            var trouve = D.ptats.filter(function (t) {
                return t.programId === programme && t.termId === rentree;
            })[0];
            cible.value = trouve ? trouve.ptatId : '';
        }
    }

    ['Campus', 'Niveau', 'Level', 'Speciality', 'Rhythm', 'Language', 'Rentree', 'Programme']
        .forEach(function (n) {
            var el = champ(n);
            if (el) el.addEventListener('change', rafraichirCascade);
        });
    appliquerOrdre();                 // une seule fois : voir le commentaire
    if (D.programs.length) rafraichirCascade();

    /* -- 3. Famille evenement : dates + ateliers ---------------------- */

    /**
     * Les dates proposees pour UN campus.
     *
     * La regle metier : la prochaine date de CE campus, puis tout ce qui tombe
     * dans les 15 jours qui la suivent.
     *
     *   « les prochaines JPO BRASSART Lyon sont le 10 et le 17 octobre : je
     *     peux choisir l'une ou l'autre. A Bordeaux, le 10 octobre et le 10
     *     novembre : je ne peux choisir que le 10 octobre. »
     *
     * La fenetre se calcule donc ICI et non dans le socle : elle depend d'un
     * choix fait apres le rendu. Le socle publie toutes les dates a venir de
     * l'ecole avec leur ecart en jours ; on ne garde que celles du campus.
     *
     * Campus non encore choisi : on rend TOUT, sans fenetre. Masquer les dates
     * avant que le visiteur ait choisi lui laisserait croire qu'il n'y en a
     * aucune.
     */
    function datesPour(campus) {
        var toutes = (D.instances || []).slice();
        if (!campus) return toutes.sort(parJour);

        var duCampus = toutes.filter(function (i) { return i.campus === campus; });
        if (!duCampus.length) return [];

        var plusProche = duCampus.reduce(function (m, i) {
            var j = Number(i.jours);
            return (m === null || j < m) ? j : m;
        }, null);

        return duCampus
            .filter(function (i) {
                var j = Number(i.jours);
                return j >= plusProche && j <= plusProche + 15;
            })
            .sort(parJour);
    }

    function parJour(a, b) { return (Number(a.jours) || 0) - (Number(b.jours) || 0); }

    /**
     * Les ateliers proposes pour UNE instance.
     *
     * `instance` porte l'Id de l'instance a laquelle l'atelier est restreint
     * (le champ Salesforce s'appelle summit__Restrict_To_Instance_Title__c mais
     * contient bien un Id). Vide = propose sur toutes les dates.
     */
    function ateliersDe(instanceId) {
        if (!D.appointments || !D.appointments.length) return [];
        var inst = (D.instances || []).filter(function (i) { return i.value === instanceId; })[0];
        var evt = inst ? inst.evenement : '';
        return D.appointments.filter(function (a) {
            /* Deux filtres, pas un. L'evenement d'abord : le socle publie
               desormais les ateliers de TOUS les evenements de l'ecole, et ceux
               d'une JPO Lyon n'ont rien a faire sur une date Bordeaux.
               La restriction d'instance ensuite, quand elle est posee. */
            if (evt && a.evenement && a.evenement !== evt) return false;
            return !a.instance || a.instance === instanceId;
        }).sort(function (x, y) {
            /* Par horaire de conference d'abord : c'est l'ordre du deroulé de
               la journee, celui qu'un visiteur attend. `summit__Sort_Order__c`
               ne prend le relais que si les horaires manquent. */
            if (x.debut && y.debut && x.debut !== y.debut) {
                return x.debut < y.debut ? -1 : 1;
            }
            return (Number(x.ordre) || 0) - (Number(y.ordre) || 0);
        });
    }

    /**
     * "2026-08-29T09:30:00.000Z" -> "09:30", "09:30:00.000Z" -> "09:30".
     *
     * Deux formats a absorber : les creneaux de conference sont des DATE-HEURES
     * (summit__Date_Available_Start__c), les horaires d'instance de simples
     * HEURES (summit__Instance_Start_Time__c). On ne garde que heure et minute
     * — la date est deja sur la ligne, et les millisecondes n'apprennent rien.
     *
     * Format inattendu : on rend la valeur telle quelle plutot que de masquer
     * l'information.
     */
    function heureSeule(v) {
        var t = String(v || '');
        var m = t.match(/T(\d{2}:\d{2})/) || t.match(/^(\d{2}:\d{2})/);
        return m ? m[1] : t;
    }

    /** "09:30 - 10:30" quand les deux bornes sont la, sinon ce qu'on a. */
    function plage(debut, fin) {
        var d = debut ? heureSeule(debut) : '';
        var f = fin ? heureSeule(fin) : '';
        if (d && f) return d + ' - ' + f;
        return d || f;
    }

    /** Le texte a afficher pour une date : horaires et adresse compris. */
    function libelleInstance(inst) {
        var bouts = [];
        if (inst.date)   bouts.push(inst.date);
        var h = plage(inst.heure, inst.heureFin);
        if (h)           bouts.push(h);
        if (inst.campus) bouts.push(inst.campus);
        if (inst.address) bouts.push(inst.address);
        return bouts.length ? bouts.join(' · ') : (inst.label || inst.value);
    }

    /**
     * Rend la liste des ateliers de la date courante.
     *
     * Appelee a chaque changement de date : les conferences d'une JPO du 10
     * septembre ne sont pas celles du 17 octobre, et le socle ne peut pas
     * savoir a l'avance laquelle le visiteur choisira.
     */
    function rendreAteliers(instanceId) {
        var zone = document.querySelector('[data-socle="appointments"]');
        if (!zone) return;
        var liste = ateliersDe(instanceId);
        zone.innerHTML = '';

        liste.forEach(function (a) {
            var id = 'appt_' + String(a.value).replace(/[^a-zA-Z0-9_-]/g, '');
            var wrap = document.createElement('label');
            wrap.className = 'socle-appointment';

            var box = document.createElement('input');
            box.type = 'checkbox';
            box.id = id;
            box.value = a.value;
            box.checked = (a.required === true || a.required === 'true');
            box.setAttribute('data-required', String(a.required));

            var txt = document.createElement('span');
            /* Les horaires viennent de summit__Date_Available_Start__c /
               _End__c sur le type : c'est la que le CRM porte les creneaux de
               conference. */
            var h = plage(a.debut, a.fin);
            txt.textContent = a.label
                + (h ? ' — ' + h : '')
                + (box.checked ? ' (obligatoire)' : '');

            wrap.appendChild(box);
            wrap.appendChild(txt);
            zone.appendChild(wrap);
        });

        /* Regroupe les cases cochees dans le champ cache "Appointments", que le
           socle d'ecriture decoupe sur les virgules.

           A REFAIRE a chaque rendu : les cases sont recreees quand la date
           change, et l'ecouteur pose sur les anciennes disparait avec elles.
           Le champ cache est remis a jour tout de suite, pour que les ateliers
           obligatoires soient comptes meme si le visiteur ne touche a rien. */
        var cible = champ('Appointments');
        if (cible) {
            var maj = function () {
                var coches = zone.querySelectorAll('input[type="checkbox"]:checked');
                var vals = [];
                for (var i = 0; i < coches.length; i++) vals.push(coches[i].value);
                cible.value = vals.join(',');
            };
            zone.addEventListener('change', maj);
            maj();
        }
    }

    if (D.instances && D.instances.length) {
        var elInst = champ('InstanceId');
        var zoneDates = document.querySelector('[data-socle="instances"]');
        var elCampus = champ('Campus');

        /**
         * Rend les dates du campus courant, puis les ateliers de la premiere.
         *
         * Deux rendus possibles, selon ce que le formulaire pose :
         *   BOUTONS RADIO dans [data-socle="instances"] — ce que demande la
         *   regle metier, la date la plus proche presélectionnée ;
         *   SELECT name="InstanceId" — repli pour les formulaires anciens.
         */
        function rendreDates() {
            var liste = datesPour(elCampus ? elCampus.value : '');

            if (zoneDates) {
                zoneDates.innerHTML = '';
                liste.forEach(function (inst, i) {
                    var id = 'inst_' + String(inst.value).replace(/[^a-zA-Z0-9_-]/g, '');
                    var wrap = document.createElement('label');
                    wrap.className = 'socle-instance';

                    var radio = document.createElement('input');
                    radio.type = 'radio';
                    radio.name = 'InstanceId';
                    radio.id = id;
                    radio.value = inst.value;
                    if (i === 0) radio.checked = true;

                    var txt = document.createElement('span');
                    txt.textContent = libelleInstance(inst);

                    radio.addEventListener('change', function () {
                        if (radio.checked) rendreAteliers(radio.value);
                    });

                    wrap.appendChild(radio);
                    wrap.appendChild(txt);
                    zoneDates.appendChild(wrap);
                });

            } else if (elInst && elInst.tagName === 'SELECT') {
                remplir('InstanceId', liste, valeur('InstanceId'));
                if (!elInst.value && liste.length) elInst.value = liste[0].value;
            }

            /* Les ateliers suivent la date retenue. Aucune date : on vide, sans
               quoi la liste de la selection precedente resterait a l'ecran. */
            rendreAteliers(liste.length ? liste[0].value : '');
        }

        if (elInst && elInst.tagName === 'SELECT') {
            elInst.addEventListener('change', function () { rendreAteliers(elInst.value); });
        }
        /* Changer de campus rebat les dates : la fenetre de 15 jours se calcule
           sur le campus retenu, pas sur l'ecole entiere. */
        if (elCampus) elCampus.addEventListener('change', rendreDates);
        rendreDates();
    }

    }   /* fin demarrer() */
})();
%%=v(@cascadeFerme)=%%
<!-- ===== fin JS DE CASCADE ===== -->
