%%[
/* ============================================================================
   HANDLER FORMULAIRE — ECRITURE SALESFORCE EN AMPSCRIPT
   ============================================================================
   Porte `handler-form.ssjs` + `socle-upsert.ssjs`. A inclure EN HAUT de la
   CloudPage, avant l'affichage du formulaire.

   Pourquoi AMPscript : sur cette org, ni une CloudPage ni une Automation ne
   peuvent atteindre Salesforce en SSJS (« Unable to retrieve security
   descriptor for this frame »). AMPscript y lit ET y ecrit — ecriture verifiee
   le 2026-08-17. Cf. ../diagnostic/README.md. Ne pas re-tenter en SSJS.

   Sequence, identique pour tous les formulaires de la famille campagne :
       1. Account (Person Account)  upsert sur PersonEmail, fill-if-blank
       2. ContactPointConsent       upsert sur ContactPointId + Channel__c
       3. CampaignMember            upsert sur CampaignId + PA

   --- Ce qu'AMPscript impose, et qui explique la forme du code --------------
   1. PAS de fonctions utilisateur. `fillIfBlank` et `mapTracking`, factorises
      en SSJS, sont donc deroules ici. C'est verbeux et c'est assume : le seul
      moyen de le raccourcir serait de perdre le fill-if-blank.
   2. `UpdateSingleSalesforceObject` ne prend PAS de compteur de champs,
      contrairement a `CreateSalesforceObject` — asymetrie facile a rater.
   3. Le nombre d'arguments ne peut pas etre construit dynamiquement : le
      fill-if-blank se fait donc en UN APPEL PAR CHAMP a completer. Seuls les
      champs reellement vides declenchent un appel, donc en pratique zero ou un
      sur un contact deja connu.
   4. PAS de try/catch : une erreur remplace la page. Chaque appel est donc
      precede de ses garde-fous (email present, Id resolu, valeur non vide).
   ============================================================================ */

/* ⚠⚠ A RENSEIGNER AVANT TOUTE MISE EN SERVICE ⚠⚠
   RecordTypeId du Person Account de l'org (UAT != Prod).
   Tant qu'il est vide, ce handler NE CREE AUCUN compte : il se limite a
   completer les comptes existants. C'est volontaire — creer un Account sans
   RecordType produirait des comptes ENTREPRISE au lieu de comptes personnels,
   erreur silencieuse et penible a rattraper en masse. */
VAR @RT_PERSON_ACCOUNT
/* Releve sur l'org RECETTE le 2026-08-17 : RecordType DeveloperName
   = "PersonAccount", libelle "Compte personnel". A REVERIFIER en Prod, les
   RecordTypeId ne sont pas portables d'une org a l'autre. */
SET @RT_PERSON_ACCOUNT = "012Wx000000KF9NIAW"

/* ---- CIBLE DES CHAMPS D'IDENTITE -----------------------------------------
   Account ou Contact ? Les DEUX fonctionnent, verifie le 2026-08-23 :
     Account.FirstName sur 001AW00001igoPyYAI -> OK
     Contact.FirstName sur 003AW00000zuDx7YAE -> OK

   ⚠ On ecrit sur l'ACCOUNT, pas sur le Contact. Le contrat v4 est explicite :
   « Contact — ⛔ Reserve a Livestorm (LeadSource = Webinar) ». Les formulaires
   Marketing Cloud ecrivent DIRECTEMENT le Person Account. Ecrire sur le Contact
   marcherait techniquement, mais empieterait sur un objet dont un autre flux est
   proprietaire.

   "true" pour rebasculer sur le Contact si le contrat change. */
VAR @IDENTITE_SUR_CONTACT
SET @IDENTITE_SUR_CONTACT = "false"

/* ---- ECRITURE DE L'IDENTITE : ACTIVE ------------------------------------
   ⚠ CORRECTION du 2026-08-23. Les runs dd774885111d et b8b0b6d5ea58 avaient
   conclu que FirstName etait refuse sur Account ET sur Contact. C'ETAIT FAUX :
   les deux essais visaient le meme enregistrement, `001AW00001ihDOvYAM`
   (bob.martin.test@edh-test.com), qui refuse TOUTE ecriture — y compris sur un
   simple champ custom.

   Verifie par les blocs de diagnostic sur deux autres comptes :
     Account.FirstName  sur 001AW00001igoPyYAI et 001AW00001xraQIYAY -> OK
     Contact.FirstName  sur 003AW00000zuDx7YAE                       -> OK
     Account.UTMSource__c sur les memes                              -> OK

   Lecon : ne jamais conclure sur un champ a partir d'un seul enregistrement.
   Le compte 001AW00001ihDOvYAM est a ecarter des jeux de test (verrou ou
   partage propre a ce record, non diagnostique). */
VAR @ECRIRE_IDENTITE
SET @ECRIRE_IDENTITE = "true"
/* ---- REGLES DE BLOCAGE CANDIDATURE ---------------------------------------
   Noms CONFRONTES A L'ORG le 2026-08-23, sur les 123 champs de
   IndividualApplication (285 candidatures en base) :

     IndividualApplication        existe
     ContactId                    existe
     ProgramTermApplnTimelineId   existe
     Status                       existe
     AcademicYear__c              ⛔ N'EXISTE PAS sur cet objet

   L'annee scolaire vit sur le PTAT, pas sur la candidature
   (`PTAT-0000013 - ... - 2026`, champ AcademicYear__c). Le critere « meme
   annee » etait donc REDONDANT : un PTAT est deja propre a une annee, donc
   filtrer sur le PTAT suffit. Le champ est supprime, pas remplace.

   La regle est desormais ACTIVE : les trois noms restants existent, donc la
   lecture ne peut plus tuer la page. */
VAR @REGLES_ACTIVES, @OBJ_APPLICATION, @F_APP_PERSON, @F_APP_PTAT, @F_APP_STATUS
VAR @F_APP_DECISION, @VAL_REFUSE
SET @REGLES_ACTIVES  = "true"
SET @OBJ_APPLICATION = "IndividualApplication"
SET @F_APP_PERSON    = "ContactId"
SET @F_APP_PTAT      = "ProgramTermApplnTimelineId"
SET @F_APP_STATUS    = "Status"
SET @F_APP_DECISION  = "FinalDecision__c"

/* ---- LA VALEUR QUI DECLENCHE R2 : `Rejected` ------------------------------
   Tranche par le metier le 2026-09-01. Le refus est `Rejected`, et non
   `Canceled` comme l'etape precedente l'avait retenu.

   ⚠ ELLE EST CHERCHEE DANS LES DEUX CHAMPS, et c'est deliberé :

     `FinalDecision__c`  value set « Jury Recommendation » :
                         Admitted · **Rejected** · Absent_Interview ·
                         Pending · Enrolled
                         → 7 des 321 candidatures de la recette la portent.

     `Status`            value set « Application Status », releve sur la
                         capture du 2026-09-01 :
                         ACTIVES   Application in Progress (defaut) ·
                                   Application Submitted · Application Fee
                                   Paid · Initial Application Review ·
                                   Interview & Jury Scheduling · Interview &
                                   Jury Scheduled · Secondary Application
                                   Review · Application Complete ·
                                   Withdrawn / Abandoned
                         INACTIVES 1st / 2nd review non compliant ·
                                   Processing · In Review · Ready For
                                   Decision · Application Decision ·
                                   Canceled · Enrolled · Enrollment Failed
                         → `Rejected` N'Y FIGURE PAS, ni active ni inactive.

   Lire les deux ne coute qu'une comparaison et retire le seul risque qui
   compte ici : celui d'une regle muette. Le projet en a deja fait les frais —
   R2 s'appuyait sur `FinalDecision__c` a une epoque ou l'on croyait le champ
   alimente, et n'a jamais pu se declencher. Une LECTURE ne peut pas casser la
   page, contrairement a une ecriture : le seul cout d'un champ qui reste vide
   est qu'il ne dit rien.

   Comparaison EXACTE en minuscules, pas en sous-chaine : les deux value sets
   sont fermes et courts, une sous-chaine n'apporterait que des faux positifs.

   `Absent_Interview` n'est PAS traite comme un refus : c'est un constat
   d'absence, qui peut preceder une decision mais n'en est pas une. Il tombe
   donc sur R1, comme tout le reste. */
SET @VAL_REFUSE      = "rejected"

/* ---- AUCUNE AUTRE EXCEPTION ----------------------------------------------
   Le statut ne sert qu'a CHOISIR LE MESSAGE, pas a decider du blocage : toute
   candidature deja posee sur le couple personne x PTAT bloque la suivante.
   `Rejected` donne R2, tout le reste donne R1 — statut vide compris.

   `Withdrawn / Abandoned` faisait exception jusqu'au 2026-09-01 : un dossier
   abandonne laissait passer, au motif que le candidat avait renonce et pouvait
   revenir. Le metier a tranche l'inverse — il repasse par les admissions,
   comme les autres. */

/* ---- QUELLE REGLE A BLOQUE -----------------------------------------------
   R1 et R2 n'ont pas le meme message, et le visiteur ne voit que le message.
   `@sfBlockMsg` etait pose ici depuis l'origine mais n'etait EMIS nulle part :
   la reponse portait `statut=blocked` et rien d'autre, si bien que le front
   tombait sur sa branche d'echec et affichait « le CRM a refuse l'ecriture »
   — un message technique, a un candidat, pour un refus parfaitement normal.

   On emet donc le MOTIF (`r1` / `r2`), et le front porte la formulation
   exacte du cadrage, accents compris : AMPscript ne sort pas d'accent sur ce
   projet, et le message client en comporte. */
VAR @sfBlockMsg, @sfBlockRule, @candContactId, @candRows, @nCand, @candStatut, @candDecision
VAR @candPortee
SET @sfBlockMsg = ""
SET @sfBlockRule = ""

VAR @submitted, @email, @emailInvalide, @ecole, @formType
VAR @lastName, @firstName, @country, @indicatif, @mobile, @studyLevel, @vousEtes
VAR @speciality, @specRows, @progRows
VAR @ptatId, @campaignId, @brandId, @legalText, @legalFooter
VAR @utmS, @utmM, @utmC, @utmCo, @utmT, @utmI, @gclid, @fbclid, @clientId, @canal, @sousCanal
VAR @utmCampus, @consent, @consentVoulu, @dateCookies
VAR @detailOrigine, @appRequested, @specialiteOk, @ptatMaj, @champsMaj
VAR @vLast, @vFirst, @vPays, @vIndic, @vMobile, @vNiveau, @vType, @vEcole, @vUtmS, @vUtmM, @vUtmC, @vUtmCo, @vUtmT, @vUtmI, @vUtmCampus, @vGclid, @vFbclid, @vClient, @vConsent, @vDetail, @vSpec
VAR @rows, @n, @row, @paId, @paContactId, @isNew, @schoolAccId, @campusSel
VAR @i, @canalParam, @canalValue, @coche, @cpcId, @cmId, @preuve, @cpEmail, @cpPhone, @cpId
VAR @cpcMail, @cpcTel, @cpcRows, @cpcRow, @nCpcMail, @nCpcTel, @nCpc, @k, @majs
VAR @isEvent, @instanceId, @extId, @regId, @appts, @apptRows, @nA, @apptType
VAR @zone, @cleCampagne, @campActif, @typeEvt, @mode, @langue, @typeForm
VAR @sfStatus, @sfErrorMsg, @journal

/* ---- JOURNAL DE SOUMISSION ------------------------------------------------
   Une ligne par etape, ecrite AU FUR ET A MESURE dans LPB_Log_Soumissions.

   Pourquoi au fur et a mesure et non a la fin : AMPscript n'a pas de try/catch.
   Une erreur Salesforce remplace la page entiere et TOUT ce qui suit est perdu,
   y compris un journal ecrit en bloc a la sortie. Ecrire etape par etape rend
   donc la panne lisible : la DERNIERE ligne d'un RunId designe l'etape fautive.
   C'est le seul moyen de savoir ou ca casse sur cette plateforme.

   Coup : une ecriture de DE par etape, ~10 par soumission. Acceptable en
   recette, a passer a "false" avant la Prod. */
/* ---- HISTORISATION DES INTERACTIONS -------------------------------------
   ACTIVE depuis le 2026-08-26.

   Histoire de la panne, parce qu'elle a failli faire conclure a un blocage
   d'objet. Le socle ecrivait `CampaignMember__c`, un champ INEXISTANT. Comme
   AMPscript n'a pas de try/catch, une creation refusee REMPLACE la page — et ce
   chemin est atteint des qu'un CampaignMember existe deja. La page mourait donc
   a chaque retour d'un prospect connu : panne totale, invisible en test puisque
   chaque test creait un prospect neuf.

   Apres correction des noms, l'insert echouait toujours, y compris avec un seul
   champ texte. J'ai failli conclure que l'objet refusait la creation. C'etait
   faux : la bissection designe `CampaignMemberLink__c`, le SEUL champ dont la
   presence fait echouer l'insert. Le lien vers le membre passe donc par
   `CampaignMemberId__c`, en texte.

   Verifie sur l'org : la paire `Campaign__c` + `PersonAccount__c` suffit
   (a1RAW000003uP5F2AU), et c'est exactement ce que portent les 3 interactions
   preexistantes — aucun autre champ n'y est rempli.

   Le drapeau reste : il evite de tuer la page a chaque soumission si l'objet se
   remet a refuser, pendant qu'on diagnostique. */
VAR @INTERACTION_ACTIVE
SET @INTERACTION_ACTIVE = "true"

/* ---- OBJET CIBLE DE L'INTERACTION ---------------------------------------
   Bascule du 2026-08-26 sur `Interaction__c`, le nouvel objet de la US de
   generalisation. Ce n'etait PAS un renommage : les deux objets coexistent,
   l'ancien garde ses donnees, le neuf est vide et porte le modele complet.
   Releve par la sonde `LPB_TST_Sonde_Etat`.

   Ce que le neuf apporte et que l'ancien n'a pas :
     - 4 record types actifs, dont Form = 012AW00000AxdXSYAZ
     - `Preview__c` et `Context__c` (absents de l'ancien : les demander
       la-bas tue la page — c'est le marqueur qui distingue les deux)
     - `Status__c`, accepte a "Submitted"

   Ecriture verifiee sur l'org avant bascule, 8 champs d'un coup
   (a1UAW000005Japh2AC), puis les champs de tracking un a un.

   `CampaignMemberLink__c` existe sur les deux objets et reste refuse a
   l'ecriture sur les DEUX. Le lien vers le membre passe toujours par
   `CampaignMemberId__c`, en texte.

   Repasser a "CampaignMemberInteraction__c" suffit a revenir en arriere. */
/* ---- MARQUE SUR LE CONSENTEMENT -----------------------------------------
   A "false" depuis le 27/08/2026.

   `BusinessBrandId` porte la marque au nom de laquelle le consentement est
   donne — un opt-in EFAP n'est pas un opt-in BRASSART, et le RGPD demande un
   consentement par responsable de traitement. Le champ etait envoye et accepte
   le matin du 27/08 ; l'apres-midi il fait echouer l'insert, et ce refus tuait
   la page a CHAQUE soumission des 6 formulaires.

   Mesure a la bissection (LPB_TST_Sonde_CPC), sur un point de contact ancien
   donc hors du blocage general : les 8 autres champs passent, l'ajout du seul
   BusinessBrandId fait echouer, avec EFAP (1BUAW0000000QNX4A2) comme avec
   BRASSART (1BUAW0000000QNY4A2), et que GDPR_Status__c soit present ou non.
   Ni la valeur ni une combinaison : le champ.

   Le drapeau plutot que la suppression, parce que le besoin RGPD reste entier
   et que la cause est un changement d'org, pas une decision de conception. Le
   jour ou la sonde redit que le champ passe, un mot suffit a le remettre.
   Sans lui, la marque reste deductible du compte parent. */
/* ---- DATE DU DERNIER ENGAGEMENT MARKETING ---------------------------------
   Ecrite a la CREATION du consentement, dans les DEUX champs qui portent ce
   nom sur l'objet :
   - `Last_Marketing_Engagement_Date__c` (underscores) : passe et se relit
     (test.correction.rgdp2, 10/09), mais N'EST PAS sur la page de l'objet ;
   - `LastMarketingEngagementDate__c` (CamelCase) : celui de la page « Derniere
     date d'engagement marketing », designe par la MOA. Ignore EN SILENCE a la
     creation tant que le permission set « MC Connect - Date d'engagement
     marketing » (cree le 08/09, ouvre lecture+ecriture) n'est pas ASSIGNE au
     user MC Connect — et sans ce droit, l'envoyer TUE la creation (10/09 13:09).
     Assigne par anouar le 10/09 : depuis, les deux partent.
   Ouvert le 10/09 sur le mot de l'equipe CRM (« plus de soucis »).

   HISTORIQUE, a connaitre avant d'y toucher :
   - 02/09 : le socle ecrivait `Last_Marketing_Engagement_Date__c` (avec
     underscores), un AUTRE champ du meme objet, lisible, qui porte encore ces
     34 consentements de test.
   - 03/09 : bascule sur la graphie CamelCase, alors refusee en lecture et sans
     droit d'ecriture → drapeau ferme. Plus rien n'etait ecrit, sur aucun
     formulaire, jusqu'au 10/09.
   - 10/09 : constate sur un consentement cree a 09:09:14 que le CRM pose
     lui-meme la date CamelCase 22 s plus tard (09:09:36) — une automatisation
     cote CRM alimente donc `LastMarketingEngagementDate__c` sans nous. Le
     socle ecrit l'AUTRE champ, celui avec underscores, que rien ne remplit
     sinon ; les deux graphies coexistent, la MOA devra en tuer une.

   ⚠ Un champ refuse a la creation fait echouer l'insert du consentement, donc
   perdre la preuve RGPD de la soumission entiere. Si une page meurt sur
   « 58 - avant consentement », c'est ICI qu'il faut revenir. Le drapeau reste
   pour pouvoir refermer en une ligne. Pas ecrit en MISE A JOUR d'un
   consentement existant : sur cet objet, un update refuse tue la page
   (mesure du 31/08), et rien ne prouve encore que ce champ passe en update. */
VAR @ECRIRE_DATE_ENGAGEMENT
SET @ECRIRE_DATE_ENGAGEMENT = "true"

VAR @ECRIRE_MARQUE_CONSENT
SET @ECRIRE_MARQUE_CONSENT = "true"

VAR @OBJET_INTERACTION, @RT_INTERACTION_FORM
SET @OBJET_INTERACTION   = "Interaction__c"
SET @RT_INTERACTION_FORM = "012AW00000AxdXSYAZ"
VAR @itPreview, @itContext, @itHorodatage, @itHorodatageUtc, @evtParent
VAR @refCanal, @refSous, @cle, @pos, @reste
VAR @detailOrigine, @nCpRows, @payload, @morceau, @morceauEncadre, @pz, @offset

VAR @LOG_ACTIF, @LOG_DETAIL, @runId, @logOrdre
SET @LOG_ACTIF = "true"
/* ---- NIVEAU DE JOURNAL ------------------------------------------------------
   Chaque ligne de journal est un InsertData, donc un aller-retour : 17 a 19
   par soumission, 2 a 4 s cumulees (mesure du 14/09). Les lignes « avant
   ... » (25, 28, 35, 58, 78, 79) et le « 50 - drapeau » ne servent qu'a
   localiser une page morte pendant un developpement : la derniere ligne
   ecrite suffit deja a nommer l'appel fautif. Elles ne sortent que si le
   drapeau SFMC_LOG_DETAIL vaut true a la publication (.env) ; les lignes de
   resultat (10, 20, 21, 26, 30, 40, 60, 70, 80, 99) et d'erreur restent
   toujours ecrites. */
SET @LOG_DETAIL = "%%ENV:SFMC_LOG_DETAIL%%"
SET @runId     = Substring(Replace(GUID(), "-", ""), 1, 12)
SET @logOrdre  = 0

/* ======================================================================
   DECLENCHEMENT DE JOURNEYS (API EVENT) — DRAPEAU ET ETAT COMMUN
   ----------------------------------------------------------------------
   Une fois les ecritures CRM terminees, le socle peut pousser la soumission
   dans une DE de Journey Builder via un API Event (POST interaction/v1/
   events) : c'est ce qui declenche les journeys de confirmation en temps
   reel. Le mecanisme est COMMUN : un formulaire qui veut alimenter une
   journey remplit trois variables, et le bloc de tir en fin de sequence
   fait le reste.
     @jrnCleEvt     nom de la ligne de LPB_Config_Api portant la cle de
                    l'evenement : EventKey_Evenement (inscription a un
                    evenement Summit), EventKey_Brochure (demande de brochure)
     @jrnContactKey ContactKey de l'entree (PersonContactId)
     @jrnData       corps JSON des colonnes de la DE, SANS les accolades
   Le TIR lui-meme est en SSJS, en fin de fichier : HTTPPost2 tue la page
   sur toute reponse 4xx malgre continueOnError (mesure du 10/09 sur le banc
   LPB_TST_Journey_V15), la ou HTTP.Post en SSJS se rattrape par try/catch.

   @JOURNEY_LAUNCH vient de la variable d'environnement SFMC_JOURNEY_LAUNCH,
   injectee A LA PUBLICATION (lib/socle-env.js) : une CloudPage n'a pas de
   process.env. Absente ou differente de « true » → rien ne part, et le
   journal porte JOURNEY:desactive. Les identifiants du paquet API vivent
   dans la DE LPB_Config_Api (Cle/Valeur), jamais dans les pages.
   ⚠ Un echec de l'appel ne bloque JAMAIS le visiteur : le CRM est deja
   ecrit, la confirmation s'affiche, et le journal dit ce qui a manque. */
VAR @JOURNEY_LAUNCH, @jrnCleEvt, @jrnContactKey, @jrnData
VAR @jrnRows, @jrnRow, @jrnTitre, @jrnCampusInst, @jrnDebut, @jrnFin, @jrnLangue, @jrnLocale, @jrnPays
VAR @jrnTel, @jrnMarque, @jrnTypeEvt, @jrnFn, @jrnLn, @jrnMail, @jrnCampus
VAR @jrnRefMarque, @jrnRefTypeEvt, @jrnRefNiveau, @jrnCle, @jrnPos, @jrnReste
VAR @jrnNiveau, @jrnTelBrut, @jrnTelE164, @jrnEcole, @jrnCampusUtm
VAR @jrnBrandCode, @jrnRefBrandCode
SET @JOURNEY_LAUNCH = "%%ENV:SFMC_JOURNEY_LAUNCH%%"
SET @jrnCleEvt      = ""
SET @jrnContactKey  = ""
SET @jrnData        = ""

SET @sfStatus   = ""
SET @sfErrorMsg = ""
SET @journal   = ""
SET @isNew     = "false"
SET @paId      = ""

SET @submitted = Lowercase(RequestParameter("submitted"))

/* CONTIENT "true", et non EGALE "true".
   Un formulaire peut poster le drapeau DEUX FOIS — le champ cache de la page
   plus une valeur ajoutee par le script d'envoi. RequestParameter rend alors
   "true,true", l'egalite echoue, et TOUT le bloc d'ecriture est saute : reponse
   avec un statut vide, aucune ligne de journal, et un message d'erreur qui
   accuse le CRM alors que rien ne lui a ete demande.
   Diagnostique le 31/08 en instrumentant le fetch d'une page publiee. La
   souplesse est ici preferable a la rigueur : le doublon est benin, le refus
   silencieux ne l'est pas. */
IF IndexOf(@submitted, "true") > 0 THEN

    /* ---- Lecture du formulaire (memes name[] que readForm() en SSJS) ---- */
    SET @email      = Trim(RequestParameter("EmailAddress"))
    SET @lastName   = RequestParameter("LastName")
    SET @firstName  = RequestParameter("FirstName")
    SET @country    = RequestParameter("Country")
    SET @indicatif  = RequestParameter("Indicatif")
    SET @mobile     = RequestParameter("MobilePhone")
    SET @studyLevel = RequestParameter("StudyLevel")
    SET @vousEtes   = RequestParameter("VousEtes")
    SET @ecole      = RequestParameter("Marque")
    SET @formType   = Lowercase(RequestParameter("TypeFormulaire"))

    /* ---- TYPE DE PROFIL EN CANDIDATURE : « Étudiant », D'OFFICE ------------
       Le formulaire de candidature n'a pas de champ « Vous êtes » : qui
       candidate est etudiant, la question ne se pose pas. Mais le flow CRM qui
       cree la candidature a besoin de PersonAccountType__c — vide, il ne cree
       rien. Retour du 07/09 : 67 comptes issus de candidatures sans type de
       profil, et autant de candidatures jamais creees.
       « Student » est la valeur d'API de « Étudiant » dans le value set
       (a distinguer de « EDH Student », l'etudiant deja inscrit dans une ecole
       du Groupe). Pose seulement si le formulaire n'a rien envoye : une page
       qui porterait un jour le champ garde la main. Un compte existant en
       « Parent » qui candidate passe donc en « Student » — c'est le sens de la
       demarche, et la regle « la derniere saisie fait foi » s'applique. */
    IF @formType == "candidature" AND Empty(@vousEtes) THEN
        SET @vousEtes = "Student"
    ENDIF

    SET @ptatId     = RequestParameter("PTAT_Id")
    SET @speciality = RequestParameter("Speciality")
    SET @campaignId = RequestParameter("CampaignId")
    SET @brandId    = RequestParameter("BusinessBrandId")
    SET @legalText  = RequestParameter("LegalTexteAccepted")
    SET @legalFooter = RequestParameter("LegalTexteFooter")

    SET @utmS   = RequestParameter("utm_source")
    SET @utmM   = RequestParameter("utm_medium")
    SET @utmC   = RequestParameter("utm_campaign")
    SET @utmCo  = RequestParameter("utm_content")
    SET @utmT   = RequestParameter("utm_term")
    SET @utmI   = RequestParameter("utm_id")
    SET @gclid  = RequestParameter("gclid")
    SET @fbclid = RequestParameter("fbclid")
    /* ⚠ La CloudPage pose le champ cache `client_id`, en snake_case comme tous
       les autres parametres de tracking. Le socle lisait `clientId` : les deux
       champs CRM seraient restes vides. On accepte les deux graphies, la
       nouvelle d'abord. */
    SET @clientId = RequestParameter("client_id")
    IF Empty(@clientId) THEN SET @clientId = RequestParameter("clientId") ENDIF
    SET @canal    = RequestParameter("canal")
    SET @sousCanal = RequestParameter("sous_canal")

    /* ---- CANAL D'ACQUISITION : JAMAIS UNE VALEUR INVENTEE ---------------
       Ces deux champs sont des PICKLISTS, et une valeur hors value set ne
       renvoie pas d'erreur : elle TUE LA PAGE. Sans try/catch, le compte reste
       cree et tout ce qui suit disparait — c'est exactement ce qui est arrive
       le 31/08, dès que la CloudPage a commence a fournir ces valeurs.

       La CloudPage a son propre vocabulaire, herite de sa table d'attribution :
       « Autre », « Referrals », « Paid Social », « FACEBOOK-ADS ». L'org, elle,
       propose 15 canaux et 12 sous-canaux, releves le 31/08, et AUCUN ne
       s'appelle Autre, Referrals ni Paid Social.

       On ne traduit donc que ce qui a un equivalent certain, et on laisse VIDE
       le reste. Un canal manquant se rattrape par une requete ; une page morte
       fait perdre la soumission entiere.

       AUDIT DU 04/09 — la table ne couvrait que ce qui portait le MEME nom des
       deux cotes : Emailing et Direct. Tout le reste du vocabulaire de la
       CloudPage etait ignore, alors que l'org a un equivalent evident :
       Search Organic -> SEO, Paid Search -> SEA, Social Organic -> SMO,
       Paid Social -> SMA. Cote sous-canal, le CRM a AJOUTE depuis le 31/08 les
       cinq sous-canaux emailing (Nurturing, Loyalty, Automatisation,
       Invitation, Newsletter) : la table d'ici ne les connaissait pas et les
       jetait au journal (SOUSCANAL:ignore). Les sous-canaux Google Ads sont
       rapproches quand l'org a la valeur : YouTube Ads ; « Paymax » est lu
       comme la coquille de PMAX (Performance Max) — aucun autre sens en regie.
       GOOGLE-ADS-SEARCH et GOOGLE-ADS-DEMANDGEN n'ont pas de valeur org.
       Restent sans equivalent, volontairement : Referrals (« Referral
       Partner » designe un prescripteur, pas un site referent), SMS, WhatsApp,
       AI, Autre — a trancher par le CRM, pas a deviner ici. */
    SET @refCanal = "|direct=Direct|display=Display|geo=GEO|sea=SEA|seo=SEO|smo=SMO|sma=SMA|press=Press|presse=Press|brochure=Brochure|digital audio=Digital Audio|email marketing=Email Marketing|emailing=Email Marketing|education fair=Education Fair|salon=Education Fair|high school forum=High School Forum|forum lycee=High School Forum|referral partner=Referral Partner|search organic=SEO|paid search=SEA|social organic=SMO|paid social=SMA|"
    SET @refSous  = "|tiktok ads=TikTok Ads|linkedin ads=LinkedIn Ads|digital audio=Digital Audio|display=Display|youtube ads=YouTube Ads|geo=GEO|instagram ads=Instagram Ads|snapchat ads=Snapchat Ads|wechat ads=WeChat Ads|line ads=Line Ads|facebook ads=Facebook Ads|paymax=Paymax|nurturing=Nurturing|loyalty=Loyalty|automatisation=Automatisation|invitation=Invitation|newsletter=Newsletter|google ads pmax=Paymax|google ads youtube=YouTube Ads|snap ads=Snapchat Ads|"

    /* AMPscript n'a pas de fonction utilisateur : le rapprochement est deroule
       deux fois. Cle normalisee — minuscules, tirets et soulignes en espaces —
       puis la valeur EXACTE de l'org est relue dans la table. */
    SET @cle = Replace(Replace(Lowercase(Trim(@canal)), "-", " "), "_", " ")
    SET @pos = IndexOf(@refCanal, Concat("|", @cle, "="))
    IF Empty(@canal) OR @pos == 0 THEN
        IF NOT Empty(@canal) THEN
            SET @journal = Concat(@journal, " CANAL:ignore(", @canal, ")")
        ENDIF
        SET @canal = ""
    ELSE
        SET @reste = Substring(@refCanal, Add(Add(@pos, Length(@cle)), 2))
        SET @canal = Substring(@reste, 1, Subtract(IndexOf(@reste, "|"), 1))
    ENDIF

    SET @cle = Replace(Replace(Lowercase(Trim(@sousCanal)), "-", " "), "_", " ")
    SET @pos = IndexOf(@refSous, Concat("|", @cle, "="))
    IF Empty(@sousCanal) OR @pos == 0 THEN
        IF NOT Empty(@sousCanal) THEN
            SET @journal = Concat(@journal, " SOUSCANAL:ignore(", @sousCanal, ")")
        ENDIF
        SET @sousCanal = ""
    ELSE
        SET @reste = Substring(@refSous, Add(Add(@pos, Length(@cle)), 2))
        SET @sousCanal = Substring(@reste, 1, Subtract(IndexOf(@reste, "|"), 1))
    ENDIF

    /* ---- FOURNIS PAR LA CLOUDPAGE, PAS PAR LE VISITEUR -------------------
       content-block-viewer.html lit l'URL, deduit le canal d'acquisition depuis
       une table d'attribution (utm_source x utm_medium), lit le consentement
       cookies depuis Axeptio, puis expose le tout en variables AMPscript. La
       landing page n'a qu'a poser les champs caches correspondants.

       `campus` sert deux fois : resolution de Ecole__c (via LPB_Mapping_Campus)
       et tracage dans Account.UTMCampus__c. Ce ne sont pas les memes donnees
       — l'un est un rattachement CRM, l'autre une origine de trafic — mais la
       CloudPage ne fournit qu'une valeur. */
    SET @utmCampus = RequestParameter("utm_campus")
    IF Empty(@utmCampus) THEN SET @utmCampus = @campusSel ENDIF
    SET @consent   = RequestParameter("consent")
    SET @dateCookies = RequestParameter("date_consentement_cookies")

    /* Marque et Account ecole depuis la DE de correspondance, jamais en dur. */
    IF Empty(@brandId) AND NOT Empty(@ecole) THEN
        SET @brandId = Lookup("LPB_Mapping_Ecoles", "BusinessBrandId", "Ecole", @ecole)
    ENDIF
    /* ---- COMPTE ECOLE : DEPUIS LA DE, INDEXEE PAR CAMPUS -----------------
       `Ecole__c` est un lookup vers un Account de RecordType `schoolEntity`.
       La granularite reelle est le CAMPUS, pas l'ecole : sur les comptes deja
       renseignes, `Ecole__c` pointe vers « BRASSART PARIS », pas « BRASSART ».
       Le champ `Campus__c` existe aussi mais reste vide sur les 24 comptes
       concernes — il n'est pas utilise.

       Pourquoi une DE et pas une resolution par nom. Le nom du campus envoye
       par la cascade (« EFAP PARIS ») est bien le `Name` du compte ecole, et
       filtrer dessus fonctionne pour les 10 campus EFAP. Mais TROIS comptes
       portent le nom « BRASSART PARIS », dont DEUX marques `EDH School` :
       aucun filtre ne peut trancher, et ecrire au hasard serait pire que ne
       rien ecrire. Le mapping est donc explicite.

       `LPB_Mapping_Campus` : cle = le libelle COMPLET du campus, tel que la
       cascade l'envoie. Une ligne par campus. Les cas ambigus y sont marques
       `Actif = false` avec les Ids concernes en commentaire, en attente
       d'arbitrage — plutot que resolus silencieusement.

       Si le campus est absent de la DE, `Ecole__c` reste vide : le prospect est
       cree sans ecole rattachee. Degrade, pas bloquant. */
    /* Le campus arrive sous `CampusChoisi`, un nom sans homonyme — voir
       `miroirCampus` dans le handler de listes. Repli sur `Campus` pour les
       pages publiees avant ce correctif. */
    SET @campusSel   = RequestParameter("CampusChoisi")
    IF Empty(@campusSel) THEN SET @campusSel = RequestParameter("Campus") ENDIF

    /* ⚠ REQUESTPARAMETER IGNORE LA CASSE ET FUSIONNE. Les formulaires portent
       DEUX champs nommes « campus » a la casse pres : le `<select name="Campus">`
       et un champ cache de tracking `name="campus"`, vide. AMPscript rend donc
       « EFAP PARIS, » — la valeur, une virgule, et le vide.

       Consequence, mesuree le 03/09 sur 141 soumissions reelles : la recherche
       dans LPB_Mapping_Campus echouait sur TOUTES, et `Ecole__c` restait vide
       partout. Le journal le disait depuis le debut — « campus=EFAP PARIS,
       ecoleAcc= » — mais la virgule se lisait comme une ponctuation.

       Mes essais par URL ne montraient rien : ils n'envoyaient que `Campus`.

       On ne garde donc que le premier segment. Aucun campus ne contient de
       virgule — verifie sur les 47 de la table. La correction de fond est de
       renommer le champ de tracking, mais cette garde protege les six
       formulaires sans toucher a leur code. */
    IF IndexOf(@campusSel, ",") > 0 THEN
        SET @campusSel = Trim(Substring(@campusSel, 1, Subtract(IndexOf(@campusSel, ","), 1)))
    ENDIF
    SET @schoolAccId = ""

    IF NOT Empty(@campusSel) THEN
        IF Lowercase(Lookup("LPB_Mapping_Campus", "Actif", "Campus", @campusSel)) == "true" THEN
            SET @schoolAccId = Lookup("LPB_Mapping_Campus", "SchoolAccountId", "Campus", @campusSel)
        ENDIF
    ENDIF

    /* ---- Resolution de la campagne, depuis la DE de mapping --------------
       40 combinaisons : brochure/candidature x FR/Intl x 10 ecoles. Les Ids
       sont propres a chaque org, donc jamais en dur : la DE est le point de
       bascule UAT -> Prod.

       La zone se deduit du PAYS DE RESIDENCE, pas de la langue de la page :
       un candidat marocain sur une LP francaise releve de la campagne Intl.

       Si le formulaire fournit deja un CampaignId, il gagne : cela permet a
       une LP de forcer une campagne specifique sans toucher au mapping. */
    IF Empty(@campaignId) AND NOT Empty(@ecole) THEN
        SET @zone = "Intl"
        IF Lowercase(Trim(@country)) == "france" THEN SET @zone = "FR" ENDIF

        SET @cleCampagne = Concat(@formType, "|", @ecole, "|", @zone)
        IF @LOG_ACTIF == "true" THEN
            SET @logOrdre = Add(@logOrdre, 1)
            InsertData("LPB_Log_Soumissions",
                "RowId", Concat(@runId, "-", @logOrdre),
                "RunId", @runId,
                "Ordre", @logOrdre,
                "Horodatage", Now(),
                "Etape", "10 - contexte lu",
                "Statut", "OK",
                "Objet", "-",
                "RecordId", "",
                "Detail", Concat("zone=", @zone, " marque=", @brandId, " campus=", @campusSel, " ecoleAcc=", @schoolAccId),
                "Email", @email,
                "Ecole", @ecole,
                "FormType", @formType)
        ENDIF
        SET @campActif   = Lookup("LPB_Mapping_Campagnes", "Actif", "Cle", @cleCampagne)

        /* Actif=false = Id non renseigne ou non verifie. On n'ecrit alors AUCUN
           CampaignMember : mieux vaut une adhesion manquante et tracee qu'une
           adhesion rattachee a la mauvaise campagne.

           DEUX cas tombent dans le ELSE, et il faut les distinguer au journal :
             - la ligne EXISTE mais Actif=false : campagne a verifier ;
             - la ligne N'EXISTE PAS : c'est le cas de tous les formulaires
               evenement. Le mapping ne couvre que brochure et candidature, 40
               lignes au contrat, et c'est voulu — une inscription a une JPO est
               tracee par sa Summit Registration.

           Ecrire « inactive » dans le second cas laissait croire a une campagne
           desactivee, donc a un incident. Il n'y en a pas. */
        IF Lowercase(@campActif) == "true" THEN
            SET @campaignId = Lookup("LPB_Mapping_Campagnes", "CampaignId", "Cle", @cleCampagne)
            SET @journal = Concat(@journal, " CAMP:", @cleCampagne)
            IF @LOG_ACTIF == "true" THEN
                SET @logOrdre = Add(@logOrdre, 1)
                InsertData("LPB_Log_Soumissions",
                    "RowId", Concat(@runId, "-", @logOrdre),
                    "RunId", @runId,
                    "Ordre", @logOrdre,
                    "Horodatage", Now(),
                    "Etape", "20 - campagne resolue",
                    "Statut", "OK",
                    "Objet", "Campaign",
                    "RecordId", @campaignId,
                    "Detail", @cleCampagne,
                    "Email", @email,
                    "Ecole", @ecole,
                    "FormType", @formType)
            ENDIF
        ELSEIF Empty(@campActif) THEN
            /* Aucune ligne pour cette cle : normal sur un formulaire evenement. */
            SET @journal = Concat(@journal, " CAMP:sans-objet(", @cleCampagne, ")")
            IF @LOG_ACTIF == "true" THEN
                SET @logOrdre = Add(@logOrdre, 1)
                InsertData("LPB_Log_Soumissions",
                    "RowId", Concat(@runId, "-", @logOrdre),
                    "RunId", @runId,
                    "Ordre", @logOrdre,
                    "Horodatage", Now(),
                    "Etape", "20 - aucune campagne prevue",
                    "Statut", "IGNORE",
                    "Objet", "Campaign",
                    "RecordId", "",
                    "Detail", @cleCampagne,
                    "Email", @email,
                    "Ecole", @ecole,
                    "FormType", @formType)
            ENDIF
        ELSE
            SET @journal = Concat(@journal, " CAMP:inactive(", @cleCampagne, ")")
            IF @LOG_ACTIF == "true" THEN
                SET @logOrdre = Add(@logOrdre, 1)
                InsertData("LPB_Log_Soumissions",
                    "RowId", Concat(@runId, "-", @logOrdre),
                    "RunId", @runId,
                    "Ordre", @logOrdre,
                    "Horodatage", Now(),
                    "Etape", "20 - campagne inactive",
                    "Statut", "IGNORE",
                    "Objet", "Campaign",
                    "RecordId", "",
                    "Detail", @cleCampagne,
                    "Email", @email,
                    "Ecole", @ecole,
                    "FormType", @formType)
            ENDIF
        ENDIF
    ENDIF

    /* ====================================================================
       ETAPE 0 — REGLES DE BLOCAGE CANDIDATURE
       ====================================================================
       Deux refus prevus au contrat, AVANT toute ecriture :
         R1 - doublon programme (Jira 1070/463) : une candidature est deja en
              cours pour ce couple (personne x PTAT) ;
         R2 - refus dans l'annee (Jira 464) : une decision defavorable a deja
              ete rendue sur le meme programme la meme annee scolaire.

       --- Pourquoi ce bloc a d'abord ete livre DESACTIVE ------------------
       AMPscript n'a pas de try/catch, et un nom d'objet ou de champ invalide
       ne renvoie pas une erreur rattrapable : il REMPLACE la page. Interroger
       l'objet de candidature avec un nom non verifie ferait donc mourir la
       page a CHAQUE soumission de candidature — panne totale, pas degradation.
       Il n'existe aucun moyen de coder defensivement autour de ca.

       Les trois noms utilises ici ont ete confrontes a l'org le 2026-08-23 et
       existent tous. C'est ce qui autorise @REGLES_ACTIVES a "true" : la
       lecture ne peut plus tuer la page. Cf. le bloc de configuration en tete
       de fichier pour le detail, dont le champ d'annee qui n'existait pas.

       --- Sens du defaut : on laisse passer -------------------------------
       Regle desactivee ou indeterminee = on N'EMPECHE PAS la soumission.
       Un doublon qui passe est rattrapable (le CRM dedoublonne, un admissions
       peut fusionner). Un candidat legitime bloque par erreur est un lead
       perdu, sans trace et sans recours. L'asymetrie tranche le defaut.
       ==================================================================== */
    /* ---- LA PORTEE DE LA REGLE, ET POURQUOI ELLE VARIE -----------------
       Le garde exigeait `NOT Empty(@ptatId)`, et c'etait LA CAUSE N.1 du faux
       vert. `PTAT_Id` est un champ cache rempli par le NAVIGATEUR, au terme de
       la cascade : il reste vide des que celle-ci ne reduit pas a un seul
       programme — plusieurs programmes encore en lice, ou programme deduit
       sans PTAT pour la rentree choisie. Ses PROPRES TESTS consacrent ces deux
       etats comme normaux (test-cascade.js). R1 et R2 etaient donc sautees en
       silence, la candidature s'ecrivait, et le visiteur lisait le VERT sans
       que rien n'ait ete verifie.

       Le terme est retire. La regle tourne desormais TOUJOURS sur une
       candidature, et c'est sa PORTEE qui s'adapte :

         ptat      le PTAT est resolu -> on filtre dessus. Le blocage reste
                   propre a UN programme, et changer de programme reste permis :
                   c'est l'identite meme d'une candidature (e-mail x programme),
                   et le PTAT porte deja l'annee scolaire — aucun critere
                   d'annee a ajouter, il serait redondant.

         personne  le PTAT est absent -> on retombe sur un controle par
                   PERSONNE. Plus severe : une candidature sur n'importe quel
                   programme bloque. Mais uniquement LA OU LE PROGRAMME EST
                   INCONNU, et l'alternative etait de ne rien controler du
                   tout. Un doublon qui passe est rattrapable ; une regle
                   muette ne se voit jamais.

       Les deux portees sont tracees au journal, y compris quand elles laissent
       passer : sans ca, « pourquoi celui-la est-il passe ? » n'a aucune
       reponse. C'est ce qui a coute des heures. */
    IF @REGLES_ACTIVES == "true" AND @formType == "candidature" THEN

        IF Empty(@ptatId) THEN
            SET @candPortee = "personne"
        ELSE
            SET @candPortee = "ptat"
        ENDIF
        IF @candPortee == "personne" THEN
            SET @journal = Concat(@journal, " REGLES:portee=personne(ptat-absent)")
        ENDIF

        /* Le lien vers la personne se fait par le Contact du Person Account.
           Sans compte existant, il ne peut y avoir de candidature anterieure :
           on ne lit rien. */
        SET @rows = RetrieveSalesforceObjects("Account", "Id,PersonContactId",
            "PersonEmail", "=", @email)

        IF RowCount(@rows) > 0 THEN
            SET @candContactId = Field(Row(@rows,1), "PersonContactId")

            /* Deux requetes et non une : AMPscript n'a pas de filtre
               conditionnel, l'arite de RetrieveSalesforceObjects est figee a
               l'ecriture. Passer @ptatId vide comme valeur de filtre ne
               chercherait pas « tous les PTAT » mais « le PTAT vide », donc
               zero ligne — la panne serait exactement celle qu'on repare. */
            IF @candPortee == "ptat" THEN
                SET @candRows = RetrieveSalesforceObjects(@OBJ_APPLICATION,
                    Concat("Id,", @F_APP_STATUS, ",", @F_APP_DECISION),
                    @F_APP_PERSON, "=", @candContactId,
                    @F_APP_PTAT,   "=", @ptatId)
            ELSE
                SET @candRows = RetrieveSalesforceObjects(@OBJ_APPLICATION,
                    Concat("Id,", @F_APP_STATUS, ",", @F_APP_DECISION),
                    @F_APP_PERSON, "=", @candContactId)
            ENDIF
            SET @nCand = RowCount(@candRows)

            IF @nCand > 0 THEN
                FOR @i = 1 TO @nCand DO
                    SET @candStatut   = Lowercase(Field(Row(@candRows,@i), @F_APP_STATUS))
                    SET @candDecision = Lowercase(Field(Row(@candRows,@i), @F_APP_DECISION))

                    IF @candDecision == @VAL_REFUSE OR @candStatut == @VAL_REFUSE THEN
                        /* R2 en premier : un refus est plus contraignant qu'un
                           dossier en cours, et son message differe. Sans
                           condition d'ecrasement, volontairement : un refus
                           REMPLACE un blocage R1 pose par une autre ligne. */
                        SET @sfStatus = "blocked"
                        SET @sfBlockRule = "r2"
                        SET @sfBlockMsg = "Votre précédente candidature à ce programme a fait l'objet d'une décision défavorable. Une nouvelle candidature au même programme n'est pas possible avant l'année prochaine. Pour toute question, veuillez contacter le service des admissions."
                    ELSEIF Empty(@sfBlockMsg) THEN
                        SET @sfStatus = "blocked"
                        SET @sfBlockRule = "r1"
                        SET @sfBlockMsg = "Vous avez déjà une candidature en cours pour ce programme. Nous vous invitons à contacter le service des admissions du campus auquel vous souhaitez candidater."
                    ENDIF
                NEXT @i
                IF @sfStatus == "blocked" THEN
                    SET @journal = Concat(@journal, " BLOQUE:", @nCand, "candidature(s)(portee=", @candPortee, ")")
                    /* ⚠ SANS CECI LE CANDIDAT NE VOIT RIEN DE JUSTE. Le
                       formulaire lit le commentaire « socle erreur: » et en
                       fait son message (shared/envoi-socle.js, puis alert).
                       Faute de le renseigner, un blocage rendait `ok:false`
                       avec un message VIDE, et le candidat recevait « Une
                       erreur est survenue, veuillez reessayer » — soit
                       exactement l'inverse de ce qu'il faut lui dire : il ne
                       doit PAS reessayer, il doit contacter les admissions. */
                    SET @sfErrorMsg = @sfBlockMsg
                    /* ⚠ SANS CETTE LIGNE, UN BLOCAGE NE LAISSE AUCUNE TRACE.
                       Tout ce qui suit — y compris « 99 - fin » — vit dans le
                       garde-fou `IF @sfStatus != "blocked"`. Le journal
                       s'arretait donc net apres « 20 - campagne resolue », et
                       une candidature legitimement bloquee etait indiscernable
                       d'une page morte entre l'etape 20 et l'etape 25. Le
                       marqueur BLOQUE: n'existait que dans le commentaire HTML
                       de la reponse, que personne ne conserve.
                       Constate le 01/09 sur une soumission reelle. */
                    IF @LOG_ACTIF == "true" THEN
                        SET @logOrdre = Add(@logOrdre, 1)
                        InsertData("LPB_Log_Soumissions",
                            "RowId", Concat(@runId, "-", @logOrdre),
                            "RunId", @runId,
                            "Ordre", @logOrdre,
                            "Horodatage", Now(),
                            "Etape", "21 - candidature bloquee",
                            "Statut", "BLOQUE",
                            "Objet", @OBJ_APPLICATION,
                            "RecordId", Field(Row(@candRows, 1), "Id"),
                            "Detail", Concat(@nCand, " candidature(s), portee=", @candPortee, ", ptat=", @ptatId, " - ", @sfBlockMsg),
                            "Email", @email,
                            "Ecole", @ecole,
                            "FormType", @formType)
                    ENDIF
                ENDIF
            ELSE
                /* ⚠ LA REGLE A TOURNE ET N'A RIEN TROUVE. Ce n'est pas la
                   meme chose que « la regle n'a pas tourne », et c'est ce que
                   rien ne disait jusqu'ici : le 2026-09-04, une candidature
                   ressortait en vert sur un e-mail deja candidat, les tests
                   etaient verts eux aussi, et le journal ne permettait pas de
                   distinguer laquelle des deux causes agissait.

                   Lire ceci veut dire : le compte a ete trouve, la regle a
                   tourne DANS LA PORTEE INDIQUEE, et le CRM ne porte aucune
                   candidature. En portee `ptat`, si le candidat en a pourtant
                   une, elle est sur un autre PTAT — donc une autre rentree ;
                   en portee `personne`, il n'en a aucune, nulle part.

                   ⚠ UN PASSAGE EN VERT SE JOURNALISE COMME UN BLOCAGE. Un
                   blocage laissait sa ligne dans LPB_Log_Soumissions ; un
                   passage, non — et c'est pourtant sur un passage qu'on est
                   interroge. « Pourquoi celui-la est-il passe ? » n'avait
                   aucune reponse, et les deux causes possibles se corrigent a
                   l'oppose l'une de l'autre. */
                SET @journal = Concat(@journal, " REGLES:aucune-candidature(ptat=", @ptatId, ",portee=", @candPortee, ")")
                IF @LOG_ACTIF == "true" THEN
                    SET @logOrdre = Add(@logOrdre, 1)
                    InsertData("LPB_Log_Soumissions",
                        "RowId", Concat(@runId, "-", @logOrdre),
                        "RunId", @runId,
                        "Ordre", @logOrdre,
                        "Horodatage", Now(),
                        "Etape", "21 - candidature libre",
                        "Statut", "OK",
                        "Objet", @OBJ_APPLICATION,
                        "RecordId", @candContactId,
                        "Detail", Concat("0 candidature, portee=", @candPortee, ", ptat=", @ptatId),
                        "Email", @email,
                        "Ecole", @ecole,
                        "FormType", @formType)
                ENDIF
            ENDIF
        ELSE
            /* L'e-mail n'est porte par AUCUN Person Account, et la regle est
               donc MUETTE — y compris pour un candidat que le CRM connait par
               un autre canal. Le filtre porte sur `Account.PersonEmail` : un
               compte importe dont l'adresse ne vit que sur ContactPointEmail
               est invisible ici. A verifier AVANT de conclure que la regle
               est cassee.

               Journalise pour la meme raison que le cas ci-dessus : c'est une
               issue VERTE, et elle ne se corrige pas comme les autres. */
            SET @journal = Concat(@journal, " REGLES:email-inconnu(portee=", @candPortee, ")")
            IF @LOG_ACTIF == "true" THEN
                SET @logOrdre = Add(@logOrdre, 1)
                InsertData("LPB_Log_Soumissions",
                    "RowId", Concat(@runId, "-", @logOrdre),
                    "RunId", @runId,
                    "Ordre", @logOrdre,
                    "Horodatage", Now(),
                    "Etape", "21 - aucun compte",
                    "Statut", "OK",
                    "Objet", "Account",
                    "RecordId", "",
                    "Detail", Concat("aucun Account.PersonEmail, portee=", @candPortee, ", ptat=", @ptatId),
                    "Email", @email,
                    "Ecole", @ecole,
                    "FormType", @formType)
            ENDIF
        ENDIF
    ENDIF

    /* Un blocage arrete TOUT : ni compte, ni consentement, ni campagne. Le
       candidat doit passer par les admissions, pas alimenter un doublon. */
    IF @sfStatus != "blocked" THEN
    /* ====================================================================
       ETAPE 1 — PERSON ACCOUNT, upsert sur PersonEmail
       Pas d'email = pas de dedoublonnage possible = on n'ecrit rien. C'est la
       regle du contrat, et elle protege d'une explosion de doublons.
       ==================================================================== */
    /* Format : ce que Salesforce exige, ni plus ni moins — une extension
       d'au moins deux lettres, pas d'espace. Un e-mail qu'il refuse TUE la
       page au CreateSalesforceObject : le visiteur voyait une erreur generique
       et rien n'etait ecrit (retour du 06/09). Le socle JS fait le meme test
       avant l'envoi ; ceci est le filet pour un POST sans JS. */
    SET @emailInvalide = "false"
    IF NOT Empty(@email) AND Empty(RegExMatch(@email, "^[^\s@]+@[^\s@]+\.[A-Za-z]{2,}$", 0)) THEN
        SET @emailInvalide = "true"
    ENDIF

    IF Empty(@email) OR @emailInvalide == "true" THEN
        SET @sfStatus = "error"
        IF @emailInvalide == "true" THEN
            SET @sfErrorMsg = "Adresse e-mail invalide : verifiez le format (exemple : prenom.nom@domaine.fr)."
        ELSE
            SET @sfErrorMsg = "Adresse e-mail absente : aucune ecriture possible (cle de dedoublonnage)."
        ENDIF
        IF @LOG_ACTIF == "true" THEN
            SET @logOrdre = Add(@logOrdre, 1)
            InsertData("LPB_Log_Soumissions",
                "RowId", Concat(@runId, "-", @logOrdre),
                "RunId", @runId,
                "Ordre", @logOrdre,
                "Horodatage", Now(),
                "Etape", "05 - email absent ou invalide",
                "Statut", "KO",
                "Objet", "-",
                "RecordId", "",
                "Detail", @sfErrorMsg,
                "Email", @email,
                "Ecole", @ecole,
                "FormType", @formType)
        ENDIF
    ELSE

        IF @LOG_ACTIF == "true" AND @LOG_DETAIL == "true" THEN
            SET @logOrdre = Add(@logOrdre, 1)
            InsertData("LPB_Log_Soumissions",
                "RowId", Concat(@runId, "-", @logOrdre),
                "RunId", @runId,
                "Ordre", @logOrdre,
                "Horodatage", Now(),
                "Etape", "25 - avant lecture Account",
                "Statut", "OK",
                "Objet", "Account",
                "RecordId", "",
                "Detail", "RetrieveSalesforceObjects va etre appele",
                "Email", @email,
                "Ecole", @ecole,
                "FormType", @formType)
        ENDIF
        SET @rows = RetrieveSalesforceObjects("Account",
            "Id,PersonContactId,LastName,FirstName,LivingCountry__c,IndicatifPick__c,MobileNumber__c,Academic_Level_List__c,PersonAccountType__c,Ecole__c,UTMSource__c,UTMMedium__c,UTMCampaign__c,UTMContent__c,UTMTerm__c,UTMId__c,UTMCampus__c,gclid__c,fbclid__c,ClientID__c,Consent__c,DateConsentementCookies__c,AcquisitionChannel__c,AcquisitionSubChannel__c,CreationSourceDate__c,CreationSourceDetail__c,DateOfLastMarketingContactPoint__c,LastMarketingContactPointType__c,Speciality__c",
            "PersonEmail", "=", @email)
        SET @n = RowCount(@rows)
        IF @LOG_ACTIF == "true" THEN
            SET @logOrdre = Add(@logOrdre, 1)
            InsertData("LPB_Log_Soumissions",
                "RowId", Concat(@runId, "-", @logOrdre),
                "RunId", @runId,
                "Ordre", @logOrdre,
                "Horodatage", Now(),
                "Etape", "26 - lecture Account OK",
                "Statut", "OK",
                "Objet", "Account",
                "RecordId", "",
                "Detail", Concat("lignes trouvees=", @n),
                "Email", @email,
                "Ecole", @ecole,
                "FormType", @formType)
        ENDIF

        /* ====================================================================
           VALEURS COMMUNES AUX DEUX BRANCHES — calculees UNE fois
           ====================================================================
           Refonte du 13/09 (retour anouar) : le socle ecrivait le compte en
           42 appels d'un champ, un update par champ qui differait. Chaque
           appel etait un aller-retour Salesforce ET un passage complet des
           triggers et flows du compte — dont AcademicInterestRequestService,
           qui depose ou rearme un tampon d'interet academique a CHAQUE update
           ou PTAT_Id__c, Ecole__c, LearningProgram_Id__c ou Speciality__c
           change. Ecrire PTAT, ecole et specialite en trois appels separes,
           c'etait trois passages du tampon pour une seule soumission.
           Desormais : UN CreateSalesforceObject pour un compte neuf, UN
           UpdateSingleSalesforceObject pour un compte connu. Ce qui suit
           prepare les valeurs que les deux chemins partagent. */
        SET @itHorodatage    = Format(Now(), "yyyy-MM-dd HH:mm:ss")
        SET @itHorodatageUtc = Concat(Substring(FormatDate(DateAdd(Now(), 6, "H"), "iso"), 1, 19), "Z")

        /* Origine de creation : sans elle, l'org REFUSE le consentement qui
           suit (mesure du 29/08). Le formulaire fournit NomFormulaire ; le
           repli n'est pas decoratif, on prefere une origine approximative a
           une preuve RGPD absente. */
        SET @detailOrigine = RequestParameter("NomFormulaire")
        IF Empty(@detailOrigine) THEN SET @detailOrigine = Concat("Formulaire ", @formType) ENDIF

        /* Consentement cookies (Axeptio, lu par la CloudPage) : "1"/"0" vers
           une case a cocher. Vide = on ne sait pas = on ne touche pas. */
        SET @consentVoulu = ""
        IF NOT Empty(@consent) THEN
            IF @consent == "1" OR Lowercase(@consent) == "true" THEN
                SET @consentVoulu = "true"
            ELSE
                SET @consentVoulu = "false"
            ENDIF
        ENDIF

        /* Drapeau candidature : pose a CHAQUE soumission, y compris a false.
           Le trigger ne le remet plus a false ; sans nous, un contact ayant
           candidate une fois resterait candidat pour toujours. */
        SET @appRequested = "false"
        SET @ptatMaj = ""
        IF @formType == "candidature" THEN
            SET @appRequested = "true"
            /* Le PTAT est la SEULE trace de la rentree choisie. Ecrit dans le
               MEME appel que le reste : le trigger le consomme (depot du tampon
               puis remise a vide), le relire juste apres ne prouve rien. */
            SET @ptatMaj = @ptatId
            IF Empty(@ptatId) THEN
                SET @journal = Concat(@journal, " PTAT:absent(rentree-perdue)")
            ELSE
                SET @journal = Concat(@journal, " PTAT:", @ptatId)
            ENDIF
        ENDIF

        /* Specialite (« programme souhaite ») : picklist, et une valeur hors
           value set TUE la page. On ne fait pas confiance au POST : un
           programme doit reellement porter cette specialite. */
        SET @specialiteOk = ""
        IF NOT Empty(@speciality) THEN
            SET @specRows = RetrieveSalesforceObjects("LearningProgram", "Id",
                "Speciality__c", "=", @speciality)
            IF RowCount(@specRows) > 0 THEN
                SET @specialiteOk = @speciality
                SET @journal = Concat(@journal, " SPEC:", @speciality)
            ELSE
                SET @journal = Concat(@journal, " SPEC:ignore(", @speciality, ")")
            ENDIF
        ENDIF

        IF @n > 0 THEN
            SET @row = Row(@rows, 1)
            SET @paId = Field(@row, "Id")
            SET @paContactId = Field(@row, "PersonContactId")
            IF @LOG_ACTIF == "true" THEN
                SET @logOrdre = Add(@logOrdre, 1)
                InsertData("LPB_Log_Soumissions",
                    "RowId", Concat(@runId, "-", @logOrdre),
                    "RunId", @runId,
                    "Ordre", @logOrdre,
                    "Horodatage", Now(),
                    "Etape", "30 - account existant",
                    "Statut", "OK",
                    "Objet", "Account",
                    "RecordId", @paId,
                    "Detail", Concat("contact=", @paContactId),
                    "Email", @email,
                    "Ecole", @ecole,
                    "FormType", @formType)
            ENDIF

            /* --- MISE A JOUR DU COMPTE : UN SEUL APPEL --------------------
               Ce que le prospect SAISIT fait foi (regle du 04/09) : chaque
               soumission met le compte a jour, identite, declaratif et
               tracking en last-touch. Pour chaque champ : la valeur du
               formulaire si elle existe, sinon la valeur CRM relue — envoyer
               la meme valeur ne change rien et ne declenche rien, et c'est
               ce qui permet UNE liste d'arguments fixe la ou AMPscript ne
               sait pas la construire a la volee.

               Ce qui N'EST PAS dans l'appel, et pourquoi :
               - AcquisitionChannel__c / AcquisitionSubChannel__c : le CRM en
                 est desormais la SEULE source (recommandation du 15/09). Le
                 trigger AccountAcquisitionChannelService les calcule a partir
                 des UTM a la creation, et lockOnUpdate (GCRM-912) refuse tout
                 changement ensuite. Le socle ne les envoie plus, ni a la
                 creation ni a la mise a jour ; un ecart eventuel entre le
                 canal du formulaire et celui du CRM est seulement journalise
                 (CANAL:verrouille-crm), jamais ecrit.
               - DateConsentementCookies__c : champ date dont on n'a jamais vu
                 de valeur reelle d'Axeptio ; la valeur CRM relue est rendue
                 dans un format que le connecteur refuse en ecriture. Appel a
                 part, seulement quand le formulaire en porte une.
               - CreationSourceDate__c : alimente par le CRM, refuse nos ecrits.
               - SMSLocale__c / WhatsAppLocale__c : calcules par le trigger,
                 verrouilles.
               - CreationSourceDetail__c : fill-if-blank, il nomme la source de
                 CREATION.
               - PTAT_Id__c : seulement en candidature — le trigger le consomme
                 et le remet a vide, l'echo de la valeur CRM (vide) ne veut
                 rien dire hors candidature. D'ou les deux variantes de l'appel.

               Identite : @ECRIRE_IDENTITE et @IDENTITE_SUR_CONTACT (en tete de
               fichier) gardent leur sens — nom et prenom ne partent sur
               Account que si le premier est ouvert et le second ferme. */
            SET @champsMaj = ""
            SET @vLast  = Field(@row, "LastName")
            SET @vFirst = Field(@row, "FirstName")
            IF @ECRIRE_IDENTITE == "true" AND @IDENTITE_SUR_CONTACT != "true" THEN
                IF NOT Empty(@lastName)  AND @vLast  != @lastName  THEN SET @vLast  = @lastName  SET @champsMaj = Concat(@champsMaj, " LastName") ENDIF
                IF NOT Empty(@firstName) AND @vFirst != @firstName THEN SET @vFirst = @firstName SET @champsMaj = Concat(@champsMaj, " FirstName") ENDIF
            ELSEIF @ECRIRE_IDENTITE == "true" AND @IDENTITE_SUR_CONTACT == "true" AND NOT Empty(@paContactId) THEN
                /* Variante historique : l'identite vit sur le Contact. */
                IF NOT Empty(@lastName)  AND @vLast  != @lastName  THEN SET @n = UpdateSingleSalesforceObject("Contact", @paContactId, "LastName", @lastName) ENDIF
                IF NOT Empty(@firstName) AND @vFirst != @firstName THEN SET @n = UpdateSingleSalesforceObject("Contact", @paContactId, "FirstName", @firstName) ENDIF
            ELSE
                IF NOT Empty(@lastName) AND @vLast != @lastName THEN SET @journal = Concat(@journal, " IDENT:LastName-ignore") ENDIF
            ENDIF

            SET @vPays   = Field(@row, "LivingCountry__c")
            IF NOT Empty(@country)    AND @vPays   != @country    THEN SET @vPays   = @country    SET @champsMaj = Concat(@champsMaj, " LivingCountry__c") ENDIF
            SET @vIndic  = Field(@row, "IndicatifPick__c")
            IF NOT Empty(@indicatif)  AND @vIndic  != @indicatif  THEN SET @vIndic  = @indicatif  SET @champsMaj = Concat(@champsMaj, " IndicatifPick__c") ENDIF
            /* MobileNumber__c et JAMAIS PersonMobilePhone : l'E.164 est calcule
               par un flow, l'ecrire ici le ferait diverger. */
            SET @vMobile = Field(@row, "MobileNumber__c")
            IF NOT Empty(@mobile)     AND @vMobile != @mobile     THEN SET @vMobile = @mobile     SET @champsMaj = Concat(@champsMaj, " MobileNumber__c") ENDIF
            SET @vNiveau = Field(@row, "Academic_Level_List__c")
            IF NOT Empty(@studyLevel) AND @vNiveau != @studyLevel THEN SET @vNiveau = @studyLevel SET @champsMaj = Concat(@champsMaj, " Academic_Level_List__c") ENDIF
            SET @vType   = Field(@row, "PersonAccountType__c")
            IF NOT Empty(@vousEtes)   AND @vType   != @vousEtes   THEN SET @vType   = @vousEtes   SET @champsMaj = Concat(@champsMaj, " PersonAccountType__c") ENDIF
            /* Ecole__c est un LOOKUP (Id du compte ecole). Upsert depuis le
               04/09 : l'ecole du dernier formulaire gagne. C'est aussi l'un des
               signaux du tampon d'interet academique : son changement depose,
               c'est voulu. */
            SET @vEcole  = Field(@row, "Ecole__c")
            IF NOT Empty(@schoolAccId) AND @vEcole != @schoolAccId THEN SET @vEcole = @schoolAccId SET @champsMaj = Concat(@champsMaj, " Ecole__c") ENDIF

            /* Tracking en LAST-TOUCH (04/09) : la derniere visite fait foi.
               ⚠ L'origine PREMIERE n'est conservee nulle part — arbitrage
               d'attribution assume ; le first-touch demanderait des champs
               dedies cote CRM. */
            SET @vUtmS      = Field(@row, "UTMSource__c")
            IF NOT Empty(@utmS)      AND @vUtmS      != @utmS      THEN SET @vUtmS      = @utmS      SET @champsMaj = Concat(@champsMaj, " UTMSource__c") ENDIF
            SET @vUtmM      = Field(@row, "UTMMedium__c")
            IF NOT Empty(@utmM)      AND @vUtmM      != @utmM      THEN SET @vUtmM      = @utmM      SET @champsMaj = Concat(@champsMaj, " UTMMedium__c") ENDIF
            SET @vUtmC      = Field(@row, "UTMCampaign__c")
            IF NOT Empty(@utmC)      AND @vUtmC      != @utmC      THEN SET @vUtmC      = @utmC      SET @champsMaj = Concat(@champsMaj, " UTMCampaign__c") ENDIF
            SET @vUtmCo     = Field(@row, "UTMContent__c")
            IF NOT Empty(@utmCo)     AND @vUtmCo     != @utmCo     THEN SET @vUtmCo     = @utmCo     SET @champsMaj = Concat(@champsMaj, " UTMContent__c") ENDIF
            SET @vUtmT      = Field(@row, "UTMTerm__c")
            IF NOT Empty(@utmT)      AND @vUtmT      != @utmT      THEN SET @vUtmT      = @utmT      SET @champsMaj = Concat(@champsMaj, " UTMTerm__c") ENDIF
            SET @vUtmI      = Field(@row, "UTMId__c")
            IF NOT Empty(@utmI)      AND @vUtmI      != @utmI      THEN SET @vUtmI      = @utmI      SET @champsMaj = Concat(@champsMaj, " UTMId__c") ENDIF
            SET @vUtmCampus = Field(@row, "UTMCampus__c")
            IF NOT Empty(@utmCampus) AND @vUtmCampus != @utmCampus THEN SET @vUtmCampus = @utmCampus SET @champsMaj = Concat(@champsMaj, " UTMCampus__c") ENDIF
            SET @vGclid     = Field(@row, "gclid__c")
            IF NOT Empty(@gclid)     AND @vGclid     != @gclid     THEN SET @vGclid     = @gclid     SET @champsMaj = Concat(@champsMaj, " gclid__c") ENDIF
            SET @vFbclid    = Field(@row, "fbclid__c")
            IF NOT Empty(@fbclid)    AND @vFbclid    != @fbclid    THEN SET @vFbclid    = @fbclid    SET @champsMaj = Concat(@champsMaj, " fbclid__c") ENDIF
            SET @vClient    = Field(@row, "ClientID__c")
            IF NOT Empty(@clientId)  AND @vClient    != @clientId  THEN SET @vClient    = @clientId  SET @champsMaj = Concat(@champsMaj, " ClientID__c") ENDIF
            IF NOT Empty(@canal) AND Field(@row, "AcquisitionChannel__c") != @canal THEN
                SET @journal = Concat(@journal, " CANAL:verrouille-crm(", @canal, ")")
            ENDIF

            SET @vConsent = Lowercase(Field(@row, "Consent__c"))
            IF NOT Empty(@consentVoulu) AND @vConsent != @consentVoulu THEN SET @vConsent = @consentVoulu SET @champsMaj = Concat(@champsMaj, " Consent__c") ENDIF
            IF Empty(@vConsent) THEN SET @vConsent = "false" ENDIF
            SET @vDetail = Field(@row, "CreationSourceDetail__c")
            IF Empty(@vDetail) THEN SET @vDetail = @detailOrigine SET @champsMaj = Concat(@champsMaj, " CreationSourceDetail__c") ENDIF
            SET @vSpec = Field(@row, "Speciality__c")
            IF NOT Empty(@specialiteOk) AND @vSpec != @specialiteOk THEN SET @vSpec = @specialiteOk SET @champsMaj = Concat(@champsMaj, " Speciality__c") ENDIF

            IF @LOG_ACTIF == "true" AND @LOG_DETAIL == "true" THEN
                SET @logOrdre = Add(@logOrdre, 1)
                InsertData("LPB_Log_Soumissions",
                    "RowId", Concat(@runId, "-", @logOrdre),
                    "RunId", @runId,
                    "Ordre", @logOrdre,
                    "Horodatage", Now(),
                    "Etape", "35 - avant maj compte",
                    "Statut", "OK",
                    "Objet", "Account",
                    "RecordId", @paId,
                    "Detail", Concat("un seul update ; champs modifies :", IIF(Empty(@champsMaj), " aucun", @champsMaj), " ; candidature=", @appRequested, IIF(Empty(@ptatMaj), "", Concat(" ptat=", @ptatMaj))),
                    "Email", @email,
                    "Ecole", @ecole,
                    "FormType", @formType)
            ENDIF

            /* Dernier point de contact marketing : rafraichi a chaque
               soumission, c'est sa raison d'etre. LastMarketingContactPointType__c
               attend un CANAL ("Form"), pas un type de formulaire. */
            IF NOT Empty(@ptatMaj) THEN
                SET @n = UpdateSingleSalesforceObject("Account", @paId,
                    "LastName",                 @vLast,
                    "FirstName",                @vFirst,
                    "LivingCountry__c",         @vPays,
                    "IndicatifPick__c",         @vIndic,
                    "MobileNumber__c",          @vMobile,
                    "Academic_Level_List__c",   @vNiveau,
                    "PersonAccountType__c",     @vType,
                    "Ecole__c",                 @vEcole,
                    "UTMSource__c",             @vUtmS,
                    "UTMMedium__c",             @vUtmM,
                    "UTMCampaign__c",           @vUtmC,
                    "UTMContent__c",            @vUtmCo,
                    "UTMTerm__c",               @vUtmT,
                    "UTMId__c",                 @vUtmI,
                    "UTMCampus__c",             @vUtmCampus,
                    "gclid__c",                 @vGclid,
                    "fbclid__c",                @vFbclid,
                    "ClientID__c",              @vClient,
                    "Consent__c",               @vConsent,
                    "CreationSourceDetail__c",  @vDetail,
                    "Speciality__c",            @vSpec,
                    "Application_Requested__c", @appRequested,
                    "PTAT_Id__c",               @ptatMaj,
                    "DateOfLastMarketingContactPoint__c", @itHorodatage,
                    "LastMarketingContactPointType__c",   "Form")
            ELSE
                SET @n = UpdateSingleSalesforceObject("Account", @paId,
                    "LastName",                 @vLast,
                    "FirstName",                @vFirst,
                    "LivingCountry__c",         @vPays,
                    "IndicatifPick__c",         @vIndic,
                    "MobileNumber__c",          @vMobile,
                    "Academic_Level_List__c",   @vNiveau,
                    "PersonAccountType__c",     @vType,
                    "Ecole__c",                 @vEcole,
                    "UTMSource__c",             @vUtmS,
                    "UTMMedium__c",             @vUtmM,
                    "UTMCampaign__c",           @vUtmC,
                    "UTMContent__c",            @vUtmCo,
                    "UTMTerm__c",               @vUtmT,
                    "UTMId__c",                 @vUtmI,
                    "UTMCampus__c",             @vUtmCampus,
                    "gclid__c",                 @vGclid,
                    "fbclid__c",                @vFbclid,
                    "ClientID__c",              @vClient,
                    "Consent__c",               @vConsent,
                    "CreationSourceDetail__c",  @vDetail,
                    "Speciality__c",            @vSpec,
                    "Application_Requested__c", @appRequested,
                    "DateOfLastMarketingContactPoint__c", @itHorodatage,
                    "LastMarketingContactPointType__c",   "Form")
            ENDIF
            /* Consentement cookies date : a part, et seulement si le
               formulaire en porte une (voir ci-dessus). */
            IF NOT Empty(@dateCookies) AND Field(@row, "DateConsentementCookies__c") != @dateCookies THEN
                SET @n = UpdateSingleSalesforceObject("Account", @paId, "DateConsentementCookies__c", @dateCookies)
            ENDIF
            IF @LOG_ACTIF == "true" THEN
                SET @logOrdre = Add(@logOrdre, 1)
                InsertData("LPB_Log_Soumissions",
                    "RowId", Concat(@runId, "-", @logOrdre),
                    "RunId", @runId,
                    "Ordre", @logOrdre,
                    "Horodatage", Now(),
                    "Etape", "40 - maj compte terminee",
                    "Statut", "OK",
                    "Objet", "Account",
                    "RecordId", @paId,
                    "Detail", "l update unique a passe",
                    "Email", @email,
                    "Ecole", @ecole,
                    "FormType", @formType)
            ENDIF

        ELSEIF Empty(@RT_PERSON_ACCOUNT) THEN
            /* Garde-fou : creer sans RecordType produirait un compte ENTREPRISE. */
            SET @sfStatus = "error"
            SET @sfErrorMsg = "RecordTypeId du Person Account non renseigne : creation bloquee. Renseigner @RT_PERSON_ACCOUNT."
            IF @LOG_ACTIF == "true" THEN
                SET @logOrdre = Add(@logOrdre, 1)
                InsertData("LPB_Log_Soumissions",
                    "RowId", Concat(@runId, "-", @logOrdre),
                    "RunId", @runId,
                    "Ordre", @logOrdre,
                    "Horodatage", Now(),
                    "Etape", "30 - creation bloquee",
                    "Statut", "KO",
                    "Objet", "Account",
                    "RecordId", "",
                    "Detail", @sfErrorMsg,
                    "Email", @email,
                    "Ecole", @ecole,
                    "FormType", @formType)
            ENDIF
        ELSE
            IF @LOG_ACTIF == "true" AND @LOG_DETAIL == "true" THEN
                SET @logOrdre = Add(@logOrdre, 1)
                InsertData("LPB_Log_Soumissions",
                    "RowId", Concat(@runId, "-", @logOrdre),
                    "RunId", @runId,
                    "Ordre", @logOrdre,
                    "Horodatage", Now(),
                    "Etape", "28 - avant creation Account",
                    "Statut", "OK",
                    "Objet", "Account",
                    "RecordId", "",
                    "Detail", Concat("mode=", RequestParameter("TestCreateMode"), " RT=", @RT_PERSON_ACCOUNT, " nom=", @lastName, " niveau=", @studyLevel, " indicatif=", @indicatif, " type=", @vousEtes),
                    "Email", @email,
                    "Ecole", @ecole,
                    "FormType", @formType)
            ENDIF
            /* ---- CREATION DU PERSON ACCOUNT ----------------------------
               Le jeu de champs ci-dessous n'est pas negociable : il est dicte
               par les validation rules de l'org, relevees dans les journaux
               Apex du 2026-08-23.

                 VR_PersonAccount_NameMandatory
                     exige FirstName ET LastName ET un moyen de contact
                     (PersonEmail, Invalid_Email__c, PersonMobilePhone ou Phone).
                     -> FirstName est OBLIGATOIRE. Sans lui la page meurt.

                 VR_PersonAccount_PreferredLanguageRequir
                     exige PreferredLangage__c des que LivingCountry__c
                     n'est pas France. Exemptions : SourceCreation__c a
                     "Import" ou "API".
                     -> hors France, on renseigne la langue.

                 VR_PersonAccount_FormTypeRestricted
                     des que FormType__c est rempli, SourceCreation__c DOIT
                     valoir "Web Form".
                     -> SourceCreation__c est fixe a "Web Form".

               Verifie sur l'org : creation OK en France (001AW00001yrOIrYAM)
               et hors France avec langue (001AW00001yrM96YAE).

               ⚠ FormType__c = "Formulaire de Candidature" est REFUSE, alors
               que "Demande de doc" passe : une regle supplementaire, non
               identifiee, s'applique aux candidatures. On n'envoie donc pas
               FormType__c pour ce type de formulaire — le reste de la
               sequence (Application_Requested__c, PTAT) n'est pas affecte.

               UN SEUL APPEL, tous les champs ensemble. C'est structurel :
               les validation rules reevaluent l'enregistrement ENTIER a chaque
               ecriture, donc un compte cree incomplet puis complete champ par
               champ echouerait a la premiere completion. */

            /* ---- LANGUE PREFEREE DE CONTACT --------------------------
               Elle n'etait renseignee QUE hors de France : la validation rule
               l'exige la-bas, et on s'etait arrete a cette exigence. Resultat
               releve par le client, tous les prospects francais avaient
               `PreferredLangage__c` vide. Une exigence de validation n'est pas
               une regle de remplissage.

               ⚠ LA VALEUR DU FORMULAIRE N'EST PAS CELLE DU CRM. Les pages
               postent `LanguePreferee` sur deux lettres — « fr » — et le value
               set d'Account attend French, English, Mandarin, Dutch, Arab,
               Spain. Ecrire « fr » serait rejete EN SILENCE, comme toute valeur
               hors value set. D'ou la table.

               Repli sur l'ancienne regle si le formulaire ne poste rien : hors
               de France, la langue reste requise. */
            SET @langue = Lowercase(Trim(RequestParameter("LanguePreferee")))
            IF @langue == "fr" THEN
                SET @langue = "French"
            ELSEIF @langue == "en" THEN
                SET @langue = "English"
            ELSEIF Lowercase(@country) == "france" THEN
                SET @langue = "French"
            ELSE
                SET @langue = "English"
            ENDIF

            /* ---- FormType__c : BROCHURE UNIQUEMENT ---------------------
               Le tableau des formulaires ne prevoit ce champ cache que pour le
               telechargement de brochure. Les autres formulaires ne le
               renseignent pas — leur origine est tracee par la campagne pour
               la candidature, par l'inscription pour l'evenementiel.

               Ce n'est donc pas un contournement : "Formulaire de Candidature"
               est refuse par l'org, et de toute facon la candidature n'est pas
               censee alimenter ce champ. Les deux se rejoignent.

               "Demande de doc" est la valeur relevee sur l'org qui correspond
               au libelle « telechargement » du cadrage, et elle passe a
               l'ecriture (verifie le 2026-08-23). */
            IF @formType == "brochure" THEN
                SET @typeForm = "Demande de doc"
            ELSE
                SET @typeForm = ""
            ENDIF

            IF Empty(@firstName) THEN
                /* Echec propre. Laisser passer tuerait la page sans message,
                   symptome qu'on a mis plusieurs jours a diagnostiquer. */
                SET @sfStatus = "error"
                SET @sfErrorMsg = "Prenom obligatoire : l'org refuse la creation d'un Person Account sans FirstName (regle VR_PersonAccount_NameMandatory). Rendre le champ requis sur le formulaire."

            ELSE
                /* ---- UN SEUL APPEL, TOUT LE COMPTE ------------------------
                   Refonte du 13/09 : tout ce que le socle sait du prospect
                   part dans la creation — identite, declaratif, tracking
                   complet, canal, consentement cookies, origine, dernier point
                   de contact, drapeau candidature, PTAT, specialite. Plus
                   aucun update derriere : un seul passage des triggers et
                   flows, un seul depot du tampon d'interet academique.

                   @langue n'est jamais vide (table ci-dessus, repli French /
                   English) : les anciennes variantes « sans langue » etaient
                   du code mort. Reste la seule vraie variante : FormType__c
                   n'est envoye qu'en brochure (« Demande de doc »), la
                   candidature le voit refuse et ne doit pas l'alimenter.

                   Canal et sous-canal : rapproches du value set plus haut, donc
                   valeur reelle de l'org ou vide. Le trigger CRM
                   (applyFromUtmOnInsert) peut les recalculer a partir des UTM
                   avant l'insert ; c'est lui qui a le dernier mot.
                   ⚠ DateConsentementCookies__c reste absent, a dessein : champ
                   DATE dont on n'a jamais vu de valeur reelle d'Axeptio ; il
                   n'est pose que sur un compte connu, quand le formulaire en
                   porte une. */
                SET @vConsent = @consentVoulu
                IF Empty(@vConsent) THEN SET @vConsent = "false" ENDIF

                /* ---- PAYLOAD DE CREATION, ECRIT AVANT L'APPEL ---------------
                   Une creation refusee par le CRM ne rend pas une erreur : elle
                   TUE la page. Tout ce qui suit est perdu, y compris le motif.
                   Le payload est donc journalise AVANT `CreateSalesforceObject`,
                   champ par champ et en clair, pour etre transmis tel quel a
                   l'equipe CRM quand une soumission est bloquee.

                   `Detail` fait 500 caracteres et le payload en fait ~900 : on
                   le decoupe en morceaux de 480, meme etape, `Ordre` croissant.
                   Se relit en concatenant les morceaux dans l'ordre.

                   Ecrit a CHAQUE creation, sans dependre de SFMC_LOG_DETAIL :
                   c'est justement quand le journal detaille est coupe, en
                   recette, qu'on a besoin du payload. Une seule creation par
                   visiteur, donc deux ou trois InsertData en plus, uniquement
                   pour un compte neuf. */
                SET @payload = Concat(
                    "RecordTypeId=", @RT_PERSON_ACCOUNT,
                    " | SourceCreation__c=Web Form",
                    " | Ecole__c=", @schoolAccId,
                    " | PTAT_Id__c=", @ptatMaj,
                    " | PreferredLangage__c=", @langue,
                    " | PersonEmail=", @email,
                    " | LastName=", @lastName,
                    " | FirstName=", @firstName)
                SET @payload = Concat(@payload,
                    " | LivingCountry__c=", @country,
                    " | IndicatifPick__c=", @indicatif,
                    " | MobileNumber__c=", @mobile,
                    " | Academic_Level_List__c=", @studyLevel,
                    " | PersonAccountType__c=", @vousEtes,
                    " | Speciality__c=", @specialiteOk,
                    " | Application_Requested__c=", @appRequested)
                SET @payload = Concat(@payload,
                    " | UTMSource__c=", @utmS,
                    " | UTMMedium__c=", @utmM,
                    " | UTMCampaign__c=", @utmC,
                    " | UTMContent__c=", @utmCo,
                    " | UTMTerm__c=", @utmT,
                    " | UTMId__c=", @utmI,
                    " | UTMCampus__c=", @utmCampus)
                SET @payload = Concat(@payload,
                    " | gclid__c=", @gclid,
                    " | fbclid__c=", @fbclid,
                    " | ClientID__c=", @clientId,
                    " | Consent__c=", @vConsent,
                    " | CreationSourceDetail__c=", @detailOrigine,
                    " | DateOfLastMarketingContactPoint__c=", @itHorodatage,
                    " | LastMarketingContactPointType__c=Form")
                /* La variante « brochure » ajoute FormType__c en tete d'appel :
                   le payload le dit, sinon les deux se liraient pareil. */
                IF NOT Empty(@typeForm) THEN
                    SET @payload = Concat("FormType__c=", @typeForm, " | ", @payload)
                ENDIF
                /* Canal et sous-canal ne figurent PAS dans cette liste : le
                   socle ne les envoie plus depuis le 15/09, c'est le trigger
                   CRM qui les calcule a partir des UTM ci-dessus. Le payload
                   dit donc exactement ce qui part d'ici, pas ce que le compte
                   portera apres passage des triggers. */
                /* Offset cumule avec Add plutot que calcule avec Multiply :
                   cette derniere n'est employee nulle part ailleurs ici, et
                   une fonction non eprouvee tue la page au rendu. */
                SET @offset = 1
                IF @LOG_ACTIF == "true" THEN
                    FOR @pz = 1 TO 3 DO
                        SET @morceau = Substring(@payload, @offset, 480)
                        SET @offset = Add(@offset, 480)
                        /* Encadre par [ ] : un champ texte de DE rogne les
                           espaces de bord, et un morceau qui se termine ou
                           commence par un espace perdait ce caractere. Sans
                           consequence entre deux champs, mais une coupure au
                           milieu d'une valeur aurait rendu un payload faux a
                           l'equipe CRM. Les crochets absorbent le rognage ; le
                           lecteur les retire.

                           ⚠ CALCULE ICI, PAS DANS L'APPEL. Un commentaire — et
                           plus generalement tout ce qui n'est pas un argument —
                           glisse au milieu de la liste d'arguments d'InsertData
                           fait ECHOUER l'appel a l'execution, sans erreur de
                           rendu : la page se charge, et c'est la soumission qui
                           meurt. Mesure du 16/09, toutes les creations de compte
                           sont tombees pendant vingt minutes. Ne jamais commenter
                           entre deux arguments. */
                        SET @morceauEncadre = Concat("[", @morceau, "]")
                        IF NOT Empty(@morceau) THEN
                            SET @logOrdre = Add(@logOrdre, 1)
                            InsertData("LPB_Log_Soumissions",
                                "RowId", Concat(@runId, "-", @logOrdre),
                                "RunId", @runId,
                                "Ordre", @logOrdre,
                                "Horodatage", Now(),
                                "Etape", "29 - payload creation compte",
                                "Statut", "OK",
                                "Objet", "Account",
                                "RecordId", "",
                                "Detail", @morceauEncadre,
                                "Email", @email,
                                "Ecole", @ecole,
                                "FormType", @formType)
                        ENDIF
                    NEXT @pz
                ENDIF

                IF Empty(@typeForm) THEN
                    SET @paId = CreateSalesforceObject("Account", 29,
                    "RecordTypeId",           @RT_PERSON_ACCOUNT,
                    "SourceCreation__c",      "Web Form",
                    "Ecole__c",               @schoolAccId,
                    "PTAT_Id__c",             @ptatMaj,
                    "PreferredLangage__c",    @langue,
                    "PersonEmail",            @email,
                    "LastName",               @lastName,
                    "FirstName",              @firstName,
                    "LivingCountry__c",       @country,
                    "IndicatifPick__c",       @indicatif,
                    "MobileNumber__c",        @mobile,
                    "Academic_Level_List__c", @studyLevel,
                    "PersonAccountType__c",   @vousEtes,
                    "Speciality__c",          @specialiteOk,
                    "Application_Requested__c", @appRequested,
                    "UTMSource__c",           @utmS,
                    "UTMMedium__c",           @utmM,
                    "UTMCampaign__c",         @utmC,
                    "UTMContent__c",          @utmCo,
                    "UTMTerm__c",             @utmT,
                    "UTMId__c",               @utmI,
                    "UTMCampus__c",           @utmCampus,
                    "gclid__c",               @gclid,
                    "fbclid__c",              @fbclid,
                    "ClientID__c",            @clientId,
                    "Consent__c",             @vConsent,
                    "CreationSourceDetail__c", @detailOrigine,
                    "DateOfLastMarketingContactPoint__c", @itHorodatage,
                    "LastMarketingContactPointType__c",   "Form")
                ELSE
                    SET @paId = CreateSalesforceObject("Account", 30,
                    "FormType__c",            @typeForm,
                    "RecordTypeId",           @RT_PERSON_ACCOUNT,
                    "SourceCreation__c",      "Web Form",
                    "Ecole__c",               @schoolAccId,
                    "PTAT_Id__c",             @ptatMaj,
                    "PreferredLangage__c",    @langue,
                    "PersonEmail",            @email,
                    "LastName",               @lastName,
                    "FirstName",              @firstName,
                    "LivingCountry__c",       @country,
                    "IndicatifPick__c",       @indicatif,
                    "MobileNumber__c",        @mobile,
                    "Academic_Level_List__c", @studyLevel,
                    "PersonAccountType__c",   @vousEtes,
                    "Speciality__c",          @specialiteOk,
                    "Application_Requested__c", @appRequested,
                    "UTMSource__c",           @utmS,
                    "UTMMedium__c",           @utmM,
                    "UTMCampaign__c",         @utmC,
                    "UTMContent__c",          @utmCo,
                    "UTMTerm__c",             @utmT,
                    "UTMId__c",               @utmI,
                    "UTMCampus__c",           @utmCampus,
                    "gclid__c",               @gclid,
                    "fbclid__c",              @fbclid,
                    "ClientID__c",            @clientId,
                    "Consent__c",             @vConsent,
                    "CreationSourceDetail__c", @detailOrigine,
                    "DateOfLastMarketingContactPoint__c", @itHorodatage,
                    "LastMarketingContactPointType__c",   "Form")
                ENDIF
            ENDIF
            /* Le bookkeeping ne vaut que si la creation a REELLEMENT rendu un Id.
               Sinon on journalisait « account cree » avec un RecordId vide. */
            IF NOT Empty(@paId) THEN
                SET @isNew = "true"

                /* Rien a completer : la creation porte tout (voir ci-dessus).
                   Les douze updates qui suivaient — origine, medium, campagne,
                   identifiants publicitaires, canal, cookies — ont disparu avec
                   la refonte du 13/09. */
                IF @LOG_ACTIF == "true" THEN
                    SET @logOrdre = Add(@logOrdre, 1)
                    InsertData("LPB_Log_Soumissions",
                        "RowId", Concat(@runId, "-", @logOrdre),
                        "RunId", @runId,
                        "Ordre", @logOrdre,
                        "Horodatage", Now(),
                        "Etape", "30 - account cree",
                        "Statut", "OK",
                        "Objet", "Account",
                        "RecordId", @paId,
                        "Detail", "creation avec RecordType person",
                        "Email", @email,
                        "Ecole", @ecole,
                        "FormType", @formType)
                ENDIF

                /* `Ecole__c` fait desormais partie de la CREATION : cet
                   update qui suivait l'insert est devenu redondant, il
                   reecrivait la meme valeur au prix d'un appel de plus. */
                SET @rows = RetrieveSalesforceObjects("Account", "Id,PersonContactId", "Id", "=", @paId)
                IF RowCount(@rows) > 0 THEN SET @paContactId = Field(Row(@rows,1), "PersonContactId") ENDIF
            ENDIF
        ENDIF

        /* ---- DRAPEAU CANDIDATURE, PTAT, SPECIALITE : DEJA ECRITS ------------
           Ils partent dans l'appel unique de creation ou de mise a jour (voir
           les deux branches ci-dessus, et les valeurs communes avant la
           bifurcation). Ce bloc ne fait plus que journaliser. Les anciennes
           relectures « PTAT:refuse-silencieux » sont retirees : le trigger CRM
           consomme le PTAT (depot du tampon puis remise a vide), un PTAT vide
           juste apres l'ecriture est donc la preuve que ca a MARCHE, pas
           l'inverse. */
        IF NOT Empty(@paId) THEN
            IF @LOG_ACTIF == "true" AND @LOG_DETAIL == "true" THEN
                SET @logOrdre = Add(@logOrdre, 1)
                InsertData("LPB_Log_Soumissions",
                    "RowId", Concat(@runId, "-", @logOrdre),
                    "RunId", @runId,
                    "Ordre", @logOrdre,
                    "Horodatage", Now(),
                    "Etape", "50 - drapeau candidature pose",
                    "Statut", "OK",
                    "Objet", "Account",
                    "RecordId", @paId,
                    "Detail", Concat("formType=", @formType),
                    "Email", @email,
                    "Ecole", @ecole,
                    "FormType", @formType)
            ENDIF
        ENDIF

        /* ====================================================================
           ETAPE 2 — CONTACTPOINTCONSENT, un enregistrement par canal coche
           ====================================================================
           ⚠ MODELE CORRIGE le 2026-08-23. Le code precedent ecrivait
           `ParentId`, qui N'EXISTE PAS sur cet objet : toutes les creations
           echouaient en silence depuis le debut.

           Modele reel, releve sur l'org :
             ContactPointId        reference vers un ContactPointEmail
                                   ou ContactPointPhone — PAS vers l'Account
             Channel__c            REQUIS (sans lui la creation echoue,
                                   quels que soient les autres champs)
             PrivacyConsentStatus  "OptIn"
             Status__c             "Opt-in" — les DEUX sont remplis sur les
                                   2461 consentements existants, avec des
                                   graphies differentes
             DataUsePurposeId      vide partout, inutile

           Le consentement se rattache donc a un POINT DE CONTACT, pas au
           compte. Il faut le resoudre avant d'ecrire.

           Un Person Account fraichement cree n'a AUCUN point de contact —
           rien ne les fabrique cote CRM. Le socle les CREE donc au besoin,
           juste avant la boucle. Le consentement d'un nouveau prospect est
           ainsi enregistre comme celui d'un prospect connu.

           Boucle sur 5 canaux plutot que cinq blocs recopies.
           ==================================================================== */
        IF NOT Empty(@paId) THEN

            /* ---- LA PREUVE : LE TEXTE LEGAL, ET RIEN D'AUTRE ---------------
               Le texte accepte, puis le texte de pied de page, separes par un
               tiret. Plus de prefixe « [v1] » : il ne versionnait rien — aucun
               [v2] n'a jamais existe — et occupait la tete du champ, la ou on
               lit la phrase reellement acceptee.

               ⚠ CE PREFIXE FAISAIT OFFICE DE FILET. `Legal_Texte_Accepted__c`
               est REQUIS a la creation : avec « [v1] » en dur, la preuve
               n'etait jamais vide et l'insert passait toujours. Sans lui, un
               formulaire qui ne poste pas son texte legal produit une preuve
               vide et TUE la page a l'insert. D'ou le garde-fou plus bas : pas
               de texte, pas de consentement ecrit — et une ligne au journal.
               Un consentement sans trace de ce qui a ete accepte ne vaudrait
               de toute facon rien devant la CNIL. */
            /* `@itHorodatage` n'est pose que dans la branche « prospect deja
               connu ». Un prospect NEUF arrivait donc ici avec une date vide,
               et une date vide sur un champ date Salesforce tue la page. On la
               garantit sans ecraser celle de l'autre branche. */
            IF Empty(@itHorodatage) THEN
                SET @itHorodatage = Format(Now(), "yyyy-MM-dd HH:mm:ss")
            ENDIF
            /* Version ISO 8601 UTC pour les champs Date/Heure. L'horloge de
               SFMC est en heure centrale US sans heure d'ete (UTC-6 fixe) :
               +6 h pour le « Z ». On prend les 19 premiers caracteres de
               FormatDate(...,"iso") — « 2026-09-10T13:50:32 » — et on colle le Z.

               ⚠ PIEGE MESURE LE 10/09 : dans FormatDate, « mm » vaut MOIS, pas
               minutes (« HH:mm:ss » a rendu 07:09:32 a 07:50:32). Seule la
               fonction Format() (motif .NET, sensible a la casse) rend les
               minutes ; c'est elle qui sert partout ailleurs dans ce fichier
               pour « yyyy-MM-dd HH:mm:ss ». Ne jamais revenir a FormatDate
               pour une heure. */
            IF Empty(@itHorodatageUtc) THEN
                SET @itHorodatageUtc = Concat(Substring(FormatDate(DateAdd(Now(), 6, "H"), "iso"), 1, 19), "Z")
            ENDIF

            SET @preuve = ""
            IF NOT Empty(@legalText) THEN SET @preuve = @legalText ENDIF
            IF NOT Empty(@legalFooter) THEN
                IF Empty(@preuve) THEN
                    SET @preuve = @legalFooter
                ELSE
                    SET @preuve = Concat(@preuve, " — ", @legalFooter)
                ENDIF
            ENDIF

            /* ---- POINTS DE CONTACT : RESOLUS, SINON CREES -----------------
               Resolus UNE FOIS pour les 5 canaux : l'e-mail sert au canal Email
               et aux cookies publicitaires, le telephone a Phone / SMS /
               WhatsApp.

               ⚠ Un Person Account fraichement cree n'a AUCUN point de contact :
               rien ne les fabrique automatiquement cote CRM. Verifie sur
               001AW00001yrTQbYAM, cree le 23/08 — trois jours plus tard,
               toujours zero. Sans creation de notre part, les cases opt-in d'un
               nouveau prospect ne sont donc PAS enregistrees : le formulaire
               aboutit et l'information RGPD est perdue.

               J'avais d'abord conclu que la creation nous etait refusee. C'etait
               faux, et c'est la quatrieme fois que je tire cette conclusion trop
               vite. Le seul champ fautif est `Name` : Salesforce le renseigne
               lui-meme a partir de l'adresse — d'ou sa valeur egale a l'e-mail
               sur les enregistrements reels — et l'envoyer, MEME AVEC LA BONNE
               VALEUR, fait echouer l'insert.

               Ne jamais poser `Name` ici. */
            SET @cpEmail = ""
            SET @cpPhone = ""

            /* ---- COMPTE TOUT JUSTE CREE : RIEN A RELIRE -------------------
               Un Person Account ne a l'instant n'a ni point de contact ni
               consentement : les quatre lectures qui suivent (deux
               ContactPoint, deux ContactPointConsent) rendaient toujours zero
               ligne — verifie sur les journaux, « CP:email-cree CP:phone-cree
               CPC:*-cree » a chaque creation. On ne les fait donc que sur un
               compte existant (piste 3 du 14/09 : 3 s entre la creation du
               compte et le premier consentement). Si le CRM se mettait un
               jour a creer un ContactPointEmail a la volee, la creation ci-
               dessous echouerait en doublon et tuerait la page : le journal
               le dirait a la premiere soumission. */
            SET @nCpRows = 0
            IF @isNew != "true" THEN
                SET @rows = RetrieveSalesforceObjects("ContactPointEmail", "Id", "ParentId", "=", @paId)
                SET @nCpRows = RowCount(@rows)
            ENDIF
            IF @nCpRows > 0 THEN
                SET @cpEmail = Field(Row(@rows,1), "Id")
            ELSEIF NOT Empty(@email) THEN
                SET @cpEmail = CreateSalesforceObject("ContactPointEmail", 3,
                    "ParentId",     @paId,
                    "EmailAddress", @email,
                    "IsPrimary",    "true")
                SET @journal = Concat(@journal, " CP:email-cree")
            ENDIF

            SET @nCpRows = 0
            IF @isNew != "true" THEN
                SET @rows = RetrieveSalesforceObjects("ContactPointPhone", "Id", "ParentId", "=", @paId)
                SET @nCpRows = RowCount(@rows)
            ENDIF
            IF @nCpRows > 0 THEN
                SET @cpPhone = Field(Row(@rows,1), "Id")
            ELSEIF NOT Empty(@mobile) THEN
                SET @cpPhone = CreateSalesforceObject("ContactPointPhone", 3,
                    "ParentId",        @paId,
                    "TelephoneNumber", @mobile,
                    "IsPrimary",       "true")
                SET @journal = Concat(@journal, " CP:phone-cree")
            ENDIF

            /* ---- CONSENTEMENTS DEJA POSES, LUS UNE SEULE FOIS -------------
               UN SEUL enregistrement par canal, et non un de plus a chaque
               soumission. Le compte de recette en portait 12 pour 3
               soumissions : les doublons rendent la preuve RGPD illisible,
               puisque plus rien ne dit lequel fait foi.

               ⚠ REVIREMENT DU 31/08, ET IL FAUT LE DIRE. Le commentaire
               precedent affirmait l'objet CREATE-ONLY : « aucun update n'y
               passe », mesure du 26/08. C'EST FAUX AUJOURD'HUI — verifie a la
               main sur un consentement du compte de recette : `Status__c` mis
               a Opt-out, RELU a Opt-out, puis remis a Opt-in. Soit un droit a
               change cote CRM, soit la mesure d'alors confondait le refus de
               l'update avec une autre erreur de la page.

               Deux lectures suffisent pour les cinq canaux — une par point de
               contact — au lieu d'une par canal. On retrouve ensuite le bon
               enregistrement en parcourant le rowset sur `Channel__c` : un
               filtre a deux conditions sur cet objet n'a jamais ete eprouve
               ici, et une forme de requete non eprouvee tue la page. */
            SET @nCpcMail = 0
            IF NOT Empty(@cpEmail) AND @isNew != "true" THEN
                SET @cpcMail = RetrieveSalesforceObjects("ContactPointConsent",
                    "Id,Channel__c,BusinessBrandId,PrivacyConsentStatus,Status__c,GDPR_Status__c,Legal_Texte_Accepted__c",
                    "ContactPointId", "=", @cpEmail)
                SET @nCpcMail = RowCount(@cpcMail)
            ENDIF
            SET @nCpcTel = 0
            IF NOT Empty(@cpPhone) AND @isNew != "true" THEN
                SET @cpcTel = RetrieveSalesforceObjects("ContactPointConsent",
                    "Id,Channel__c,BusinessBrandId,PrivacyConsentStatus,Status__c,GDPR_Status__c,Legal_Texte_Accepted__c",
                    "ContactPointId", "=", @cpPhone)
                SET @nCpcTel = RowCount(@cpcTel)
            ENDIF

            FOR @i = 1 TO 5 DO
                IF @i == 1 THEN
                    SET @canalParam = "HasOptedInEmail"
                    SET @canalValue = "Email"
                ELSEIF @i == 2 THEN
                    SET @canalParam = "HasOptedInPhone"
                    SET @canalValue = "Phone"
                ELSEIF @i == 3 THEN
                    SET @canalParam = "HasOptedInSMS"
                    SET @canalValue = "SMS"
                ELSEIF @i == 4 THEN
                    SET @canalParam = "HasOptedInWhatsApp"
                    SET @canalValue = "WhatsApp"
                ELSE
                    SET @canalParam = "HasOptedInAdvertising"
                    SET @canalValue = "Advertising Cookies"
                ENDIF

                SET @coche = RequestParameter(@canalParam)

                /* Case non cochee = pas de consentement = on n'ecrit RIEN.
                   On ne pose jamais un opt-out implicite : l'absence de preuve
                   n'est pas une preuve de refus. */
                IF @coche == "1" OR Lowercase(@coche) == "true" OR Lowercase(@coche) == "on" THEN

                    /* Le point de contact a viser depend du canal. */
                    IF @canalValue == "Phone" OR @canalValue == "SMS" OR @canalValue == "WhatsApp" THEN
                        SET @cpId = @cpPhone
                        SET @cpcRows = @cpcTel
                        SET @nCpc = @nCpcTel
                    ELSE
                        SET @cpId = @cpEmail
                        SET @cpcRows = @cpcMail
                        SET @nCpc = @nCpcMail
                    ENDIF

                    /* Ce canal a-t-il deja son consentement POUR CETTE MARQUE ?
                       Regle metier du 11/09 : le consentement est par marque.
                       Une meme personne qui soumet EFAP puis BRASSART doit avoir
                       4 enregistrements EFAP ET 4 enregistrements BRASSART ; le
                       rapprochement sur le seul canal reutilisait ceux de la
                       premiere marque et n'en creait jamais pour la seconde.
                       L'identite est donc (point de contact, canal, marque).
                       Sans marque connue (page hors mapping), on retombe sur le
                       canal seul, comme avant.
                       Les consentements anciens SANS marque (crees avant le
                       02/09) ne sont rapproches par aucune marque : une
                       nouvelle soumission cree le sien, l'ancien reste — ce
                       socle ne sait ni supprimer ni poser une marque en update,
                       le menage se fait cote CRM. Premiere ligne qui correspond
                       si des doublons existent. */
                    SET @cpcId = ""
                    FOR @k = 1 TO @nCpc DO
                        IF Empty(@cpcId) THEN
                            IF Field(Row(@cpcRows, @k), "Channel__c") == @canalValue THEN
                                IF Empty(@brandId) OR Field(Row(@cpcRows, @k), "BusinessBrandId", 0) == @brandId THEN
                                    SET @cpcRow = Row(@cpcRows, @k)
                                    SET @cpcId  = Field(@cpcRow, "Id")
                                ENDIF
                            ENDIF
                        ENDIF
                    NEXT @k

                    IF @LOG_ACTIF == "true" AND @LOG_DETAIL == "true" THEN
                        SET @logOrdre = Add(@logOrdre, 1)
                        InsertData("LPB_Log_Soumissions",
                            "RowId", Concat(@runId, "-", @logOrdre),
                            "RunId", @runId,
                            "Ordre", @logOrdre,
                            "Horodatage", Now(),
                            "Etape", "58 - avant consentement",
                            "Statut", "OK",
                            "Objet", "ContactPointConsent",
                            "RecordId", "",
                            "Detail", Concat("canal=", @canalValue, " cp=", @cpId),
                            "Email", @email,
                            "Ecole", @ecole,
                            "FormType", @formType)
                    ENDIF
                    IF Empty(@cpId) THEN
                        /* Aucun point de contact : on ne peut rien ecrire.
                           On le journalise au lieu de tuer la page. */
                        SET @journal = Concat(@journal, " CPC:", @canalValue, "-sans-contactpoint")
                    ELSEIF NOT Empty(@cpcId) THEN
                        /* ---- LE CANAL A DEJA SON CONSENTEMENT : ON LE MET
                           A JOUR, ON N'EN CREE PAS UN AUTRE ----------------
                           Un enregistrement par canal ET PAR MARQUE — quatre par
                           marque, quel que soit le nombre de soumissions. Regle
                           du 31/08 (un par canal) precisee le 11/09 (par marque) ;
                           elle remplace le « un enregistrement par soumission »
                           du 26/08. Une soumission pour une autre marque ne passe
                           pas ici : elle cree ses quatre enregistrements.

                           On n'ecrit QUE ce qui differe. Une re-soumission a
                           l'identique — le cas courant — ne declenche donc
                           AUCUN update : elle coute une lecture, deja faite
                           avant la boucle, et rien de plus. Un consentement
                           inchange qu'on reecrit n'est pas une preuve plus
                           solide, c'est juste une ligne de plus.

                           Ce qui peut legitimement changer d'une fois sur
                           l'autre : le statut, si la personne s'etait
                           desabonnee puis re-consent, et le texte legal
                           accepte, si le formulaire a change de version.

                           ⚠ On ne touche NI Channel__c NI ContactPointId :
                           ce couple est l'identite de l'enregistrement. Ni
                           Name, qui porte l'horodatage de la premiere preuve —
                           la date de POSE du consentement, qu'une mise a jour
                           ne doit pas effacer.

                           ⚠⚠ UN SEUL CHAMP EST MODIFIABLE : `Status__c`.
                           `PrivacyConsentStatus`, `GDPR_Status__c` et
                           `Legal_Texte_Accepted__c` sont REFUSES en update et
                           TUENT LA PAGE — mesure du 31/08, champ par champ, sur
                           un consentement du compte de recette. La note du
                           26/08 disait l'objet entierement create-only ; elle
                           avait raison pour ces trois-la, et tort pour
                           `Status__c`, qui passe et persiste (mis a Opt-out,
                           relu Opt-out, remis a Opt-in).

                           Consequence a connaitre : si ces trois champs
                           divergent, on ne peut pas les corriger. On les
                           JOURNALISE — un `-fige` visible vaut mieux qu'une
                           preuve RGPD fausse et muette. Les debloquer est une
                           question de droits cote CRM, pas de code. */
                        SET @majs = "0"
                        /* ---- DATE DU DERNIER ENGAGEMENT : A CHAQUE SOUMISSION -------
                           Regle metier (anouar, 10/09) : `LastMarketingEngagementDate__c`
                           suit CHAQUE soumission, pas seulement la creation.
                           Deux regles de validation du CRM (Prevent_Opt_In/Opt_out_
                           Date_Manual_Edit) rejettent toute sauvegarde ou le statut
                           ne change pas, parce qu'un flow retouche les dates
                           d'opt-in/out a chaque enregistrement. Donc :
                           - statut a changer → la date part DANS LE MEME update que
                             le statut : le statut change, les regles laissent passer ;
                           - statut inchange → l'update est REPORTE au bloc SSJS de
                             fin de fichier (try/catch) : refuse tant que le CRM
                             n'exempte pas MC Connect, mais sans tuer la page, et
                             journalise « CPC:date-refusee ». */
                        /* ⚠ DEBLOQUE LE 17/09 — HISTORIQUE A GARDER. Du 10 au 17/09,
                           tout update de `LastMarketingEngagementDate__c` par MC
                           Connect etait refuse par Salesforce et TUAIT la page :
                           seul (sonde), et meme accompagne d'un changement de statut.
                           Le socle se contentait donc d'un marqueur « -date-figee ».
                           Le CRM a leve le blocage ; mesure a la sonde le 17/09 sur
                           un consentement reel : les DEUX graphies sont acceptees et
                           se relisent avec la nouvelle valeur.

                           Les deux partent ensemble, comme a la creation :
                           `Last_Marketing_Engagement_Date__c` est une DATE, et
                           `LastMarketingEngagementDate__c` un DATE/HEURE qui
                           n'accepte que l'ISO UTC termine par Z.

                           Le statut rejoint LE MEME update quand il doit changer.
                           Un seul appel, et les regles Prevent_Opt_In/Opt_out_Date_
                           Manual_Edit voient alors un vrai changement de statut. */
                        IF Field(@cpcRow, "Status__c") != "Opt-in" THEN
                            SET @n = UpdateSingleSalesforceObject("ContactPointConsent", @cpcId,
                                "Status__c", "Opt-in",
                                "Last_Marketing_Engagement_Date__c", @itHorodatage,
                                "LastMarketingEngagementDate__c", @itHorodatageUtc)
                            SET @majs = "1"
                        ELSE
                            SET @n = UpdateSingleSalesforceObject("ContactPointConsent", @cpcId,
                                "Last_Marketing_Engagement_Date__c", @itHorodatage,
                                "LastMarketingEngagementDate__c", @itHorodatageUtc)
                        ENDIF
                        SET @journal = Concat(@journal, " CPC:", @canalValue, "-date-maj")
                        IF @majs == "1" THEN
                            SET @journal = Concat(@journal, " CPC:", @canalValue, "-statut-maj")
                        ELSE
                            SET @journal = Concat(@journal, " CPC:", @canalValue, "-statut-inchange")
                        ENDIF

                        /* Divergences que le connecteur nous interdit de
                           reparer. Signalees, jamais corrigees en silence. */
                        IF Field(@cpcRow, "PrivacyConsentStatus") != "OptIn" THEN
                            SET @journal = Concat(@journal, " CPC:", @canalValue,
                                "-PrivacyConsentStatus-fige(", Field(@cpcRow, "PrivacyConsentStatus"), ")")
                        ENDIF
                        /* Plus d'alerte sur GDPR_Status__c : le CRM le remplit
                           lui-meme, le socle ne l'envoie plus, et le marqueur
                           `-GDPR-fige()` sonnait donc a chaque re-soumission
                           pour une divergence qui n'en est pas une. */
                        /* Le texte legal accepte a change de version depuis la
                           pose du consentement, et on ne peut pas l'ecrire. La
                           preuve conservee reste celle de la PREMIERE
                           acceptation : a arbitrer avec le juridique, car la
                           seule autre issue serait un second enregistrement —
                           donc le doublon qu'on vient justement de supprimer. */
                        IF NOT Empty(@preuve) THEN
                            IF Field(@cpcRow, "Legal_Texte_Accepted__c") != @preuve THEN
                                SET @journal = Concat(@journal, " CPC:", @canalValue, "-texte-fige")
                            ENDIF
                        ENDIF
                    ELSE
                        /* ---- PREMIER CONSENTEMENT POUR CE CANAL -----------
                           Seul chemin qui CREE. On n'y passe que si le canal
                           n'a encore aucun enregistrement pour ce point de
                           contact ; sinon c'est la branche de mise a jour
                           ci-dessus qui a joue.

                           ⚠ `Name` est REQUIS sur cet objet, et son absence
                           etait un BUG : le socle ne l'envoyait pas, donc aucun
                           consentement ne se creait. Piege d'autant plus vicieux
                           que le meme champ se comporte a l'INVERSE sur le point
                           de contact : `ContactPointEmail.Name` est calcule par
                           Salesforce et l'envoyer fait echouer l'insert. Deux
                           objets voisins, deux regles opposees.

                           ⚠ Legal_Texte_Accepted__c est REQUIS : sans lui
                           l'insert ECHOUE et la page meurt. @preuve peut
                           desormais etre vide — le prefixe "[v1]" qui le
                           garantissait a ete retire le 31/08 — d'ou le test
                           qui precede la creation.

                           BusinessBrandId : voir @ECRIRE_MARQUE_CONSENT en
                           tete de fichier. */
                        IF Empty(@preuve) THEN
                            /* Ni LegalTexteAccepted ni LegalTexteFooter dans le
                               POST : on ne sait pas ce que la personne a
                               accepte. On n'ecrit donc PAS un consentement dont
                               la preuve serait vide, et on le dit au journal —
                               plutot que de tuer la page sur un champ requis. */
                            SET @journal = Concat(@journal, " CPC:", @canalValue, "-sans-texte-legal")
                        ELSEIF @ECRIRE_DATE_ENGAGEMENT == "true" AND @ECRIRE_MARQUE_CONSENT == "true" AND NOT Empty(@brandId) THEN
                            /* Chemin nominal depuis le 10/09 : voir
                               @ECRIRE_DATE_ENGAGEMENT en tete de fichier. */
                            /* Les DEUX graphies sont envoyees (voir en tete) :
                               celle avec underscores passe (relue le 10/09 sur
                               test.correction.rgdp2), la CamelCase est ignoree
                               en silence tant que le permission set n'est pas
                               assigne au user MC Connect — sans tuer la page,
                               constate le 10/09 a 12:52. Le jour ou le CRM
                               l'assigne, elle se remplit sans redeploiement. */
                            /* Les DEUX graphies partent. `LastMarketingEngagementDate__c`
                               (CamelCase, celui de la fiche) TUAIT la page tant que
                               le user MC Connect n'avait pas le droit d'ecriture
                               (est.correction.rgdp3, 10/09 13:09) : le permission
                               set « MC Connect - Date d'engagement marketing » lui
                               a ete assigne le 10/09 par anouar. Si une page meurt
                               a « 58 - avant consentement », verifier d'abord que
                               cette assignation tient toujours. */
                            /* `LastMarketingEngagementDate__c` est un DATE/HEURE : il
                               n'accepte que l'ISO 8601 en UTC (« 2026-09-10T13:26:13Z »).
                               Le format « yyyy-MM-dd HH:mm:ss », qui passe sur les
                               champs Date, TUE la creation ici — mesure du 10/09 :
                               rgdp3 et rgdp5 morts avec ce format, sonde de creation
                               acceptee et relue avec l'ISO (0ZXAW0000001aJB4AY). Le
                               droit d'ecriture etait necessaire aussi (permission set
                               assigne le 10/09), mais pas suffisant. */
                            SET @cpcId = CreateSalesforceObject("ContactPointConsent", 10,
                                "ContactPointId",          @cpId,
                                "Channel__c",              @canalValue,
                                "Name",                    Concat("Consent ", @canalValue, " - ", @email,
                                                                  " - ", Format(Now(), "yyyy-MM-dd HH:mm:ss")),
                                "PrivacyConsentStatus",    "OptIn",
                                "Status__c",               "Opt-in",
                                "CaptureSource",           "SFMC CloudPage",
                                "Legal_Texte_Accepted__c", @preuve,
                                "Last_Marketing_Engagement_Date__c", @itHorodatage,
                                "LastMarketingEngagementDate__c",    @itHorodatageUtc,
                                "BusinessBrandId",         @brandId)

                        ELSEIF @ECRIRE_MARQUE_CONSENT == "true" AND NOT Empty(@brandId) THEN
                            SET @cpcId = CreateSalesforceObject("ContactPointConsent", 8,
                                "ContactPointId",          @cpId,
                                "Channel__c",              @canalValue,
                                "Name",                    Concat("Consent ", @canalValue, " - ", @email,
                                                                  " - ", Format(Now(), "yyyy-MM-dd HH:mm:ss")),
                                "PrivacyConsentStatus",    "OptIn",
                                "Status__c",               "Opt-in",
                                "CaptureSource",           "SFMC CloudPage",
                                "Legal_Texte_Accepted__c", @preuve,
                                "BusinessBrandId",         @brandId)
                        ELSE
                            SET @cpcId = CreateSalesforceObject("ContactPointConsent", 7,
                                "ContactPointId",          @cpId,
                                "Channel__c",              @canalValue,
                                "Name",                    Concat("Consent ", @canalValue, " - ", @email,
                                                                  " - ", Format(Now(), "yyyy-MM-dd HH:mm:ss")),
                                "PrivacyConsentStatus",    "OptIn",
                                "Status__c",               "Opt-in",
                                "CaptureSource",           "SFMC CloudPage",
                                "Legal_Texte_Accepted__c", @preuve)
                        ENDIF
                        /* Marqueur de CREATION, pose SEULEMENT si un
                           enregistrement est reellement ne — @cpcId ne vaut
                           quelque chose que si CreateSalesforceObject a rendu
                           un Id. Il etait pose hors du IF, donc aussi sur les
                           cas d'echec : « CPC:Email-sans-texte-legal » etait
                           suivi de « CPC:Email-cree », qui disait l'inverse. */
                        IF NOT Empty(@cpcId) THEN
                            SET @journal = Concat(@journal, " CPC:", @canalValue, "-cree")
                        ENDIF
                    ENDIF
                    IF @LOG_ACTIF == "true" THEN
                        SET @logOrdre = Add(@logOrdre, 1)
                        InsertData("LPB_Log_Soumissions",
                            "RowId", Concat(@runId, "-", @logOrdre),
                            "RunId", @runId,
                            "Ordre", @logOrdre,
                            "Horodatage", Now(),
                            "Etape", "60 - consentement",
                            "Statut", "OK",
                            "Objet", "ContactPointConsent",
                            "RecordId", @cpcId,
                            "Detail", Concat("canal=", @canalValue),
                            "Email", @email,
                            "Ecole", @ecole,
                            "FormType", @formType)
                    ENDIF
                ENDIF
            NEXT @i
        ENDIF

        /* ====================================================================
           ETAPE 3a — CAMPAIGNMEMBER (brochure / candidature)
           Idempotence : un seul CM par (Campagne x PA). Une re-soumission ne
           cree pas de doublon — le contrat prevoit d'empiler l'interaction, pas
           l'adhesion.
           ==================================================================== */
        /* ---- Famille du formulaire -------------------------------------
           ⚠ Le builder ne pose PAS "jpo" / "atelier" / "stage". Les quatre
           formulaires evenement passent par blocks/forms/shared/event-form.js,
           qui pose une seule valeur : "evenement". Le sous-type (JPO,
           Atelier_Decouverte, Stage) arrive dans TypeEvenement.

           Le socle SSJS testait les trois valeurs detaillees : la condition
           n'aurait JAMAIS ete vraie, et toute inscription evenement serait
           partie dans la branche CampaignMember au lieu de Summit. Bug herite,
           corrige ici apres lecture du builder.

           Valeurs reellement emises : brochure | candidature | immersion |
           evenement. On accepte aussi les trois anciennes par tolerance, au cas
           ou une page publiee avant ce correctif serait encore en ligne.

           IMMERSION : arbitrage CLOS par le mapping API SF v4 (decision du
           02/07) — « ce formulaire NE cree PAS de CampaignMember. Suivre la
           structure de l onglet Inscription JPO : Summit Registration + 1
           Appointment par date d immersion ». Elle rejoint donc la famille
           evenement. Coherent avec le fichier de campagnes, qui ne contient
           aucune campagne immersion : il n y aurait rien a rattacher. */
        SET @isEvent = "false"
        IF @formType == "evenement" OR @formType == "immersion" OR @formType == "jpo" OR @formType == "atelier" OR @formType == "stage" THEN
            SET @isEvent = "true"
        ENDIF
        SET @typeEvt = RequestParameter("TypeEvenement")

        IF @isEvent == "false" AND NOT Empty(@paId) AND NOT Empty(@campaignId) AND NOT Empty(@paContactId) THEN

            SET @rows = RetrieveSalesforceObjects("CampaignMember", "Id",
                "CampaignId", "=", @campaignId,
                "ContactId",  "=", @paContactId)

            IF RowCount(@rows) > 0 THEN
                SET @cmId = Field(Row(@rows,1), "Id")
                SET @journal = Concat(@journal, " CM:existant")
                IF @LOG_ACTIF == "true" THEN
                    SET @logOrdre = Add(@logOrdre, 1)
                    InsertData("LPB_Log_Soumissions",
                        "RowId", Concat(@runId, "-", @logOrdre),
                        "RunId", @runId,
                        "Ordre", @logOrdre,
                        "Horodatage", Now(),
                        "Etape", "70 - campaignmember existant",
                        "Statut", "IGNORE",
                        "Objet", "CampaignMember",
                        "RecordId", @cmId,
                        "Detail", "interaction historisee",
                        "Email", @email,
                        "Ecole", @ecole,
                        "FormType", @formType)
                ENDIF
                /* ---- INTERACTION REPETEE ---------------------------------
                   L'unicite Campagne x Person Account interdit un second
                   CampaignMember : la soumission suivante est historisee ici.

                   ⚠ CORRIGE le 2026-08-24. Le socle ecrivait "CampaignMember__c",
                   qui N'EXISTE PAS sur l'objet : toutes les interactions
                   echouaient en silence, exactement comme ParentId sur le
                   consentement. Les vrais champs sont CampaignMemberId__c
                   (texte) et CampaignMemberLink__c (lookup).

                   Les 9 champs de tracking existent deja sur l'objet et
                   n'etaient pas alimentes. Le layout « Formulaire » de l'US
                   « Interaction » les attend tous.

                   ⚠ A ANTICIPER : l'US de generalisation renomme l'objet en
                   `Interaction__c`, ajoute 4 record types par canal (il faudra
                   envoyer celui du Formulaire), un Status__c restreint a
                   « Soumis » pour les formulaires, et deux champs Preview__c /
                   Context__c. Le document precise que le renommage doit
                   intervenir AVANT le branchement des connecteurs — or nous
                   sommes deja branches. */
            ELSE
                /* Les 4 derniers champs etaient COLLECTES par le formulaire
                   mais jamais ecrits : ecart releve le 2026-08-24 contre le
                   mapping v4. Tous verifies presents sur CampaignMember. */
                /* PersonAccount__c en plus de ContactId (demande du 08/09) : c'est
                   ce lookup que lisent les vues CRM dediees aux membres de
                   campagne — sans lui, le membre existe mais n'y remonte pas.
                   Mesure avant correctif : 48 des 245 membres de la campagne
                   brochure EFAP FR l'avaient vide. */
                SET @cmId = CreateSalesforceObject("CampaignMember", 14,
                    "PersonAccount__c",       @paId,
                    "CampaignId",             @campaignId,
                    "ContactId",              @paContactId,
                    "UTM_Source__c",          @utmS,
                    "UTM_Medium__c",          @utmM,
                    "UTM_Campaign__c",        @utmC,
                    "UTM_Content__c",         @utmCo,
                    "UTM_Term__c",            @utmT,
                    "UTM_Id__c",              @utmI,
                    "gclid__c",               @gclid,
                    "fbclid__c",              @fbclid,
                    "Client_ID__c",           @clientId,
                    "AcquisitionChannel__c",  @canal,
                    "AcquisitionSubChannel__c", @sousCanal)
                SET @journal = Concat(@journal, " CM:cree")
                IF @LOG_ACTIF == "true" THEN
                    SET @logOrdre = Add(@logOrdre, 1)
                    InsertData("LPB_Log_Soumissions",
                        "RowId", Concat(@runId, "-", @logOrdre),
                        "RunId", @runId,
                        "Ordre", @logOrdre,
                        "Horodatage", Now(),
                        "Etape", "70 - campaignmember cree",
                        "Statut", "OK",
                        "Objet", "CampaignMember",
                        "RecordId", @cmId,
                        "Detail", @campaignId,
                        "Email", @email,
                        "Ecole", @ecole,
                        "FormType", @formType)
                ENDIF
            ENDIF

            /* ---- UNE INTERACTION PAR SOUMISSION -------------------------
               Arbitrage du 2026-08-24 : « chaque interaction compte ». On
               historise DONC a chaque soumission, pas seulement aux
               repetitions comme le prevoyait le contrat v4 (etape 3c, « si
               interaction repetee »).

               La raison : l'US de generalisation de l'objet veut
               « l'historique complet des interactions quel que soit le
               canal ». N'ecrire que les repetitions rendait la PREMIERE
               soumission invisible dans l'historique du prospect — le
               CampaignMember la porte, mais il ne vit pas dans la meme
               chronologie et ne porte pas de canal.

               Pose ici, apres la resolution du CampaignMember, donc valable
               pour les deux branches : membre trouve comme membre cree.

               ⚠ Toujours neutralise par @INTERACTION_ACTIVE : l'objet refuse
               la creation a l'utilisateur d'integration. Cf. l'en-tete. */
            IF @INTERACTION_ACTIVE != "true" THEN
                SET @journal = Concat(@journal, " INTERACTION:desactivee")
            ELSEIF NOT Empty(@cmId) THEN
                /* ⚠ PAS de CampaignMemberLink__c : il fait echouer l'insert a
                   lui seul. Le lien vers le membre passe par CampaignMemberId__c,
                   en texte.

                   InteractionDate__c EST envoye depuis le 11/09. Il faisait
                   echouer l'insert le 26/08 pour la meme raison que la date
                   d'engagement : c'est un Date/Heure, et le format
                   « yyyy-MM-dd HH:mm:ss » est refuse ; l'ISO UTC passe (sonde
                   LPB_TST_Sonde_Interaction_Date, relu a la seconde). Sans
                   lui, Salesforce ne pose RIEN : le champ restait vide sur
                   toutes les interactions creees par les formulaires. */
                IF Empty(@itHorodatageUtc) THEN
                    SET @itHorodatageUtc = Concat(Substring(FormatDate(DateAdd(Now(), 6, "H"), "iso"), 1, 19), "Z")
                ENDIF

                /* Preview__c — ce que la personne a demande, en clair.
                   Context__c — d'ou vient la soumission.
                   Information__c garde le nom du formulaire, comme avant :
                   les trois champs ne se recouvrent pas. */
                SET @itPreview = @formType
                IF NOT Empty(@ecole) THEN
                    SET @itPreview = Concat(@itPreview, " - ", @ecole)
                ENDIF
                IF NOT Empty(@campusSel) THEN
                    SET @itPreview = Concat(@itPreview, " - ", @campusSel)
                ENDIF
                SET @itContext = Concat("LP Builder - CloudPage - zone ", @zone)

                IF @OBJET_INTERACTION == "Interaction__c" THEN
                    SET @n = CreateSalesforceObject("Interaction__c", 19,
                        "RecordTypeId",          @RT_INTERACTION_FORM,
                        "InteractionDate__c",    @itHorodatageUtc,
                        "Campaign__c",           @campaignId,
                        "PersonAccount__c",      @paId,
                        "CampaignMemberId__c",   @cmId,
                        "SourceSystem__c",       "SFMC",
                        "Status__c",             "Submitted",
                        "Information__c",        RequestParameter("NomFormulaire"),
                        "Preview__c",            @itPreview,
                        "Context__c",            @itContext,
                        "UTM_Source__c",         @utmS,
                        "UTM_Medium__c",         @utmM,
                        "UTM_Campaign__c",       @utmC,
                        "UTM_Content__c",        @utmCo,
                        "UTM_Term__c",           @utmT,
                        "UTM_Id__c",             @utmI,
                        "gclid__c",              @gclid,
                        "fbclid__c",             @fbclid,
                        "Client_ID__c",          @clientId)
                ELSE
                    /* Retour en arriere : l'ancien objet n'a ni record type,
                       ni Status__c, ni Preview__c, ni Context__c. */
                    SET @n = CreateSalesforceObject("CampaignMemberInteraction__c", 14,
                        "Campaign__c",           @campaignId,
                        "PersonAccount__c",      @paId,
                        "CampaignMemberId__c",   @cmId,
                        "SourceSystem__c",       "SFMC",
                        "Information__c",        RequestParameter("NomFormulaire"),
                        "UTM_Source__c",         @utmS,
                        "UTM_Medium__c",         @utmM,
                        "UTM_Campaign__c",       @utmC,
                        "UTM_Content__c",        @utmCo,
                        "UTM_Term__c",           @utmT,
                        "UTM_Id__c",             @utmI,
                        "gclid__c",              @gclid,
                        "fbclid__c",             @fbclid,
                        "Client_ID__c",          @clientId)
                ENDIF
                SET @journal = Concat(@journal, " INTERACTION:creee-", @OBJET_INTERACTION)
            ENDIF

            /* ---- JOURNEY POST-DEMANDE DE BROCHURE ---------------------------
               Chaque demande de brochure designe la cle — membre cree comme
               membre existant : un prospect qui redemande la documentation
               attend de nouveau la reponse. L'entree (DE
               Post_Demande_De_Doc_Target) est construite dans le bloc commun
               en fin de sequence ; la journey garde la main sur la re-entree. */
            IF @formType == "brochure" AND NOT Empty(@cmId) THEN
                SET @jrnCleEvt = "EventKey_Brochure"
            ENDIF
        ENDIF

        /* ====================================================================
           ETAPE 3b — SUMMIT REGISTRATION + ATELIERS (JPO / Atelier / Stage)
           ====================================================================
           Unicite = (personne x instance), et NON par personne : s'inscrire a
           une autre journee JPO doit creer une NOUVELLE inscription, pas
           ecraser la precedente. D'ou l'externalId compose des deux.
           ==================================================================== */
        IF @isEvent == "true" AND NOT Empty(@paId) AND NOT Empty(@paContactId) THEN

            SET @instanceId = RequestParameter("InstanceId")

            IF Empty(@instanceId) THEN
                SET @sfStatus = "error"
                SET @sfErrorMsg = "Inscription evenement sans InstanceId : aucune date choisie."
            ELSE
                /* ---- IDEMPOTENCE DE L'INSCRIPTION --------------------------
                   La cle metier est la paire PERSONNE + DATE : l'e-mail seul ne
                   suffit pas, la meme personne peut legitimement s'inscrire a
                   plusieurs dates du meme evenement.

                   ⚠ On interroge les DEUX CHAMPS DE LIAISON, pas `externalId__c`.
                   Ce dernier est vide sur les 1212 inscriptions de l'org
                   (releve le 2026-08-23) : le package ne l'alimente pas. Chercher
                   dessus ne voyait que NOS propres inscriptions, donc une
                   personne deja inscrite par le CRM ou par le site Summit etait
                   reinscrite en double. Et l'org ACCEPTE les doublons — verifie :
                   le meme contact s'est inscrit deux fois de suite sans erreur.
                   Un double-clic suffisait donc a compter deux inscrits.

                   `externalId__c` reste ecrit a la creation, pour la tracabilite
                   de ce qui vient de nous. Il n'est simplement plus la cle. */
                SET @extId = Concat(@paContactId, "-", @instanceId)

                IF @LOG_ACTIF == "true" AND @LOG_DETAIL == "true" THEN
                    SET @logOrdre = Add(@logOrdre, 1)
                    InsertData("LPB_Log_Soumissions",
                        "RowId", Concat(@runId, "-", @logOrdre),
                        "RunId", @runId,
                        "Ordre", @logOrdre,
                        "Horodatage", Now(),
                        "Etape", "78 - avant lecture registration",
                        "Statut", "OK",
                        "Objet", "summit Registration",
                        "RecordId", "",
                        "Detail", Concat("contact=", @paContactId, " instance=", @instanceId),
                        "Email", @email,
                        "Ecole", @ecole,
                        "FormType", @formType)
                ENDIF
                SET @rows = RetrieveSalesforceObjects("summit__Summit_Events_Registration__c",
                    "Id",
                    "summit__Contact__c",        "=", @paContactId,
                    "summit__Event_Instance__c", "=", @instanceId)

                IF RowCount(@rows) > 0 THEN
                    SET @regId = Field(Row(@rows,1), "Id")
                    SET @journal = Concat(@journal, " REG:existante(", @typeEvt, ")")
                    IF @LOG_ACTIF == "true" THEN
                        SET @logOrdre = Add(@logOrdre, 1)
                        InsertData("LPB_Log_Soumissions",
                            "RowId", Concat(@runId, "-", @logOrdre),
                            "RunId", @runId,
                            "Ordre", @logOrdre,
                            "Horodatage", Now(),
                            "Etape", "80 - registration existante",
                            "Statut", "IGNORE",
                            "Objet", "summit Registration",
                            "RecordId", @regId,
                            "Detail", @extId,
                            "Email", @email,
                            "Ecole", @ecole,
                            "FormType", @formType)
                    ENDIF

                    /* ANTI-ECHO — en update on ne renvoie NI summit__Status__c
                       (il porte la presence pointee le jour J, l'ecraser la
                       perdrait) NI actionNameStatus__c (un flow quotidien le
                       fait passer 'Origin' -> 'checkin' ; le reecrire relance
                       le scoring et l'echo vers Marketing Cloud).
                       Seul le tracking est rafraichi. */
                    IF NOT Empty(@utmS) THEN
                        SET @n = UpdateSingleSalesforceObject("summit__Summit_Events_Registration__c",
                            @regId, "summit__utm_source__c", @utmS)
                    ENDIF
                ELSE
                    /* A la CREATION seulement, les deux statuts sont poses.

                       ⚠ `summit__Status__c` est en ANGLAIS sur cette org :
                       Registered, Confirmed, Attended, No-Show, Started,
                       Registered Present. Le socle y ecrivait "Inscrit", hors
                       picklist, donc refuse — et le refus tuait la page a
                       chaque inscription evenement. Releve le 2026-08-27 en
                       lisant les 1210 inscriptions existantes.

                       `actionNameStatus__c` est un champ libre en revanche :
                       les donnees contiennent "inscrit", "checkin" et meme
                       "Test2Ewen". "Origin" y passe, et un flow quotidien le
                       fait basculer vers "checkin". */
                    /* Les 4 derniers champs etaient demandes par les 6
                       onglets du mapping v4 et n'etaient pas ecrits. Tous
                       verifies presents sur l'objet.
                       Pas de fbclid ici : le package Summit ne fournit que
                       summit__gclid__c, et le mapping le note explicitement. */
                    IF @LOG_ACTIF == "true" AND @LOG_DETAIL == "true" THEN
                        SET @logOrdre = Add(@logOrdre, 1)
                        InsertData("LPB_Log_Soumissions",
                            "RowId", Concat(@runId, "-", @logOrdre),
                            "RunId", @runId,
                            "Ordre", @logOrdre,
                            "Horodatage", Now(),
                            "Etape", "79 - avant creation registration",
                            "Statut", "OK",
                            "Objet", "summit Registration",
                            "RecordId", "",
                            "Detail", @extId,
                            "Email", @email,
                            "Ecole", @ecole,
                            "FormType", @formType)
                    ENDIF
                    /* ⚠ `summit__Event__c` DOIT etre pose, alors que le
                       formulaire ne connait que l'instance. Le package le
                       renseigne par trigger quand l'inscription vient de son
                       propre ecran ; il ne le fait PAS pour un insert du
                       connecteur. Une inscription sans evenement s'enregistre
                       tres bien, mais refuse ensuite tout creneau d'atelier :
                       le creneau valide le type contre l'evenement du parent,
                       et la comparaison echoue sur un champ vide.

                       Mesure du 2026-08-27 : la seule inscription de l'org
                       portant un creneau (a0AAW00000CuXgk2AF) a
                       summit__Event__c rempli ; toutes les notres l'avaient
                       vide, et refusaient n'importe quel type, y compris ceux
                       de leur propre evenement. A l'inverse cette inscription
                       accepte n'importe quel type. Ce n'etait donc ni les 42
                       types crees par le CRM, ni l'instance, ni le statut. */
                    SET @rows = RetrieveSalesforceObjects("summit__Summit_Events_Instance__c",
                        "Id,summit__Event__c", "Id", "=", @instanceId)
                    SET @evtParent = ""
                    IF RowCount(@rows) > 0 THEN
                        SET @evtParent = Field(Row(@rows,1), "summit__Event__c")
                    ENDIF

                    SET @regId = CreateSalesforceObject("summit__Summit_Events_Registration__c", 15,
                        "externalId__c",             @extId,
                        "summit__Event_Instance__c", @instanceId,
                        "summit__Event__c",          @evtParent,
                        "summit__Contact__c",        @paContactId,
                        "summit__Status__c",         "Registered",
                        "actionNameStatus__c",       "Origin",
                        "summit__utm_source__c",     @utmS,
                        "summit__utm_medium__c",     @utmM,
                        "summit__utm_campaign__c",   @utmC,
                        "summit__utm_content__c",    @utmCo,
                        "summit__utm_term__c",       @utmT,
                        "summit__utm_id__c",         @utmI,
                        "summit__gclid__c",          @gclid,
                        "AcquisitionChannel__c",     @canal,
                        "AcquisitionSubChannel__c",  @sousCanal)
                    SET @journal = Concat(@journal, " REG:creee(", @typeEvt, ")")

                    IF @LOG_ACTIF == "true" THEN
                        SET @logOrdre = Add(@logOrdre, 1)
                        InsertData("LPB_Log_Soumissions",
                            "RowId", Concat(@runId, "-", @logOrdre),
                            "RunId", @runId,
                            "Ordre", @logOrdre,
                            "Horodatage", Now(),
                            "Etape", "80 - registration creee",
                            "Statut", "OK",
                            "Objet", "summit Registration",
                            "RecordId", @regId,
                            "Detail", @extId,
                            "Email", @email,
                            "Ecole", @ecole,
                            "FormType", @formType)
                    ENDIF
                ENDIF

                /* ---- JOURNEY DE CONFIRMATION ---------------------------------
                   L'entree (DE Data_contacts_evenement_new) est construite en
                   fin de sequence, dans le bloc commun « PREPARATION DES
                   ENTREES DE JOURNEY » : ici on ne fait que designer la cle.

                   ⚠ POSEE POUR LES DEUX BRANCHES depuis le 22/09. Elle vivait
                   dans la seule branche de CREATION, avec pour commentaire
                   « une inscription EXISTANTE ne redeclenche rien » : une
                   personne qui se reinscrit a la meme date ne recevait donc
                   plus rien, et le journal ne portait meme pas de ligne
                   « 99 - journey » pour le dire. Arbitrage du 22/09 : chaque
                   soumission vaut confirmation, comme cote brochure ou la cle
                   est posee membre cree COMME membre existant. La journey
                   garde la main sur la re-entree — c'est son reglage, pas le
                   notre.

                   @regId est renseigne dans les deux branches (trouve ou cree) :
                   c'est lui qui conditionne la cle, pas la nouveaute. */
                IF NOT Empty(@regId) THEN
                    SET @jrnCleEvt = "EventKey_Evenement"
                ENDIF

                /* ---- Ateliers coches -------------------------------------
                   Le champ cache `Appointments` porte les Ids du CATALOGUE
                   (summit__Summit_Events_Appointment_Type__c), separes par des
                   virgules — c'est ce que le bloc de lecture emet.
                   On n'ecrit QUE des ajouts : le retrait d'un atelier decoche
                   est hors perimetre (page publique, pas d'outil d'admin), il
                   est journalise et laisse en place. */
                SET @appts = RequestParameter("Appointments")
                IF NOT Empty(@regId) AND NOT Empty(@appts) THEN
                    SET @apptRows = BuildRowsetFromString(@appts, ",")
                    SET @nA = RowCount(@apptRows)

                    FOR @i = 1 TO @nA DO
                        SET @apptType = Trim(Field(Row(@apptRows, @i), 1))
                        IF NOT Empty(@apptType) THEN

                            /* Idempotence : (Registration x type d'atelier). */
                            SET @rows = RetrieveSalesforceObjects("summit__Summit_Events_Appointments__c",
                                "Id",
                                "summit__Event_Registration__c",   "=", @regId,
                                "summit__Event_Appointment_Type__c", "=", @apptType)

                            IF RowCount(@rows) == 0 THEN
                                SET @n = CreateSalesforceObject("summit__Summit_Events_Appointments__c", 2,
                                    "summit__Event_Registration__c",     @regId,
                                    "summit__Event_Appointment_Type__c", @apptType)
                                SET @journal = Concat(@journal, " APPT:+")
                                IF @LOG_ACTIF == "true" THEN
                                    SET @logOrdre = Add(@logOrdre, 1)
                                    InsertData("LPB_Log_Soumissions",
                                        "RowId", Concat(@runId, "-", @logOrdre),
                                        "RunId", @runId,
                                        "Ordre", @logOrdre,
                                        "Horodatage", Now(),
                                        "Etape", "90 - atelier ajoute",
                                        "Statut", "OK",
                                        "Objet", "summit Appointments",
                                        "RecordId", @apptType,
                                        "Detail", "1 atelier",
                                        "Email", @email,
                                        "Ecole", @ecole,
                                        "FormType", @formType)
                                ENDIF
                            ENDIF
                        ENDIF
                    NEXT @i
                ENDIF
            ENDIF
        ENDIF

        /* ====================================================================
           PREPARATION DES ENTREES DE JOURNEY (API EVENT) — BLOC COMMUN
           ====================================================================
           La branche metier a designe la cle (@jrnCleEvt) ; on construit ici
           le corps JSON attendu par la DE d'entree, que le SSJS de fin de page
           poste sur interaction/v1/events. Deux DE, relues le 18/09 :
             EventKey_Evenement → Data_contacts_evenement_new   (20 colonnes)
             EventKey_Brochure  → Post_Demande_De_Doc_Target    (18 colonnes)
           Le test test-env.js fige les deux listes de colonnes : une colonne
           inconnue de la DE fait refuser l'evenement entier.

           Ce que les journeys LISENT dans leurs splits, et donc le vocabulaire
           a respecter a la lettre :
             evenement : EventType ∈ Open House | Discovery Workshop |
                         Internship | Immersion Day (vocabulaire Summit, meme
                         table que le bloc des listes), summit__Instance_Start_Date
             brochure  : Brand (vocabulaire de la journey, SANS accents : ESEC,
                         Ecole Bleue, 3W Academy, IFA Paris, MoPA…) et
                         Academic_Level_List (BAC+3, BAC+4, BAC+5, BAC+5 et +).
           MobileNumber est un champ Phone : chiffres seuls, indicatif en tete,
           sans « + » (format MobileConnect). MobileE164Auto garde le « + ».

           Deux lectures SF de plus (compte, instance), uniquement drapeau
           ouvert. Drapeau ferme : rien ne part, le journal le dit.
           ==================================================================== */
        IF NOT Empty(@jrnCleEvt) AND @JOURNEY_LAUNCH != "true" THEN
            SET @journal = Concat(@journal, " JOURNEY:desactive")
        ELSEIF NOT Empty(@jrnCleEvt) THEN
            /* Langue, locale SMS et pays : ceux du compte (un compte existant
               n'est pas passe par la branche creation, ou @langue est
               calculee). Repli sur le formulaire. */
            SET @jrnLangue = ""
            SET @jrnLocale = ""
            SET @jrnPays   = ""
            SET @jrnRows = RetrieveSalesforceObjects("Account",
                "Id,PreferredLangage__c,SMSLocale__c,LivingCountry__c", "Id", "=", @paId)
            IF RowCount(@jrnRows) > 0 THEN
                SET @jrnRow = Row(@jrnRows, 1)
                SET @jrnLangue = Field(@jrnRow, "PreferredLangage__c", 0)
                SET @jrnLocale = Field(@jrnRow, "SMSLocale__c", 0)
                SET @jrnPays   = Field(@jrnRow, "LivingCountry__c", 0)
            ENDIF
            IF Empty(@jrnLangue) THEN SET @jrnLangue = @langue ENDIF
            IF Empty(@jrnLangue) THEN SET @jrnLangue = "French" ENDIF
            IF Empty(@jrnPays)   THEN SET @jrnPays = @country ENDIF
            /* Le CRM stocke « fr-fr » ; SFMC attend « fr-FR ». */
            IF Length(@jrnLocale) == 5 THEN
                SET @jrnLocale = Concat(Lowercase(Substring(@jrnLocale, 1, 2)), "-", Uppercase(Substring(@jrnLocale, 4, 2)))
            ELSEIF @jrnLangue == "English" THEN
                SET @jrnLocale = "en-US"
            ELSE
                SET @jrnLocale = "fr-FR"
            ENDIF

            /* Telephone : indicatif (« 33 ») + numero sans separateurs ni zero
               initial. @jrnTel sans « + » (champ Phone), @jrnTelE164 avec. */
            SET @jrnTel     = ""
            SET @jrnTelE164 = ""
            SET @jrnTelBrut = Replace(Replace(Replace(Replace(Replace(Replace(Replace(@mobile, " ", ""), ".", ""), "-", ""), "(", ""), ")", ""), "/", ""), "+", "")
            IF NOT Empty(@jrnTelBrut) THEN
                IF Substring(@jrnTelBrut, 1, 1) == "0" THEN SET @jrnTelBrut = Substring(@jrnTelBrut, 2, Subtract(Length(@jrnTelBrut), 1)) ENDIF
                SET @jrnTel     = Concat(Replace(Replace(@indicatif, "+", ""), " ", ""), @jrnTelBrut)
                SET @jrnTelE164 = Concat("+", @jrnTel)
            ENDIF

            /* Marque : vocabulaire des journeys (splits « Brand equal … »),
               releve le 18/09 sur Post_Demande_De_Doc. Repli sur le libelle
               de LPB_Mapping_Ecoles pour une ecole qui manquerait ici. */
            SET @jrnRefMarque = "|efap=EFAP|brassart=BRASSART|icart=ICART|cread=CREAD|esec=ESEC|ifa-paris=IFA Paris|mopa=MoPA|ecole-bleue=Ecole Bleue|efj=EFJ|3wa=3W Academy|"
            SET @jrnCle = Lowercase(Trim(@ecole))
            SET @jrnPos = IndexOf(@jrnRefMarque, Concat("|", @jrnCle, "="))
            IF @jrnPos > 0 THEN
                SET @jrnReste  = Substring(@jrnRefMarque, Add(Add(@jrnPos, Length(@jrnCle)), 2))
                SET @jrnMarque = Substring(@jrnReste, 1, Subtract(IndexOf(@jrnReste, "|"), 1))
            ELSE
                SET @jrnMarque = Lookup("LPB_Mapping_Ecoles", "Libelle", "Ecole", @ecole)
                IF Empty(@jrnMarque) THEN SET @jrnMarque = @ecole ENDIF
            ENDIF

            /* Echappement JSON des textes libres : antislash puis guillemet.
               AMPscript n'a pas de sequence d'echappement, "\" est bien UN
               antislash. */
            SET @jrnFn     = Replace(Replace(@firstName, "\", "\\"), '"', '\"')
            SET @jrnLn     = Replace(Replace(@lastName,  "\", "\\"), '"', '\"')
            SET @jrnMail   = Replace(Replace(@email,     "\", "\\"), '"', '\"')
            SET @jrnCampus = Replace(Replace(@campusSel, "\", "\\"), '"', '\"')
            SET @jrnMarque = Replace(Replace(@jrnMarque, "\", "\\"), '"', '\"')
            SET @jrnPays   = Replace(Replace(@jrnPays,   "\", "\\"), '"', '\"')

            /* BrandCode : code technique de la marque, envoye aux DEUX entrees
               de journey (evenement depuis le 22/09, brochure depuis le 23/09 —
               la colonne existe sur les deux DE, relue avant chaque ajout).
               Regle du client (CASE SQL sur BusinessBrand_Name) : vide → VIDE,
               marque inconnue → ?, sinon le code (espaces et accents retires :
               Ecole Bleue → Ecole_Bleue, 3W Academy → 3WA...).
               Derive de @jrnMarque — la valeur MEME qu'on envoie dans
               BusinessBrandName / Brand — pour que les colonnes ne puissent
               pas se contredire. Les variantes accentuees du CASE client
               (ÉSEC, École Bleue) n'existent pas ici : @jrnRefMarque a deja
               normalise sans accents en amont ; une marque hors table (ecole
               future via le repli Lookup) tombe sur « ? », comme le ELSE. */
            SET @jrnRefBrandCode = "|efap=EFAP|brassart=BRASSART|cread=CREAD|esec=ESEC|icart=ICART|mopa=MOPA|ecole bleue=Ecole_Bleue|ifa paris=IFA_Paris|efj=EFJ|3w academy=3WA|"
            IF Empty(@jrnMarque) THEN
                SET @jrnBrandCode = "VIDE"
            ELSE
                SET @jrnCle = Lowercase(Trim(@jrnMarque))
                SET @jrnPos = IndexOf(@jrnRefBrandCode, Concat("|", @jrnCle, "="))
                IF @jrnPos > 0 THEN
                    SET @jrnReste     = Substring(@jrnRefBrandCode, Add(Add(@jrnPos, Length(@jrnCle)), 2))
                    SET @jrnBrandCode = Substring(@jrnReste, 1, Subtract(IndexOf(@jrnReste, "|"), 1))
                ELSE
                    SET @jrnBrandCode = "?"
                ENDIF
            ENDIF

            IF @jrnCleEvt == "EventKey_Evenement" THEN
                /* ---- ENTREE EVENEMENT (Data_contacts_evenement_new) --------
                   Cles de la DE : Subscriberkey + SummitEventRegistrationId +
                   Nom_action. Subscriberkey = PersonContactId, ID_salesforce =
                   Id du compte, schoolName = compte campus choisi (« EFAP
                   PARIS »), Nom_action = titre de l'instance, campusNameFor =
                   campus porte par l'instance. */
                SET @jrnTitre = ""
                SET @jrnCampusInst = ""
                SET @jrnDebut = ""
                SET @jrnFin = ""
                SET @jrnRows = RetrieveSalesforceObjects("summit__Summit_Events_Instance__c",
                    "Id,summit__Instance_Title__c,campusNameFor__c,summit__Instance_Start_Date__c,summit__Instance_End_Date__c",
                    "Id", "=", @instanceId)
                IF RowCount(@jrnRows) > 0 THEN
                    SET @jrnRow = Row(@jrnRows, 1)
                    SET @jrnTitre      = Field(@jrnRow, "summit__Instance_Title__c", 0)
                    SET @jrnCampusInst = Field(@jrnRow, "campusNameFor__c", 0)
                    SET @jrnDebut      = Field(@jrnRow, "summit__Instance_Start_Date__c", 0)
                    SET @jrnFin        = Field(@jrnRow, "summit__Instance_End_Date__c", 0)
                ENDIF
                /* ISO tronque a la seconde (FormatDate « mm » = mois, voir
                   @itHorodatageUtc) ; la DE accepte « 2026-10-15T00:00:00 ». */
                IF NOT Empty(@jrnDebut) THEN SET @jrnDebut = Substring(FormatDate(@jrnDebut, "iso"), 1, 19) ENDIF
                IF NOT Empty(@jrnFin)   THEN SET @jrnFin   = Substring(FormatDate(@jrnFin,   "iso"), 1, 19) ENDIF

                /* Type d'evenement : du vocabulaire des pages (JPO,
                   Atelier_Decouverte, Stage, Immersion) a celui de Summit, que
                   le split « Type d evenement » de la journey compare. */
                SET @jrnRefTypeEvt = "|jpo=Open House|atelier=Discovery Workshop|atelier_decouverte=Discovery Workshop|stage=Internship|immersion=Immersion Day|"
                SET @jrnCle = Lowercase(Trim(@typeEvt))
                SET @jrnPos = IndexOf(@jrnRefTypeEvt, Concat("|", @jrnCle, "="))
                IF @jrnPos > 0 THEN
                    SET @jrnReste   = Substring(@jrnRefTypeEvt, Add(Add(@jrnPos, Length(@jrnCle)), 2))
                    SET @jrnTypeEvt = Substring(@jrnReste, 1, Subtract(IndexOf(@jrnReste, "|"), 1))
                ELSE
                    SET @jrnTypeEvt = @typeEvt
                ENDIF

                SET @jrnTitre      = Replace(Replace(@jrnTitre,      "\", "\\"), '"', '\"')
                SET @jrnCampusInst = Replace(Replace(@jrnCampusInst, "\", "\\"), '"', '\"')

                SET @jrnContactKey = @paContactId
                SET @jrnData = Concat(
                    '"Subscriberkey":"', @paContactId, '",',
                    '"ID_salesforce":"', @paId, '",',
                    '"FirstName":"', @jrnFn, '",',
                    '"LastName":"', @jrnLn, '",',
                    '"PersonEmail":"', @jrnMail, '",',
                    '"MobileNumber":"', @jrnTel, '",',
                    '"PreferredLangage":"', @jrnLangue, '",',
                    '"SMSLocale":"', @jrnLocale, '",',
                    '"LivingCountry":"', @jrnPays, '",',
                    '"BusinessBrandName":"', @jrnMarque, '",',
                    '"BrandCode":"', @jrnBrandCode, '",',
                    '"schoolName":"', @jrnCampus, '",',
                    '"EventType":"', @jrnTypeEvt, '",',
                    '"summit__Event_Instance":"', @instanceId, '",',
                    '"summit__Instance_Start_Date":"', @jrnDebut, '",',
                    '"summit__Instance_End_Date":"', @jrnFin, '",',
                    '"SummitEventRegistrationId":"', @regId, '",',
                    '"Nom_action":"', @jrnTitre, '",',
                    '"Date_action":"', Format(Now(), "yyyy-MM-dd HH:mm:ss"), '",',
                    '"campusNameFor":"', @jrnCampusInst, '"')
            ELSE
                /* ---- ENTREE BROCHURE (Post_Demande_De_Doc_Target) ------------
                   DE calquee sur le compte : Id = Id du compte (cle), colonnes
                   Account sans suffixe. Schoolname et Ecole = compte campus
                   choisi (« EFAP PARIS »), Campus = utm_campus (repli campus
                   choisi), Brand = marque, CampaignId = campagne brochure.
                   Academic_Level_List : le split de la journey compare BAC+3,
                   BAC+4, BAC+5, « BAC+5 et + » — la valeur CRM (Bac+3,
                   Bac+5/+…) est rapprochee, les autres passent telles quelles. */
                SET @jrnRefNiveau = "|bac+3=BAC+3|bac+4=BAC+4|bac+5=BAC+5|bac+5/+=BAC+5 et +|bac+5 et +=BAC+5 et +|"
                SET @jrnCle = Lowercase(Trim(@studyLevel))
                SET @jrnPos = IndexOf(@jrnRefNiveau, Concat("|", @jrnCle, "="))
                IF @jrnPos > 0 THEN
                    SET @jrnReste  = Substring(@jrnRefNiveau, Add(Add(@jrnPos, Length(@jrnCle)), 2))
                    SET @jrnNiveau = Substring(@jrnReste, 1, Subtract(IndexOf(@jrnReste, "|"), 1))
                ELSE
                    SET @jrnNiveau = @studyLevel
                ENDIF
                SET @jrnNiveau    = Replace(Replace(@jrnNiveau,  "\", "\\"), '"', '\"')
                SET @jrnEcole     = @jrnCampus
                /* @utmCampus est lu AVANT que @campusSel soit connu : son repli
                   est vide sur une page sans utm_campus. On le refait ici. */
                SET @jrnCampusUtm = @utmCampus
                IF Empty(@jrnCampusUtm) THEN SET @jrnCampusUtm = @campusSel ENDIF
                SET @jrnCampusUtm = Replace(Replace(@jrnCampusUtm, "\", "\\"), '"', '\"')

                SET @jrnContactKey = @paContactId
                SET @jrnData = Concat(
                    '"Id":"', @paId, '",',
                    '"PersonContactId":"', @paContactId, '",',
                    '"FirstName":"', @jrnFn, '",',
                    '"LastName":"', @jrnLn, '",',
                    '"PersonEmail":"', @jrnMail, '",',
                    '"MobileE164Auto":"', @jrnTelE164, '",',
                    '"MobileNumber":"', @jrnTel, '",',
                    '"Schoolname":"', @jrnCampus, '",',
                    '"Academic_Level_List":"', @jrnNiveau, '",',
                    '"LivingCountry":"', @jrnPays, '",',
                    '"Brand":"', @jrnMarque, '",',
                    '"BrandCode":"', @jrnBrandCode, '",',
                    '"PreferredLangage":"', @jrnLangue, '",',
                    '"SMSLocale":"', @jrnLocale, '",',
                    '"WhatsAppLocale":"', @jrnLocale, '",',
                    '"CampaignId":"', @campaignId, '",',
                    '"Campus":"', @jrnCampusUtm, '",',
                    '"Ecole":"', @jrnEcole, '"')
            ENDIF
        ENDIF

        IF Empty(@sfStatus) THEN SET @sfStatus = "success" ENDIF
        IF @LOG_ACTIF == "true" THEN
            SET @logOrdre = Add(@logOrdre, 1)
            InsertData("LPB_Log_Soumissions",
                "RowId", Concat(@runId, "-", @logOrdre),
                "RunId", @runId,
                "Ordre", @logOrdre,
                "Horodatage", Now(),
                "Etape", "99 - fin",
                "Statut", @sfStatus,
                "Objet", "-",
                "RecordId", @paId,
                "Detail", Concat("journal=", @journal),
                "Email", @email,
                "Ecole", @ecole,
                "FormType", @formType)
        ENDIF
    ENDIF
    ENDIF   /* fin du garde-fou : rien n'est ecrit si @sfStatus == "blocked" */
ENDIF
]%%

<!-- socle ecriture: statut=%%=v(@sfStatus)=%% pa=%%=v(@paId)=%% nouveau=%%=v(@isNew)=%% journal=%%=v(@journal)=%% -->
%%[ IF NOT Empty(@sfErrorMsg) THEN ]%%
<!-- socle erreur: %%=v(@sfErrorMsg)=%% -->
%%[ ENDIF ]%%
%%[ IF NOT Empty(@sfBlockRule) THEN ]%%
<!-- socle blocage: motif=%%=v(@sfBlockRule)=%% -->
%%[ ENDIF ]%%
<script runat="server">
/* ==JOURNEY_FIRE_DEBUT==
   TIR DE L'API EVENT (bloc commun a tous les formulaires ; le banc de test
   scratchpad l'extrait tel quel entre ces deux marqueurs).
   ------------------------------------------------------------------------
   Lit les variables preparees par l'AMPscript ci-dessus : @JOURNEY_LAUNCH,
   @jrnCleEvt, @jrnContactKey, @jrnData. Deux appels HTTP : le jeton OAuth
   (client_credentials, identifiants dans la DE LPB_Config_Api) puis
   POST interaction/v1/events. Le succes se lit dans la reponse
   (eventInstanceId), jamais dans le seul code HTTP.

   POURQUOI EN SSJS, ET EN FIN DE FICHIER : HTTPPost2 tue la page sur toute
   reponse 4xx malgre continueOnError=true (mesure du 10/09), et un
   identifiant perime aurait donc casse la confirmation de CHAQUE inscription
   apres que le CRM a ete ecrit. Ici tout est dans un try/catch : quoi qu'il
   arrive le visiteur voit sa confirmation, et la ligne « 99 - journey » du
   journal dit ce qui s'est passe. Elle vient APRES « 99 - fin » (Ordre le
   dit) : le tir est la derniere chose que fait la page.
   Ni jeton ni secret dans le journal. */
Platform.Load("core", "1.1.1");
try {
    var jrnLaunch  = String(Variable.GetValue("@JOURNEY_LAUNCH") || "");
    var jrnCleEvt  = String(Variable.GetValue("@jrnCleEvt") || "");
    var jrnContact = String(Variable.GetValue("@jrnContactKey") || "");
    var jrnData    = String(Variable.GetValue("@jrnData") || "");
    if (jrnData !== "" && jrnCleEvt !== "") {
        var jrnDetail = "", jrnEvtId = "", jrnMarque = "", jrnKey = "";
        if (jrnLaunch !== "true") {
            jrnMarque = " JOURNEY:desactive";
            jrnDetail = "drapeau SFMC_JOURNEY_LAUNCH ferme";
        } else {
            var cfg = function (k) { var v = Platform.Function.Lookup("LPB_Config_Api", "Valeur", "Cle", k); return v ? String(v) : ""; };
            var cfgAuth = cfg("AuthBaseUrl"), cfgRest = cfg("RestBaseUrl"), cfgId = cfg("ClientId"),
                cfgSecret = cfg("ClientSecret"), cfgMid = cfg("AccountId");
            jrnKey = cfg(jrnCleEvt);
            if (!cfgAuth || !cfgRest || !cfgId || !cfgSecret || !jrnKey) {
                jrnMarque = " JOURNEY:sans-config";
                jrnDetail = "config incomplete (" + jrnCleEvt + ")";
            } else {
                var corps = function (r) { var x = r && r.Response; if (x && typeof x !== "string" && x.length !== undefined && typeof x[0] !== "undefined") { x = x[0]; } return x ? String(x) : ""; };
                var authBody = '{"grant_type":"client_credentials","client_id":"' + cfgId + '","client_secret":"' + cfgSecret + '","account_id":"' + cfgMid + '"}';
                /* HTTP.Post LEVE une exception sur toute reponse non 2xx (mesure
                   du 10/09 : cle d'evenement inconnue → exception, pas un
                   StatusCode 400). Chaque appel a donc son propre try/catch,
                   pour que le journal nomme l'appel qui a echoue. Le message
                   d'erreur SFMC est generique et sans secret. */
                var motif = function (e) { var t = e && e.message ? String(e.message) : Stringify(e); return t.replace(/\s+/g, " ").substring(0, 200); };
                var rTok = null, tok = "", echecTok = "";
                try { rTok = HTTP.Post(cfgAuth + "v2/token", "application/json", authBody, [], []); } catch (eTok) { echecTok = motif(eTok); }
                try { var jTok = Platform.Function.ParseJSON(corps(rTok)); if (jTok && jTok.access_token) { tok = String(jTok.access_token); } } catch (e1) { tok = ""; }
                if (!tok) {
                    jrnMarque = " JOURNEY:sans-jeton";
                    jrnDetail = "jeton refuse" + (echecTok ? " : " + echecTok : " http=" + (rTok ? rTok.StatusCode : "?"));
                } else {
                    /* Tout caractere hors ASCII part en sequence JSON \uXXXX :
                       HTTP.Post abime les accents du corps (mesure du 18/09,
                       « Journee » stockee avec un caractere de remplacement
                       dans Nom_action). Un corps ASCII pur ne depend plus de
                       l'encodage choisi par la plateforme. */
                    var ascii = function (s) { return String(s).replace(/[\u0080-\uffff]/g, function (c) { return '\\u' + ('0000' + c.charCodeAt(0).toString(16)).slice(-4); }); };
                    var evtBody = ascii('{"ContactKey":"' + jrnContact + '","EventDefinitionKey":"' + jrnKey + '","Data":{' + jrnData + '}}');
                    /* ---- L'APPEL QUI DIT POURQUOI IL A ECHOUE ----------------
                       Script.Util.HttpRequest, et non HTTP.Post, pour CE seul
                       appel. Motif, mesure du 22/09 sur la recette : trois
                       re-soumissions d'affilee refusees par l'API Event, et le
                       journal n'a su ecrire que « An error occurred when
                       attempting to evaluate a HTTPPost function call. See
                       inner exception for details ». HTTP.Post LEVE sur tout
                       statut non 2xx et emporte le corps de la reponse avec
                       lui — or c'est ce corps, et lui seul, qui nomme la cause
                       (attribut inconnu, cle d'evenement invalide, contact
                       refuse...). On ne peut pas corriger ce qu'on ne lit pas.

                       `continueOnError = true` rend la main au lieu de lever :
                       on recupere le statut ET le corps, y compris sur 4xx.
                       `retries = 0` : un evenement re-emis, c'est une entree en
                       double dans la journey, donc un message en double.

                       Repli : si la construction de la requete echoue (objet
                       absent de la plateforme), et SEULEMENT dans ce cas —
                       donc avant que quoi que ce soit soit parti — on retombe
                       sur HTTP.Post. Rien n'est jamais poste deux fois.
                       ⚠ Pas de `typeof` pour sonder l'objet : sous Jint, une
                       methode du socle rend « clrmethodinfo », pas
                       « function ». On construit, et on rattrape. */
                    var rEvt = null, texte = "", echecEvt = "", httpEvt = "", req = null;
                    try {
                        req = new Script.Util.HttpRequest(cfgRest + "interaction/v1/events");
                        req.emptyContentHandling = 0;
                        req.retries = 0;
                        req.continueOnError = true;
                        req.method = "POST";
                        req.contentType = "application/json";
                        req.setHeader("Authorization", "Bearer " + tok);
                        req.postData = evtBody;
                    } catch (eReq) { req = null; }
                    if (req) {
                        /* `returnStatus` vaut 0 quand tout va bien, sinon un code
                           d'erreur de la plateforme — ce n'est PAS le statut
                           HTTP. On note les deux quand la reponse porte l'autre. */
                        try { var resp = req.send(); httpEvt = String(resp.returnStatus) + (resp.statusCode ? "/" + resp.statusCode : ""); texte = String(resp.content || ""); } catch (eSend) { echecEvt = motif(eSend); }
                    } else {
                        try { rEvt = HTTP.Post(cfgRest + "interaction/v1/events", "application/json", evtBody, ["Authorization"], ["Bearer " + tok]); texte = corps(rEvt); httpEvt = String(rEvt ? rEvt.StatusCode : "?"); } catch (eEvt) { echecEvt = motif(eEvt); }
                    }
                    try { var jEvt = Platform.Function.ParseJSON(texte); if (jEvt && jEvt.eventInstanceId) { jrnEvtId = String(jEvt.eventInstanceId); } } catch (e2) { jrnEvtId = ""; }
                    if (jrnEvtId) {
                        jrnMarque = " JOURNEY:ok(" + jrnKey + ")";
                        jrnDetail = "cle=" + jrnKey + " eventInstanceId=" + jrnEvtId;
                    } else {
                        jrnMarque = " JOURNEY:echec(" + jrnKey + ")";
                        /* Le corps de la reponse EN ENTIER dans la limite de la
                           colonne Detail (500) : c'est la phrase de l'API qui
                           sert, pas notre resume. */
                        jrnDetail = ("cle=" + jrnKey + " http=" + (httpEvt || "?")
                                  + (echecEvt ? " appel refuse : " + echecEvt : "")
                                  + " reponse=" + texte).substring(0, 480);
                    }
                }
            }
        }
        Variable.SetValue("@journal", String(Variable.GetValue("@journal") || "") + jrnMarque);
        Variable.SetValue("@jrnDetail", jrnDetail);
        if (String(Variable.GetValue("@LOG_ACTIF")) === "true") {
            var ordre = Number(Variable.GetValue("@logOrdre") || 0) + 1;
            Variable.SetValue("@logOrdre", ordre);
            var runId = String(Variable.GetValue("@runId") || "");
            Platform.Function.InsertData("LPB_Log_Soumissions",
                ["RowId", "RunId", "Ordre", "Horodatage", "Etape", "Statut", "Objet", "RecordId", "Detail", "Email", "Ecole", "FormType"],
                [runId + "-" + ordre, runId, ordre, Platform.Function.SystemDateToLocalDate(Now()), "99 - journey", (jrnEvtId ? "OK" : "KO"), "API Event",
                 jrnEvtId, jrnDetail, String(Variable.GetValue("@email") || ""), String(Variable.GetValue("@ecole") || ""), String(Variable.GetValue("@formType") || "")]);
        }
    }
} catch (eJrn) {
    /* Jamais de page morte pour une journey : on note, on continue. */
    try {
        var motifX = ("exception: " + (eJrn && eJrn.message ? eJrn.message : Stringify(eJrn))).replace(/\s+/g, " ").substring(0, 500);
        Variable.SetValue("@journal", String(Variable.GetValue("@journal") || "") + " JOURNEY:exception");
        Variable.SetValue("@jrnDetail", motifX);
        if (String(Variable.GetValue("@LOG_ACTIF")) === "true") {
            var ordreX = Number(Variable.GetValue("@logOrdre") || 0) + 1;
            Variable.SetValue("@logOrdre", ordreX);
            var runIdX = String(Variable.GetValue("@runId") || "");
            Platform.Function.InsertData("LPB_Log_Soumissions",
                ["RowId", "RunId", "Ordre", "Horodatage", "Etape", "Statut", "Objet", "RecordId", "Detail", "Email", "Ecole", "FormType"],
                [runIdX + "-" + ordreX, runIdX, ordreX, Platform.Function.SystemDateToLocalDate(Now()), "99 - journey", "KO", "API Event", "",
                 motifX,
                 String(Variable.GetValue("@email") || ""), String(Variable.GetValue("@ecole") || ""), String(Variable.GetValue("@formType") || "")]);
        }
    } catch (eLog) { /* silence : rien ne doit remonter au visiteur */ }
}
/* ==JOURNEY_FIRE_FIN== */
</script>
